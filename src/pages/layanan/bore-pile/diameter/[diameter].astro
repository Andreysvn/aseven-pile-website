---
import LocalSEOLayout from '../../../../components/layout/LocalSEOLayout.astro';
import PricingTable from '../../../../components/ui/PricingTable.astro';
import CalculatorUI from '../../../../components/interactive/CalculatorUI.astro';
import CostExample from '../../../../components/ui/CostExample.astro';
import CostAddons from '../../../../components/ui/CostAddons.astro';
import ServiceFeatures from '../../../../components/ui/ServiceFeatures.astro';
import ComparisonSection from '../../../../components/ui/ComparisonSection.astro';
import DiameterComparison from '../../../../components/ui/DiameterComparison.astro';
import ProjectGallery from '../../../../components/ui/ProjectGallery.astro';
import MiniGallery from '../../../../components/ui/MiniGallery.astro';
import ProcessSteps from '../../../../components/ui/ProcessSteps.astro';
import FAQSection from '../../../../components/ui/FAQSection.astro';
import ArticleList from '../../../../components/ui/ArticleList.astro';
import PremiumCTA from '../../../../components/ui/PremiumCTA.astro';
import LocationMap from '../../../../components/ui/LocationMap.astro';
import AreaGrid from '../../../../components/ui/AreaGrid.astro';

import '../../../../styles/calculator.css';
import { pricingTiers } from '../../../../data/pricing';
import { getDiameterData } from '../../../../data/diameter-data';
import { getProjectsByDiameter } from '../../../../data/projects';
import { siteConfig } from '../../../../data/site.config';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  return pricingTiers.map((tier) => ({
    params: { diameter: tier.diameter.toString() },
    props: { tier },
  }));
}

const { tier } = Astro.props;
const dData = getDiameterData(tier.diameter);
const diameterProjects = getProjectsByDiameter(tier.diameter, 'borepile');

const pageUrl = `${siteConfig.url}/layanan/bore-pile/diameter/${tier.diameter}/`;
const customBreadcrumbs = [
  { name: "Beranda", item: siteConfig.url },
  { name: "Layanan", item: `${siteConfig.url}/layanan` },
  { name: "Bore Pile Mesin", item: `${siteConfig.url}/layanan/bore-pile-mesin` },
  { name: `Diameter ${tier.diameter} cm`, item: pageUrl },
];

const expectedHeroImage = '/imgs/header-beranda-bore-pile-aseven.webp';
const hasHeroImage = fs.existsSync(path.join(process.cwd(), 'public', expectedHeroImage));
const calcLoc = 'jabodetabek';

const isSinglePrice = tier.pricePerMeter.min === tier.pricePerMeter.max;

// Schema @graph: Service + BreadcrumbList
const serviceSchema: Record<string, unknown> = {
  "@type": "Service",
  "name": `Jasa Bore Pile Diameter ${tier.diameter} cm`,
  "serviceType": "Bore Pile",
  "provider": { "@id": `${siteConfig.url}/#organization` },
  "areaServed": ["Jakarta", "Bekasi", "Bogor", "Depok", "Tangerang"],
  "offers": {
    "@type": "Offer",
    "priceCurrency": "IDR",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": tier.pricePerMeter.min.toString(),
      ...(isSinglePrice ? {} : { "minPrice": tier.pricePerMeter.min.toString(), "maxPrice": tier.pricePerMeter.max.toString() }),
      "priceCurrency": "IDR",
      "unitText": "meter"
    },
    "url": pageUrl
  }
};

const productSchema = {
  "@type": "Product",
  "@id": `${pageUrl}#product`,
  "name": `Jasa Bore Pile Diameter ${tier.diameter} cm per Meter`,
  "description": `Jasa bore pile diameter ${tier.diameter} cm dengan harga jasa bor Rp ${tier.pricePerMeter.min.toLocaleString('id-ID')} per meter lari. Material dan biaya tambahan belum termasuk.`,
  "image": `${siteConfig.url}${hasHeroImage ? expectedHeroImage : "/imgs/header-beranda-bore-pile-aseven.webp"}`,
  "brand": {
    "@type": "Brand",
    "name": siteConfig.brand
  },
  "offers": {
    "@type": "Offer",
    "url": pageUrl,
    "priceCurrency": "IDR",
    "price": tier.pricePerMeter.min.toString(),
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "priceCurrency": "IDR",
      "price": tier.pricePerMeter.min.toString(),
      "unitCode": "MTR",
      "unitText": "meter lari"
    }
  }
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": customBreadcrumbs.map((bc, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": bc.name,
    ...(i < customBreadcrumbs.length - 1 ? { "item": bc.item } : {})
  }))
};

const graphItems = [
  serviceSchema,
  ...(tier.diameter === 30 || tier.diameter === 40 ? [productSchema] : []),
  breadcrumbSchema
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": graphItems
};

// Simulasi data untuk CostExample
const simPoints = dData.simulation?.points || 20;
const simDepth = dData.simulation?.depthM || 12;
const simPrice = tier.pricePerMeter.min;
const simTotal = simPoints * simDepth * simPrice;

const costExampleData = {
  isReal: false,
  items: [
    {
      diameterCm: tier.diameter,
      pricePerM: simPrice,
      depthM: simDepth,
      points: simPoints,
      subtotal: simTotal
    }
  ],
  total: simTotal
};

const defaultFeatures = [
  {
    title: "Minim Getaran & Aman",
    desc: "Pengeboran berputar dengan mesin mini crane atau gawangan tanpa benturan palu pancang, sangat aman untuk bangunan tetangga di area pemukiman padat."
  },
  {
    title: "Tim Berpengalaman",
    desc: "Lebih dari 12 tahun spesialis mengerjakan pondasi bore pile di berbagai kondisi tanah dan medan proyek."
  },
  {
    title: "Sesuai Standar SNI",
    desc: "Pengerjaan mengacu pada spesifikasi gambar perencana struktur dan standar teknis SNI 8460:2017 serta metode pipa tremi."
  }
];

const defaultSopSteps = [
  { number: 1, title: "Survei Lapangan", desc: "Pemeriksaan akses jalan gang dan ruang manuver armada mini crane di titik pengeboran." },
  { number: 2, title: "Setting Mesin & Pengeboran", desc: "Perakitan rig mini crane di titik awal. Pengeboran dilakukan hingga menyentuh elevasi tanah keras sesuai target sondir." },
  { number: 3, title: "Pemasangan Besi Tulangan", desc: "Penurunan keranjang besi tulangan SNI ke dalam lubang bor yang telah dibersihkan dari endapan lumpur." },
  { number: 4, title: "Pengecoran Pipa Tremi", desc: "Pengecoran beton ready mix dari dasar lubang menggunakan pipa tremi agar beton padat utuh tanpa tercampur lumpur." }
];
---

<LocalSEOLayout 
  title={dData.metaTitle}
  h1={dData.h1}
  description={dData.metaDescription}
  city="Jabodetabek"
  serviceName={`Bore Pile Diameter ${tier.diameter}cm`}
  pathContext="bore-pile"
  heroImage={hasHeroImage ? expectedHeroImage : undefined}
  faqs={dData.faqs}
  pageUrl={pageUrl}
  customBreadcrumbs={customBreadcrumbs}
  lowPrice={tier.pricePerMeter.min.toString()}
  highPrice={tier.pricePerMeter.max.toString()}
  skipProductSchema={true}
>
  <!-- Schema @graph tunggal -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph).replace(/</g, "\\u003c")} />

  <!-- ================================================ -->
  <!-- 1. INTRO & RINGKASAN                             -->
  <!-- ================================================ -->
  <section class="ls-section">
    <div class="ls-summary-box">
      <div class="ls-summary-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary, #800000)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
      </div>
      <p class="ls-summary-text">
        <strong>Ringkasan:</strong> Harga jasa bore pile diameter <strong>{tier.diameter} cm</strong> mulai dari <strong>Rp {tier.pricePerMeter.min.toLocaleString('id-ID')} / meter lari (m&sup1;)</strong>. Biaya ini merupakan jasa bor saja (pengeboran, rakit besi tulangan, dan cor pipa tremi). Material besi/beton, mobilisasi alat, dan bak sirkulasi air belum termasuk. Minimal order pengerjaan 200 meter lari.
      </p>
    </div>

    {dData.crosslinkHtml && (
      <div class="ls-summary-crosslink">
        <Fragment set:html={dData.crosslinkHtml} />
      </div>
    )}

    <p class="ls-intro-p">
      <Fragment set:html={dData.introParagraph1} />
    </p>

    {dData.introParagraph2 && (
      <p class="ls-intro-p-flat">
        <Fragment set:html={dData.introParagraph2} />
      </p>
    )}
  </section>

  <!-- ================================================ -->
  <!-- 2. DAFTAR HARGA                                   -->
  <!-- ================================================ -->
  <PricingTable method="borepile" currentDiameter={tier.diameter} />

  <!-- ================================================ -->
  <!-- 3. KALKULATOR BIAYA                              -->
  <!-- ================================================ -->
  <div style="margin-top: var(--space-8); margin-bottom: var(--space-8);" id="kalkulator">
    <CalculatorUI 
      title={`Kalkulator Biaya Bore Pile Diameter ${tier.diameter} cm`}
      description={`Hitung estimasi total biaya jasa pengeboran bore pile diameter ${tier.diameter} cm untuk proyek Anda. Masukkan jumlah titik dan kedalaman rencana.`}
      defaults={{ method: 'borepile', location: calcLoc, diameter: tier.diameter, depth: simDepth, points: simPoints }} 
    />
  </div>

  <!-- ================================================ -->
  <!-- 4. CONTOH HITUNGAN BIAYA (CostExample)           -->
  <!-- ================================================ -->
  <CostExample
    title={`Contoh Perhitungan Biaya Bore Pile ${tier.diameter} cm`}
    description={`Sebagai gambaran, berikut simulasi perhitungan biaya jasa bore pile diameter ${tier.diameter} cm untuk bangunan bertingkat dengan ${simPoints} titik pondasi sedalam ${simDepth} meter:`}
    ex={costExampleData}
    note="*Contoh perhitungan estimasi jasa bor saja (total volume memenuhi minimal order 200 m). Belum termasuk material besi dan beton, mobilisasi alat, serta pembuatan bak sirkulasi air."
  />

  <!-- ================================================ -->
  <!-- 5. BIAYA TAMBAHAN DI LUAR HARGA JASA             -->
  <!-- ================================================ -->
  <div id="biaya-tambahan">
    <CostAddons service="borepile" materialDesc={dData.materialDesc} customItems={dData.costAddonsItems} />
  </div>

  <!-- ================================================ -->
  <!-- 6. KEUNGGULAN                                    -->
  <!-- ================================================ -->
  <ServiceFeatures
    title={`Keunggulan Jasa Bore Pile Diameter ${tier.diameter} cm di ${siteConfig.brand}`}
    features={dData.features || defaultFeatures}
  />

  <!-- ================================================ -->
  <!-- 7. BORE PILE VS TIANG PANCANG                    -->
  <!-- ================================================ -->
  {dData.comparisonData ? (
    <ComparisonSection
      title={dData.comparisonData.title}
      description={dData.comparisonData.description}
      primaryTitle={dData.comparisonData.primaryTitle}
      primaryDesc={dData.comparisonData.primaryDesc}
      secondaryTitle={dData.comparisonData.secondaryTitle}
      secondaryDesc={dData.comparisonData.secondaryDesc}
      conclusion={dData.comparisonData.conclusion}
    />
  ) : (
    <ComparisonSection
      title={`Bore Pile ${tier.diameter} cm vs Tiang Pancang`}
      description="Pertimbangan pemilihan antara metode bore pile mesin cor di tempat dengan tiang pancang pabrik."
      primaryTitle={`Bore Pile ${tier.diameter} cm`}
      primaryDesc="Pengeboran berputar dengan mesin mini crane minim getaran, sangat aman untuk lingkungan padat dan akses jalan 2,5–3 meter."
      secondaryTitle="Tiang Pancang (Paku Bumi)"
      secondaryDesc="Tiang beton cetak yang dipancang/dipukul. Menimbulkan getaran keras dan suara bising yang berisiko meretakkan bangunan sekitar."
      conclusion="<strong>Kesimpulan:</strong> Untuk area pemukiman padat atau jalan sempit, bore pile mesin adalah solusi yang jauh lebih aman."
    />
  )}

  <!-- ================================================ -->
  <!-- 8. SPESIFIKASI ALAT & KEDALAMAN                  -->
  <!-- ================================================ -->
  <section class="ls-section machine-spec-section">
    <h2 class="ls-mach-title">{dData.machineSpecTitle || `Seberapa Dalam Bore Pile ${tier.diameter} cm Bisa Dibor?`}</h2>
    <p class="ls-mach-p">
      <Fragment set:html={dData.machineSpec?.intro || `Kedalamannya tergantung kekerasan tanah di lokasi proyek, bukan sekadar panjang alat bor. Pada kondisi tanah lempung atau aluvial lunak, mesin mini crane kami mampu mengebor hingga kedalaman <strong>25 sampai 30 meter</strong>. Di tanah yang lebih padat atau berbatu, kedalaman efektif berkisar antara <strong>15 sampai 20 meter</strong>.`} />
    </p>
    <p class="ls-mach-p">
      <Fragment set:html={dData.machineSpec?.maxDepth || `Beban torsi putaran mesin untuk diameter ${tier.diameter} cm tergolong ringan, sehingga mata bor lebih gesit menembus lapisan tanah sampai menemukan lapisan tanah keras (hard strata).`} />
    </p>
    <p class="ls-mach-p">
      <Fragment set:html={dData.machineSpec?.diameterImpact || `Pengeboran selalu dihentikan saat mata bor telah mencapai elevasi tanah keras yang disyaratkan konsultan perencana struktur Anda berdasarkan hasil uji sondir.`} />
    </p>
  </section>

  <!-- ================================================ -->
  <!-- 9. PERBANDINGAN DIAMETER                         -->
  <!-- ================================================ -->
  {dData.diameterComparison && (
    <DiameterComparison data={dData.diameterComparison} />
  )}

  <!-- ================================================ -->
  <!-- 10. DOKUMENTASI PROYEK                           -->
  <!-- ================================================ -->
  {diameterProjects.length > 0 ? (
    <ProjectGallery 
      city={`Lapangan (Diameter ${tier.diameter} cm)`} 
      projects={diameterProjects} 
      subtitle={`Dokumentasi pengerjaan bore pile diameter ${tier.diameter} cm di berbagai lokasi proyek.`} 
    />
  ) : (
    <MiniGallery 
      title={`Proyek Bore Pile ${tier.diameter} cm yang Pernah Kami Kerjakan`} 
      subtitle={`Dokumentasi pengerjaan bore pile diameter ${tier.diameter} cm di lapangan.`}
    />
  )}

  <!-- ================================================ -->
  <!-- 11. TAHAPAN PENGERJAAN (SOP)                     -->
  <!-- ================================================ -->
  <ProcessSteps 
    title={`Tahapan Pengerjaan Bore Pile ${tier.diameter} cm`}
    subtitle="Standar kerja sistematis Aseven Pile untuk menjamin mutu dan keamanan struktur pondasi."
    ctaLink={`https://wa.me/${siteConfig.whatsapp}?text=Halo%20Aseven%20Pile,%20saya%20mau%20konsultasi%20bore%20pile%20diameter%20${tier.diameter}cm`}
    ctaText={`Konsultasi Bore Pile ${tier.diameter} cm →`}
    steps={dData.sopSteps || defaultSopSteps}
  />

  <!-- ================================================ -->
  <!-- 12. FAQ SPESIFIK DIAMETER                        -->
  <!-- ================================================ -->
  <FAQSection 
    title={`Pertanyaan Seputar Bore Pile ${tier.diameter} cm`}
    subtitle="Informasi lengkap biaya, spesifikasi teknis, dan operasional kerja."
    faqs={dData.faqs}
  />

  <!-- ================================================ -->
  <!-- 13. ARTIKEL TERKAIT                              -->
  <!-- ================================================ -->
  <section class="ls-section">
    <h2 class="ls-art-heading">Artikel Terkait</h2>
    <ArticleList limit={1} />
  </section>

  <!-- ================================================ -->
  <!-- 14. CTA WHATSAPP                                 -->
  <!-- ================================================ -->
  <PremiumCTA 
    title={`Konsultasi Proyek Bore Pile ${tier.diameter} cm`}
    subtitle="Kirimkan lokasi, perkiraan jumlah titik, dan kedalaman rencana. Tim kami bantu hitung estimasi biaya proyek Anda."
    buttonText={`Konsultasi Bore Pile ${tier.diameter} cm`}
    waMessage={`Halo Aseven Pile, saya dari website ingin menanyakan terkait Jasa Bore Pile Diameter ${tier.diameter} cm`}
  />

  <!-- ================================================ -->
  <!-- 15. PETA LOKASI & JANGKAUAN WILAYAH              -->
  <!-- ================================================ -->
  <Fragment slot="bottom-content">
    <LocationMap />
    <AreaGrid 
      title={`Wilayah Jangkauan Bore Pile Diameter ${tier.diameter} cm`}
      description={`Layanan pengeboran bore pile diameter ${tier.diameter} cm Aseven Pile mencakup area di bawah ini. Tim dan armada mesin mini crane kami siap dimobilisasi langsung ke lokasi proyek Anda di Pulau Jawa.`}
      hideSearch={true}
    />
  </Fragment>

</LocalSEOLayout>

<style>
  .ls-summary-crosslink {
    margin-top: 16px;
    margin-bottom: 24px;
    font-size: 0.95rem;
    color: var(--color-text);
  }
  .ls-summary-crosslink a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .machine-spec-section {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }
</style>
