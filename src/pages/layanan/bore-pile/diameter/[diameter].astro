---
import BaseLayout from '../../../../components/layout/BaseLayout.astro';
import LastUpdated from '../../../../components/ui/LastUpdated.astro';
import PricingTable from '../../../../components/ui/PricingTable.astro';
import CalculatorUI from '../../../../components/interactive/CalculatorUI.astro';
import CostExample from '../../../../components/ui/CostExample.astro';
import CostAddons from '../../../../components/ui/CostAddons.astro';
import ServiceFeatures from '../../../../components/ui/ServiceFeatures.astro';
import ComparisonSection from '../../../../components/ui/ComparisonSection.astro';
import ProcessSteps from '../../../../components/ui/ProcessSteps.astro';
import MiniGallery from '../../../../components/ui/MiniGallery.astro';
import FAQSection from '../../../../components/ui/FAQSection.astro';
import PremiumCTA from '../../../../components/ui/PremiumCTA.astro';
import CityCrossLinks from '../../../../components/ui/CityCrossLinks.astro';
import ArticleList from '../../../../components/ui/ArticleList.astro';

import '../../../../styles/local-seo.css';
import '../../../../styles/calculator.css';
import { pricingTiers } from '../../../../data/pricing';
import { siteConfig } from '../../../../data/site.config';

export async function getStaticPaths() {
  return pricingTiers.map((tier) => ({
    params: { diameter: tier.diameter.toString() },
    props: { tier },
  }));
}

const { tier } = Astro.props;

const otherDiameters = pricingTiers.filter((t) => t.diameter !== tier.diameter);

const priceFormatted =
  tier.pricePerMeter.min === tier.pricePerMeter.max
    ? `Rp ${tier.pricePerMeter.min.toLocaleString("id-ID")}`
    : `Rp ${tier.pricePerMeter.min.toLocaleString("id-ID")} – Rp ${tier.pricePerMeter.max.toLocaleString("id-ID")}`;

// Technical volume & rebar spec data
const volumeMap: Record<number, { m3Theoritical: string; m3Actual: string; rebar: string; maxDepth: string }> = {
  30: { m3Theoritical: "0,071", m3Actual: "0,08", rebar: "5–6 batang besi ulir D13 / D16 dengan sengkang spiral Ø8", maxDepth: "25 – 30 meter" },
  40: { m3Theoritical: "0,126", m3Actual: "0,14", rebar: "6–8 batang besi ulir D13 / D16 dengan sengkang spiral Ø8", maxDepth: "25 – 30 meter" },
  50: { m3Theoritical: "0,196", m3Actual: "0,22", rebar: "8–10 batang besi ulir D16 / D19 dengan sengkang spiral Ø10", maxDepth: "20 – 25 meter" },
  60: { m3Theoritical: "0,283", m3Actual: "0,32", rebar: "10–12 batang besi ulir D16 / D19 / D22 dengan sengkang spiral Ø10", maxDepth: "20 – 25 meter" },
  80: { m3Theoritical: "0,503", m3Actual: "0,56", rebar: "12–16 batang besi ulir D19 / D22 / D25 dengan sengkang spiral Ø10/Ø12", maxDepth: "15 – 20 meter" },
};
const volumeData = volumeMap[tier.diameter] || {
  m3Theoritical: "0,08",
  m3Actual: "0,10",
  rebar: "Besi ulir SNI mengikuti gambar perencana struktur",
  maxDepth: "20 – 30 meter",
};

// Simulation calculation data (RAB example)
const exampleConfigs: Record<number, { points: number; depthM: number }> = {
  30: { points: 20, depthM: 12 },
  40: { points: 18, depthM: 12 },
  50: { points: 16, depthM: 14 },
  60: { points: 15, depthM: 15 },
  80: { points: 12, depthM: 16 },
};
const sim = exampleConfigs[tier.diameter] || { points: 20, depthM: 12 };
const exampleTotal = sim.points * sim.depthM * tier.pricePerMeter.min;
const exampleData = {
  isReal: false,
  items: [
    {
      diameterCm: tier.diameter,
      pricePerM: tier.pricePerMeter.min,
      depthM: sim.depthM,
      points: sim.points,
      subtotal: exampleTotal,
    },
  ],
  total: exampleTotal,
};

// FAQ Data tailored to diameter
const diameterFaqs = [
  {
    question: `Berapa harga jasa bore pile diameter ${tier.diameter}cm per meter lari?`,
    answer: `Harga jasa pengeboran bore pile diameter ${tier.diameter}cm adalah <strong>${priceFormatted} per meter lari (m&sup1;)</strong>. Biaya ini merupakan jasa bor saja dan belum termasuk material (besi tulangan & beton ready mix), biaya mobilisasi/demobilisasi alat mini crane, serta pembuatan bak sirkulasi air/lumpur.`,
  },
  {
    question: `Berapa kedalaman maksimal pengeboran bore pile diameter ${tier.diameter}cm?`,
    answer: `Mesin mini crane kami mampu mengebor hingga kedalaman <strong>${volumeData.maxDepth}</strong>, tergantung pada kekerasan lapisan tanah di lokasi proyek. Titik henti pengeboran mengacu pada rekomendasi hasil uji sondir saat mata bor telah mencapai lapisan tanah keras pembawa daya dukung (hard strata).`,
  },
  {
    question: `Berapa kebutuhan beton cor per meter untuk bore pile diameter ${tier.diameter}cm?`,
    answer: `Secara perhitungan teoritis, diameter ${tier.diameter}cm membutuhkan sekitar <strong>${volumeData.m3Theoritical} m&sup3;</strong> beton per meter lari. Namun dengan memperhitungkan faktor pengembangan (waste) di dalam tanah sebesar 10–15%, kebutuhan riil beton berkisar <strong>${volumeData.m3Actual} m&sup3; per meter lari</strong>.`,
  },
  {
    question: `Apakah bore pile diameter ${tier.diameter}cm aman untuk lingkungan padat pemukiman?`,
    answer: `<strong>Sangat aman.</strong> Berbeda dengan tiang pancang (paku bumi) yang dipancang dengan palu berat sehingga menimbulkan getaran merusak, bore pile menggunakan sistem bor putar (auger) yang minim getaran sehingga aman untuk dinding bangunan tetangga di sebelahnya.`,
  },
  {
    question: `Berapa minimal order volume pekerjaan untuk bore pile diameter ${tier.diameter}cm?`,
    answer: `Minimal order pekerjaan jasa bore pile mesin adalah <strong>200 meter lari (m&sup1;)</strong>. Jika volume total proyek Anda di bawah batas tersebut, pekerjaan tetap dapat dilaksanakan dengan pemberlakuan biaya minimum (lumpsum) setara 200 meter atau tarif kesepakatan survei.`,
  },
  {
    question: `Metode pengeboran apa yang digunakan untuk bore pile diameter ${tier.diameter}cm?`,
    answer: `Kami menerapkan dua metode utama sesuai kondisi lapangan: metode <strong>wash boring (bor basah)</strong> dengan sirkulasi air untuk tanah berair atau mudah runtuh, serta metode <strong>dry boring (bor kering)</strong> untuk lapisan tanah lempung yang liat. Seluruh pengecoran dilakukan dengan <strong>sistem pipa tremi</strong> agar beton padat utuh tanpa tercampur lumpur galian.`,
  },
];

// URLs and Breadcrumbs
const pageUrl = `${siteConfig.url}/layanan/bore-pile/diameter/${tier.diameter}`;
const breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Beranda", "item": siteConfig.url },
  { "@type": "ListItem", "position": 2, "name": "Layanan", "item": `${siteConfig.url}/layanan` },
  { "@type": "ListItem", "position": 3, "name": "Bore Pile Mesin", "item": `${siteConfig.url}/layanan/bore-pile-mesin` },
  { "@type": "ListItem", "position": 4, "name": `Diameter ${tier.diameter}cm`, "item": pageUrl },
];

// WhatsApp URL with lead prefilled text
const waConsultUrl = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(`Halo Aseven Pile, saya ingin konsultasi harga dan survei bore pile diameter ${tier.diameter}cm.`)}`;

// Schema definitions
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `Jasa Bore Pile Mesin Diameter ${tier.diameter}cm`,
  "description": `Jasa bore pile mesin mini crane diameter ${tier.diameter}cm per meter lari. Minim getaran, sistem pipa tremi, dan tim spesialis berpengalaman sejak ${siteConfig.foundingYear}.`,
  "image": `${siteConfig.url}/imgs/header-beranda-bore-pile-aseven.webp`,
  "brand": {
    "@type": "Brand",
    "name": siteConfig.brand,
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "IDR",
    "lowPrice": tier.pricePerMeter.min.toString(),
    "highPrice": tier.pricePerMeter.max.toString(),
    "price": tier.pricePerMeter.min.toString(),
    "offerCount": "1",
    "availability": "https://schema.org/InStock",
    "priceValidUntil": "2027-12-31",
    "url": pageUrl,
  },
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Jasa Bore Pile Diameter ${tier.diameter}cm`,
  "provider": {
    "@type": "LocalBusiness",
    "name": siteConfig.brand,
  },
  "description": `Pondasi bore pile mesin diameter ${tier.diameter}cm untuk ${tier.notes}`,
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "IDR",
    "lowPrice": tier.pricePerMeter.min.toString(),
    "highPrice": tier.pricePerMeter.max.toString(),
    "availability": "https://schema.org/InStock",
    "url": pageUrl,
  },
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": siteConfig.brand,
  "description": `Spesialis jasa bore pile mesin dan strauss pile manual profesional. Alat mini crane milik sendiri.`,
  "url": pageUrl,
  "telephone": siteConfig.phone,
  "email": siteConfig.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.street,
    "addressLocality": siteConfig.address.city,
    "addressRegion": siteConfig.address.province,
    "postalCode": siteConfig.address.postalCode,
    "addressCountry": "ID",
  },
  "serviceType": ["Bore Pile", `Bore Pile Diameter ${tier.diameter}cm`, "Pondasi Dalam"],
  "priceRange": "Rp 70.000 - Rp 350.000",
  "foundingDate": siteConfig.foundingYear.toString(),
  "sameAs": Object.values(siteConfig.socialMedia),
  "dateModified": new Date(siteConfig.contentUpdated).toISOString(),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": diameterFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems,
};
---

<BaseLayout
  title={`Harga Jasa Bore Pile Diameter ${tier.diameter}cm 2026`}
  description={`Jasa bore pile mesin diameter ${tier.diameter}cm per meter mulai ${priceFormatted}. ${tier.notes} Mesin mini crane & gawangan milik sendiri, minim getaran, pipa tremi. Konsultasi & survei gratis.`}
>
  <!-- LD+JSON Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema).replace(/</g, "\\u003c")} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema).replace(/</g, "\\u003c")} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema).replace(/</g, "\\u003c")} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema).replace(/</g, "\\u003c")} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g, "\\u003c")} />

  <!-- ================================================ -->
  <!-- HEADER & HERO (Matching Pilot Page)              -->
  <!-- ================================================ -->
  <header class="section local-seo-header">
    <div class="container local-seo-header-inner">
      <!-- HTML Breadcrumbs with Microdata -->
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <ol itemscope itemtype="https://schema.org/BreadcrumbList">
          {breadcrumbItems.map((item, index) => (
            <>
              {index > 0 && <li class="separator">&rsaquo;</li>}
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class={index === breadcrumbItems.length - 1 ? "active" : ""}>
                {index === breadcrumbItems.length - 1 ? (
                  <span itemprop="name">{item.name}</span>
                ) : (
                  <a itemprop="item" href={new URL(item.item as string).pathname}>
                    <span itemprop="name">{item.name}</span>
                  </a>
                )}
                <meta itemprop="position" content={item.position.toString()} />
              </li>
            </>
          ))}
        </ol>
      </nav>

      <span class="badge-service">Bore Pile Mesin</span>

      <h1>Harga Jasa Bore Pile Diameter {tier.diameter}cm 2026</h1>

      <div class="last-updated-wrapper">
        <LastUpdated prefix="Update" hideIcon={true} />
      </div>

      <div class="header-image-wrapper">
        <img
          src="/imgs/header-beranda-bore-pile-aseven.webp"
          alt={`Pekerjaan Pondasi Bore Pile Mesin Diameter ${tier.diameter}cm oleh Aseven Pile`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="900"
          height="675"
        />
      </div>

      <!-- Google Ads High-Converting Above-The-Fold Trust & CTA Bar -->
      <div class="hero-ads-cta-bar">
        <div class="ads-trust-badges">
          <span class="trust-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Alat Milik Sendiri
          </span>
          <span class="trust-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Minim Getaran
          </span>
          <span class="trust-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Sistem Pipa Tremi
          </span>
          <span class="trust-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Berpengalaman Sejak {siteConfig.foundingYear}
          </span>
        </div>
        <a href={waConsultUrl} class="btn-glow-wa" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Konsultasi & Survei Gratis via WhatsApp</span>
        </a>
      </div>
    </div>
  </header>

  <article class="container local-seo-article">
    <!-- ================================================ -->
    <!-- SECTION 1: Service Intro & Summary Box           -->
    <!-- ================================================ -->
    <section class="ls-section">
      <div class="ls-summary-box">
        <div class="ls-summary-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </div>
        <p class="ls-summary-text">
          <strong>Ringkasan Biaya:</strong> Harga jasa bore pile mesin diameter {tier.diameter}cm berkisar mulai dari <strong>{priceFormatted} / meter lari (m&sup1;)</strong>. Biaya ini merupakan jasa pengeboran bor saja; belum termasuk material (besi dan beton ready mix), biaya mobilisasi/demobilisasi alat, serta pembuatan bak sirkulasi air.
        </p>
      </div>

      {(tier.diameter === 30 || tier.diameter === 40) && (
        <div class="ls-summary-crosslink">
          Mencari pondasi manual untuk akses gang sangat sempit (&lt; 3 meter)? Lihat <a href={`/layanan/strauss-pile/diameter/${tier.diameter}`}>jasa strauss pile manual diameter {tier.diameter}cm</a>.
        </div>
      )}

      <p class="ls-intro-p">
        Pondasi <strong>bore pile diameter {tier.diameter}cm</strong> merupakan salah satu spesifikasi pondasi dalam yang sering diaplikasikan untuk konstruksi {tier.notes.toLowerCase()} Dengan dimensi penampang {tier.diameter} cm, tiang pondasi mampu mentransfer beban aksial bangunan secara merata ke lapisan tanah keras di kedalaman yang ditentukan oleh perencana struktur.
      </p>

      <p class="ls-intro-p-flat">
        Kami menyediakan jasa pengeboran bore pile mesin menggunakan unit <strong>mini crane dan gawangan</strong> milik sendiri. Metode kerja fleksibel dengan pilihan <em>wash boring</em> (sirkulasi air) untuk lapisan tanah berair maupun <em>dry boring</em> (bor kering) untuk tanah lempung yang liat. Didukung sistem pengecoran pipa tremi, lubang pondasi dicor secara masif tanpa risiko pemisahan butir (segregasi) maupun tercampur lumpur sisa pengeboran.
      </p>
    </section>

    <!-- ================================================ -->
    <!-- SECTION 2: Spesifikasi Teknis & Highlight Harga  -->
    <!-- ================================================ -->
    <section class="ls-section">
      <div class="diameter-spec-card">
        <div class="spec-card-header">
          <div>
            <span class="spec-badge">Spesifikasi Diameter</span>
            <h2 class="spec-title">Bore Pile Diameter {tier.diameter} cm</h2>
          </div>
          <div class="spec-price-tag">
            <span class="price-prefix">Harga Jasa Bor</span>
            <span class="price-main">{priceFormatted}</span>
            <span class="price-suffix">/ meter lari (m&sup1;)</span>
            {tier.isEstimate && <span class="badge-est-warning">⚠️ Harga Estimasi Lapangan</span>}
          </div>
        </div>

        <div class="spec-grid">
          <div class="spec-item">
            <span class="spec-label">Diameter Lubang</span>
            <span class="spec-value">{tier.diameter} cm (0,{tier.diameter} m)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Metode Pengeboran</span>
            <span class="spec-value">Mesin Mini Crane / Gawangan (Bor Basah & Kering)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Jangkauan Kedalaman</span>
            <span class="spec-value">{volumeData.maxDepth} (Target Tanah Keras)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Volume Beton / Meter</span>
            <span class="spec-value">&plusmn; {volumeData.m3Actual} m&sup3; / m&sup1; (Termasuk faktor waste)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Kebutuhan Akses Truk</span>
            <span class="spec-value">Lebar minimal 3 meter (Mobilisasi alat)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Minimal Order Jasa</span>
            <span class="spec-value">200 meter lari (m&sup1;)</span>
          </div>
          <div class="spec-item full-width">
            <span class="spec-label">Peruntukan Bangunan</span>
            <span class="spec-value">{tier.notes}</span>
          </div>
          <div class="spec-item full-width">
            <span class="spec-label">Tipikal Pembesian (Besi Tulangan)</span>
            <span class="spec-value">{volumeData.rebar} <small style="display:block; color:#64748b; font-weight:normal;">*Spesifikasi pembesian riil wajib mengikuti gambar teknis konsultan perencana struktur proyek Anda.</small></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================ -->
    <!-- SECTION 2b: Tabel Daftar Harga Lengkap           -->
    <!-- ================================================ -->
    <PricingTable method="borepile" />

    <!-- ================================================ -->
    <!-- SECTION 3: Kalkulator Interaktif                 -->
    <!-- ================================================ -->
    <section id="kalkulator" class="ls-section">
      <CalculatorUI
        title={`Kalkulator Harga Bore Pile Diameter ${tier.diameter}cm`}
        description={`Hitung estimasi total RAB jasa bore pile diameter ${tier.diameter}cm berdasarkan kedalaman titik dan jumlah titik proyek Anda.`}
        defaults={{ method: 'borepile', diameter: tier.diameter, depth: sim.depthM, points: sim.points }}
      />
    </section>

    <!-- ================================================ -->
    <!-- SECTION 4: Contoh Perhitungan Biaya (Simulasi)   -->
    <!-- ================================================ -->
    <CostExample
      method="borepile"
      title={`Contoh Perhitungan Biaya Bore Pile Diameter ${tier.diameter}cm`}
      description={`Berikut simulasi perhitungan estimasi biaya jasa pengeboran bore pile diameter ${tier.diameter}cm untuk gambaran awal anggaran pondasi proyek Anda:`}
      ex={exampleData}
      note="*Contoh simulasi perhitungan jasa bor saja. Belum termasuk material (besi tulangan & cor beton), mobilisasi mesin, dan bak sirkulasi air."
    />

    <!-- ================================================ -->
    <!-- SECTION 5: Biaya Tambahan di Luar Jasa           -->
    <!-- ================================================ -->
    <CostAddons service="borepile" />

    <!-- ================================================ -->
    <!-- SECTION 6: Keunggulan Layanan                    -->
    <!-- ================================================ -->
    <ServiceFeatures
      title={`Keunggulan Jasa Bore Pile Diameter ${tier.diameter}cm Aseven Pile`}
      features={[
        {
          title: "Minim Getaran & Aman",
          desc: `Pengeboran mesin mini crane dirancang bekerja berputar tanpa getaran pukulan masif. Sangat aman dikerjakan berdampingan dengan pagar dan dinding rumah tetangga.`,
          iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
        },
        {
          title: "Berpengalaman Sejak 2005",
          desc: "Didukung operator dan mandor spesialis yang telah puluhan tahun menangani pekerjaan pondasi dalam pada beragam karakteristik tanah lunak, lempung, hingga berpasir.",
          iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>`,
        },
        {
