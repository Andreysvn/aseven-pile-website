---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import { SERVICE_CITIES } from '../../../data/seo-data';

const title = "Jasa Strauss Pile Manual (Bor Tangan) | Aseven Pile";
const description = "Layanan pondasi strauss pile manual tanpa mesin. Solusi ekonomis & sunyi untuk rumah tinggal, pagar, dan bangunan di area padat atau gang sempit.";

// Filter out draft cities (if any exist in the array)
const activeCities = SERVICE_CITIES.filter(city => !city.draft);
---

<BaseLayout title={title} description={description}>
  <!-- HERO -->
  <div class="hero-service" style="background: linear-gradient(135deg, var(--color-bg-alt) 0%, #fff 100%); padding: var(--space-12) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container text-center" style="max-width: 800px;">
      <span class="badge" style="display:inline-block; padding: 4px 12px; background: rgba(22,163,74,0.1); color: #16a34a; border-radius: 20px; font-weight:600; font-size: 0.875rem; margin-bottom: var(--space-4);">Pondasi Manual Sunyi</span>
      <h1 style="color: var(--color-primary); margin-bottom: var(--space-4); font-size: clamp(32px, 5vw, 48px); line-height: 1.2;">Strauss Pile Manual (Bor Tangan)</h1>
      <p class="subtitle" style="font-size: 1.125rem; color: var(--color-text-muted); line-height: 1.7;">
        Metode pengeboran pondasi dengan tenaga manusia (bor tangan). Pilihan ekonomis dan bebas polusi suara untuk rumah tinggal, pagar, dan ruko kecil di lahan sempit atau gang padat penduduk.
      </p>
    </div>
  </div>

  <!-- CONTENT -->
  <section class="section">
    <div class="container" style="max-width: 900px;">

      <div style="display: grid; grid-template-columns: 1fr; gap: var(--space-8); margin-bottom: var(--space-12);">
        <div>
          <h2 style="margin-bottom: var(--space-4); font-size: 1.75rem;">Apa itu Strauss Pile?</h2>
          <p style="margin-bottom: var(--space-4); font-size: 1.05rem; line-height: 1.8;">
            Strauss pile adalah pondasi dalam yang dipasang dengan cara mengebor tanah menggunakan alat bor manual yang diputar oleh tenaga manusia. Karena tanpa mesin, metode ini sangat cocok untuk area yang tidak bisa dijangkau alat berat.
          </p>
          <p style="font-size: 1.05rem; line-height: 1.8;">
            Setelah lubang bor mencapai kedalaman tanah keras, besi tulangan spiral dimasukkan lalu dicor bertahap sambil dipadatkan. Kedalaman efektif umumnya berkisar 4–8 meter menyesuaikan karakteristik tanah.
          </p>
        </div>
      </div>

      <!-- SPECS & ADVANTAGES -->
      <div style="background: var(--color-bg-alt); padding: var(--space-8); border-radius: var(--radius-lg); margin-bottom: var(--space-12);">
        <h2 style="text-align: center; margin-bottom: var(--space-8);">Kelebihan Metode Strauss Pile</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-6);">

          <div style="background: white; padding: var(--space-6); border-radius: var(--radius-md); border: 1px solid var(--color-border-light);">
            <h3 style="color: #16a34a; font-size: 1.25rem; margin-bottom: var(--space-2);">Bisa Masuk Gang Sempit</h3>
            <p style="font-size: 0.95rem; color: var(--color-text-muted); line-height: 1.6;">Alat bor ringkas dan bisa dipanggul, sehingga tetap bisa dikerjakan meski akses jalan hanya selebar motor.</p>
          </div>

          <div style="background: white; padding: var(--space-6); border-radius: var(--radius-md); border: 1px solid var(--color-border-light);">
            <h3 style="color: #16a34a; font-size: 1.25rem; margin-bottom: var(--space-2);">Nol Polusi Suara</h3>
            <p style="font-size: 0.95rem; color: var(--color-text-muted); line-height: 1.6;">100% tanpa mesin sehingga tidak menimbulkan kebisingan dan aman dari komplain tetangga sekitar proyek.</p>
          </div>

          <div style="background: white; padding: var(--space-6); border-radius: var(--radius-md); border: 1px solid var(--color-border-light);">
            <h3 style="color: #16a34a; font-size: 1.25rem; margin-bottom: var(--space-2);">Harga Lebih Ekonomis</h3>
            <p style="font-size: 0.95rem; color: var(--color-text-muted); line-height: 1.6;">Tanpa bahan bakar dan operasional alat berat, harga jasa per meter jauh lebih murah dibanding bore pile mesin.</p>
          </div>

        </div>
      </div>

      <!-- INTERNAL LINKING: LOCAL SEO HUBS -->
      <div style="border: 1px solid var(--color-border-light); border-radius: var(--radius-lg); padding: var(--space-8); text-align: center; margin-bottom: var(--space-12);">
        <h2 style="margin-bottom: var(--space-2); font-size: 1.75rem;">Area Layanan Strauss Pile Kami</h2>
        <p style="color: var(--color-text-muted); margin-bottom: var(--space-8); max-width: 600px; margin-left: auto; margin-right: auto;">
          Pilih lokasi proyek Anda di bawah ini untuk melihat rincian harga per meter, simulasi biaya via kalkulator, dan promo khusus di kota Anda.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--space-4);">
          {activeCities.map((city) => (
            <a
              href={`/area-layanan/strauss-pile/${city.slug}`}
              style="display: block; padding: var(--space-4); background: white; border-radius: var(--radius-md); border: 1px solid var(--color-border-light); text-decoration: none; transition: all 0.2s;"
              class="city-btn"
            >
              <span style="display: block; font-weight: 600; color: var(--color-text);">{city.name}</span>
              <span style="display: block; font-size: 0.8rem; color: var(--color-primary); margin-top: 4px;">Lihat Harga &rarr;</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <style>
    .city-btn:hover {
      border-color: var(--color-primary) !important;
      transform: translateY(-2px);
      box-shadow: 0 4px 6px -1px rgba(128, 0, 0, 0.1);
    }
  </style>
</BaseLayout>
