---
import LocalSEOLayout from '../../components/layout/LocalSEOLayout.astro';
import PriceCalculator from '../../components/calculator/PriceCalculator.tsx';
import { SERVICE_CITIES, GLOBAL_FAQS } from '../../data/seo-data';
import { siteConfig } from '../../data/site.config';

export async function getStaticPaths() {
  return SERVICE_CITIES.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const combinedFaqs = [...GLOBAL_FAQS, ...cityData.localFaqs];

// Internal linking: other cities
const otherCities = SERVICE_CITIES.filter(c => c.slug !== cityData.slug).slice(0, 6);
---

<LocalSEOLayout 
  title={`Jasa Bore Pile & Strauss Pile ${cityData.name}`} 
  description={cityData.description}
  city={cityData.name}
  serviceName="Jasa Bore Pile"
>
  
  <h2>Solusi Pondasi Terbaik di {cityData.name}</h2>
  <p>
    ASeven Pile hadir sebagai solusi kontraktor pondasi paku bumi, bore pile, dan strauss pile terpercaya untuk wilayah {cityData.name} dan sekitarnya. 
    Dengan pengalaman bertahun-tahun, kami menjamin kualitas konstruksi yang kokoh, aman, dan berstandar nasional.
  </p>

  <div class="my-12">
    <h3 class="text-2xl font-bold mb-4 text-center">Hitung Estimasi Biaya Proyek Anda di {cityData.name}</h3>
    <div class="p-6 bg-white rounded-xl shadow-lg border border-gray-100">
      <PriceCalculator client:load />
    </div>
  </div>

  <div class="my-12">
    <h3 class="text-2xl font-bold mb-6">Pertanyaan Seputar Proyek di {cityData.name}</h3>
    <div class="space-y-4">
      {combinedFaqs.map((faq) => (
        <details class="group border border-gray-200 rounded-lg p-4 bg-white cursor-pointer hover:bg-gray-50">
          <summary class="font-semibold text-gray-800 list-none flex justify-between items-center">
            {faq.question}
            <span class="text-blue-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-4 text-gray-600 leading-relaxed border-t pt-4">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </div>

  <!-- Internal Linking: Area Lainnya -->
  <div class="my-12 bg-gray-50 rounded-xl p-8">
    <h3 class="text-2xl font-bold mb-6 text-center">Area Layanan Lainnya</h3>
    <p class="text-gray-600 text-center mb-6">Kami juga melayani jasa bore pile dan strauss pile di area berikut:</p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {otherCities.map((city) => (
        <a 
          href={`/area/${city.slug}`} 
          class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-md transition-all text-center"
        >
          <span class="font-semibold text-gray-800">{city.name}</span>
          <span class="block text-sm text-gray-500 mt-1">{city.province}</span>
        </a>
      ))}
    </div>
  </div>

</LocalSEOLayout>