---
import LocalSEOLayout from '../../components/layout/LocalSEOLayout.astro';


import { SERVICE_CITIES } from '../../data/seo-data';

export async function getStaticPaths() {
  const activeCities = SERVICE_CITIES.filter(c => !c.draft);
  return activeCities.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const activeCities = SERVICE_CITIES.filter(c => !c.draft);
const otherCities = activeCities.filter(c => c.slug !== cityData.slug).slice(0, 6);
---

<LocalSEOLayout 
  title={`Pusat Layanan ASeven Pile di ${cityData.name}`} 
  description={`Mitra kontraktor terpercaya untuk berbagai kebutuhan proyek Anda di ${cityData.name}. Kami hadir memberikan solusi profesional, cepat, dan transparan.`}
  city={cityData.name}
  serviceName="Layanan Konstruksi & Pendukung"
  pathContext="general"
>

    <!-- HUB INTRODUCTION -->
  <div class="hub-intro">
    <p class="lead-text">
      Sedang merencanakan pembangunan di <strong>{cityData.name}</strong>? ASeven Pile siap membantu kelancaran proyek Anda. Kami adalah kontraktor spesialis yang melayani pekerjaan pondasi serta berbagai layanan konstruksi lainnya untuk rumah tinggal, ruko, hingga gedung bertingkat.
    </p>
  </div>

  <!-- SERVICE DIRECTORY -->
  <section class="services-directory">
    <div class="section-header">
      <h2>Pilihan Layanan</h2>
      <p>Pilih metode yang paling sesuai dengan kebutuhan bangunan dan lokasi proyek Anda di {cityData.name}.</p>
    </div>

        <div class="directory-grid">
      
      <!-- SERVICE 1: BORE PILE -->
      <a href={`/area-layanan/bore-pile/${cityData.slug}`} class="dir-card">
        <div class="card-image">
          <img src="/imgs/header-beranda-bore-pile-aseven-2.webp" alt="Pekerjaan Bore Pile Mesin" loading="lazy" />
        </div>
        <div class="card-content">
          <h3>Bore Pile Mesin</h3>
          <p>Pengeboran menggunakan alat mesin (mini crane). Sangat cocok untuk bangunan skala menengah ke atas yang membutuhkan pondasi kokoh dan dalam.</p>
          <span class="action-link">Lihat Harga & Detail &rarr;</span>
        </div>
      </a>

      <!-- SERVICE 2: STRAUSS PILE -->
      <a href={`/area-layanan/strauss-pile/${cityData.slug}`} class="dir-card">
        <div class="card-image">
          <img src="/imgs/wa-gallery-1.webp" alt="Pekerjaan Strauss Pile Manual" loading="lazy" />
        </div>
        <div class="card-content">
          <h3>Strauss Pile Manual</h3>
          <p>Pengeboran dengan tenaga manusia. Tanpa getaran dan suara bising, sehingga sangat aman untuk perumahan atau proyek di area padat penduduk.</p>
          <span class="action-link">Lihat Harga & Detail &rarr;</span>
        </div>
      </a>

    </div>
  </section>

  

  <!-- OTHER CITIES LINKS -->
  <section class="other-cities">
    <h3>Cari Area Layanan Lain?</h3>
    <p>Selain {cityData.name}, kami juga melayani pekerjaan pondasi di kota-kota berikut:</p>
    <div class="city-chips">
      {otherCities.map((city) => (
        <a href={`/area-layanan/${city.slug}`} class="city-chip">
          {city.name}
        </a>
      ))}
      <a href="/area-layanan" class="city-chip chip-all">
        Lihat Semua Kota &rarr;
      </a>
    </div>
  </section>

  
</LocalSEOLayout>

<style>
  /* HUB INTRO */
  .hub-intro {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  .lead-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-text);
    max-width: 760px;
    margin: 0 auto;
  }

  /* DIRECTORY GRID */
  .services-directory {
    margin-bottom: var(--space-16);
  }
  .section-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .section-header h2 {
    font-size: 2rem;
    margin-bottom: var(--space-3);
    color: var(--color-text);
  }
  .section-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }
  .directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 900px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

    /* DIR CARDS */
  .dir-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.3s ease;
    overflow: hidden;
  }
  .dir-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
  }
  .dir-card:hover .card-image img {
    transform: scale(1.05);
  }
  
  .card-image {
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #f1f5f9;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .card-content h3 {
    margin: 0 0 12px 0;
    font-size: 1.5rem;
    color: var(--color-primary);
    font-weight: 700;
  }
  .card-content p {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 24px 0;
    flex-grow: 1;
  }
  .action-link {
    font-weight: 600;
    font-size: 1rem;
    color: white;
    background: var(--color-primary);
    padding: 12px 24px;
    border-radius: 8px;
    text-align: center;
    display: block;
    transition: background 0.3s;
  }
  .dir-card:hover .action-link {
    background: #6a0000;
  }

  /* OTHER CITIES */
  .other-cities {
    text-align: center;
    padding: var(--space-8);
    border-top: 1px solid var(--color-border-light);
    margin-bottom: var(--space-12);
  }
  .other-cities h3 {
    margin-bottom: var(--space-3);
  }
  .other-cities p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .city-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .city-chip {
    padding: 8px 16px;
    background: #f8f9fa;
    border: 1px solid var(--color-border-light);
    border-radius: 20px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .city-chip:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }
  .chip-all {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .chip-all:hover {
    background: var(--color-primary);
    color: white;
  }
</style>