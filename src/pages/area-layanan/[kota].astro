---
import LocalSEOLayout from '../../components/layout/LocalSEOLayout.astro';
import { SERVICE_CITIES } from '../../data/seo-data';

export async function getStaticPaths() {
  const activeCities = SERVICE_CITIES.filter(c => !c.draft);
  return activeCities.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const activeCities = SERVICE_CITIES.filter(c => !c.draft);
const otherCities = activeCities.filter(c => c.slug !== cityData.slug).slice(0, 6);
---

<LocalSEOLayout 
  title={`Jasa Bore Pile & Strauss Pile di ${cityData.name}`} 
  description={`Jasa bore pile dan strauss pile di ${cityData.name}. Tim ASeven Pile siap menangani proyek pondasi rumah, ruko, hingga gedung bertingkat. Harga transparan, survei gratis.`}
  city={cityData.name}
  serviceName="Bore Pile & Strauss Pile"
  pathContext="general"
>

  <!-- SERVICE DIRECTORY -->
  <section class="services-directory">
    <p class="hub-intro">Pilih jenis pekerjaan pondasi yang sesuai dengan kondisi lahan dan kebutuhan proyek Anda di {cityData.name}.</p>

    <div class="directory-grid">
      
      <!-- SERVICE 1: BORE PILE -->
      <a href={`/area-layanan/bore-pile/${cityData.slug}`} class="dir-card">
        <div class="card-image">
          <img src="/imgs/header-beranda-bore-pile-aseven-2.webp" alt={`Pekerjaan Bore Pile Mesin di ${cityData.name}`} loading="eager" />
        </div>
        <div class="card-content">
          <h2>Bore Pile Mesin</h2>
          <p>Pengeboran pakai mesin mini crane. Cocok untuk bangunan skala menengah ke atas yang butuh pondasi dalam dan kokoh.</p>
          <span class="action-link">Lihat Harga &amp; Detail &rarr;</span>
        </div>
      </a>

      <!-- SERVICE 2: STRAUSS PILE -->
      <a href={`/area-layanan/strauss-pile/${cityData.slug}`} class="dir-card">
        <div class="card-image">
          <img src="/imgs/wa-gallery-1.webp" alt={`Pekerjaan Strauss Pile Manual di ${cityData.name}`} loading="lazy" />
        </div>
        <div class="card-content">
          <h2>Strauss Pile Manual</h2>
          <p>Pengeboran dengan tenaga manusia. Tanpa getaran dan suara bising — aman untuk perumahan padat penduduk.</p>
          <span class="action-link">Lihat Harga &amp; Detail &rarr;</span>
        </div>
      </a>

    </div>
  </section>

  <!-- OTHER CITIES LINKS -->
  <section class="other-cities">
    <p class="other-label">Kami juga melayani:</p>
    <div class="city-chips">
      {otherCities.map((city) => (
        <a href={`/area-layanan/${city.slug}`} class="city-chip">
          {city.name}
        </a>
      ))}
      <a href="/area-layanan" class="city-chip chip-all">
        Semua Kota &rarr;
      </a>
    </div>
  </section>

</LocalSEOLayout>

<style>
  .hub-intro {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto var(--space-8) auto;
  }

  /* DIRECTORY GRID */
  .services-directory {
    margin-bottom: var(--space-12);
  }
  .directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 900px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* DIR CARDS */
  .dir-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.3s ease;
    overflow: hidden;
  }
  .dir-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
    transform: translateY(-3px);
  }
  .dir-card:hover .card-image img {
    transform: scale(1.05);
  }
  
  .card-image {
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #f1f5f9;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .card-content h2 {
    margin: 0 0 10px 0;
    font-size: 1.4rem;
    color: var(--color-primary);
    font-weight: 700;
  }
  .card-content p {
    font-size: 0.97rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }
  .action-link {
    font-weight: 600;
    font-size: 0.97rem;
    color: white;
    background: var(--color-primary);
    padding: 11px 20px;
    border-radius: 8px;
    text-align: center;
    display: block;
    transition: background 0.3s;
  }
  .dir-card:hover .action-link {
    background: #6a0000;
  }

  /* OTHER CITIES */
  .other-cities {
    text-align: center;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
    margin-bottom: var(--space-12);
  }
  .other-label {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-4);
  }
  .city-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .city-chip {
    padding: 6px 14px;
    background: #f8f9fa;
    border: 1px solid var(--color-border-light);
    border-radius: 20px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .city-chip:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }
  .chip-all {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
    font-weight: 600;
  }
  .chip-all:hover {
    background: var(--color-primary);
    color: white;
  }
</style>
