---
import fs from 'node:fs';
import path from 'node:path';
import LocalSEOLayout from '../../components/layout/LocalSEOLayout.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import AreaGrid from '../../components/ui/AreaGrid.astro';
import { SERVICE_CITIES } from '../../data/seo-data';
import { CITY_SERVICES } from '../../data/services';

export async function getStaticPaths() {
  const activeCities = SERVICE_CITIES.filter(c => !c.draft);
  return activeCities.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const activeCities = SERVICE_CITIES.filter(c => !c.draft);
const otherCities = activeCities.filter(c => c.slug !== cityData.slug).slice(0, 6);
const activeServices = CITY_SERVICES.filter(s => s.available);
---

<LocalSEOLayout 
  title={`Layanan Konstruksi di ${cityData.name} | ASeven Pile`}
  h1={`Layanan di ${cityData.name}`} 
  description={`Jasa kontraktor spesialis di ${cityData.name}. ASeven Pile melayani berbagai kebutuhan konstruksi - dari pekerjaan pondasi hingga layanan pendukung proyek lainnya. Survei gratis, harga transparan.`}
  city={cityData.name}
  serviceName="Layanan Konstruksi"
  pathContext="general"
>

  <!-- SERVICE DIRECTORY -->
  <section class="services-directory">
    <p class="hub-intro">Pilih jenis layanan yang sesuai dengan kebutuhan proyek Anda di {cityData.name}.</p>

    <div class="directory-grid">
      {activeServices.map((service, index) => {
        const url = service.cityUrlPattern.replace('{city}', cityData.slug);
        
        // Cek apakah gambar SEO khusus kota (misal: jasa-bore-pile-jakarta.webp) sudah ada.
        // Jika belum, gunakan gambar default dari services.ts sebagai fallback.
        const localImageName = `jasa-${service.slug}-${cityData.slug}.webp`;
        const localImagePath = path.join(process.cwd(), 'public', 'imgs', localImageName);
        const finalImage = fs.existsSync(localImagePath) ? `/imgs/${localImageName}` : service.image;

        return (
          <ServiceCard 
            title={service.name}
            description={service.description}
            image={finalImage}
            imageAlt={`${service.imageAlt} di ${cityData.name}`}
            url={url} 
            isLcp={index === 0} 
          />
        );
      })}
    </div>
  </section>

  <!-- OTHER CITIES LINKS -->
  <div slot="below-cta" style="margin-bottom: var(--space-8);">
    <h2 style="text-align: center; margin-top: var(--space-12); margin-bottom: var(--space-6); font-size: 1.75rem;">Area Layanan Kami Lainnya</h2>
    <AreaGrid hideTitle={true} noPaddingTop={true} />
  </div>

</LocalSEOLayout>

<style>
  .hub-intro {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto var(--space-8) auto;
  }

  .services-directory {
    margin-bottom: var(--space-12);
  }

  .directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 900px;
    margin: 0 auto;
  }
  
  @media (min-width: 768px) {
    .directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .other-cities {
    text-align: center;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
    margin-bottom: var(--space-12);
  }

  .other-label {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-4);
  }

  .city-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .city-chip {
    padding: 6px 14px;
    background: #f8f9fa;
    border: 1px solid var(--color-border-light);
    border-radius: 20px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .city-chip:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .chip-all {
    background: white;
    border: 1px dashed var(--color-primary);
    color: var(--color-primary);
  }
  .chip-all:hover {
    background: rgba(139, 0, 0, 0.05);
    color: var(--color-primary);
    border-style: solid;
  }
</style>


