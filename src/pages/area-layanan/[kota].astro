---
import LocalSEOLayout from '../../components/layout/LocalSEOLayout.astro';
import ProcessSteps from '../../components/ui/ProcessSteps.astro';
import MiniGallery from '../../components/ui/MiniGallery.astro';
import { SERVICE_CITIES } from '../../data/seo-data';

export async function getStaticPaths() {
  const activeCities = SERVICE_CITIES.filter(c => !c.draft);
  return activeCities.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const activeCities = SERVICE_CITIES.filter(c => !c.draft);
const otherCities = activeCities.filter(c => c.slug !== cityData.slug).slice(0, 6);
---

<LocalSEOLayout 
  title={`Layanan ASeven Pile di Wilayah ${cityData.name}`} 
  description={`Pusat informasi dan pemesanan seluruh layanan ASeven Pile untuk area ${cityData.name} dan sekitarnya. Temukan solusi pondasi, pengeboran, dan konstruksi terbaik untuk proyek Anda.`}
  city={cityData.name}
  serviceName="Semua Layanan"
  pathContext="general"
>

  <!-- HUB INTRODUCTION -->
  <div class="hub-intro">
    <p class="lead-text">
      Selamat datang di pusat layanan <strong>ASeven Pile cabang {cityData.name}</strong>. Kami berkomitmen mendukung pembangunan infrastruktur, komersial, dan residensial di {cityData.name} dengan menyediakan berbagai layanan konstruksi spesialis yang dikerjakan langsung oleh tenaga ahli berpengalaman.
    </p>
  </div>

  <!-- SERVICE DIRECTORY -->
  <section class="services-directory">
    <div class="section-header">
      <h2>Direktori Layanan di {cityData.name}</h2>
      <p>Pilih kategori layanan yang Anda butuhkan untuk melihat detail harga, metode, dan portofolio proyek kami di {cityData.name}.</p>
    </div>

    <div class="directory-grid">
      
      <!-- SERVICE 1: BORE PILE -->
      <a href={`/area-layanan/bore-pile/${cityData.slug}`} class="dir-card primary-service">
        <div class="card-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <div class="card-content">
          <span class="badge">Layanan Utama</span>
          <h3>Bore Pile Mesin</h3>
          <p>Pengeboran pondasi dalam menggunakan mesin mini crane. Solusi tahan gempa berkapasitas besar untuk gedung, pabrik, & ruko di {cityData.name}.</p>
          <span class="action-link">Lihat Harga & Detail &rarr;</span>
        </div>
      </a>

      <!-- SERVICE 2: STRAUSS PILE -->
      <a href={`/area-layanan/strauss-pile/${cityData.slug}`} class="dir-card alt-service">
        <div class="card-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 16 16 12 12 8"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        </div>
        <div class="card-content">
          <span class="badge badge-alt">Populer Perumahan</span>
          <h3>Strauss Pile Manual</h3>
          <p>Pengeboran manual tanpa suara dan getaran. Sangat ekonomis dan ideal untuk pembangunan rumah tinggal di kawasan padat penduduk {cityData.name}.</p>
          <span class="action-link">Lihat Harga & Detail &rarr;</span>
        </div>
      </a>

      <!-- SERVICE 3: SOIL TEST (COMING SOON) -->
      <div class="dir-card disabled">
        <div class="card-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
        </div>
        <div class="card-content">
          <span class="badge badge-gray">Segera Hadir</span>
          <h3>Uji Sondir (Soil Test)</h3>
          <p>Layanan pengujian daya dukung tanah untuk menentukan kedalaman pondasi yang aman sebelum memulai konstruksi bangunan di {cityData.name}.</p>
          <span class="action-link text-muted">Belum Tersedia</span>
        </div>
      </div>
      
      <!-- SERVICE 4: RENTAL ALAT (COMING SOON) -->
      <div class="dir-card disabled">
        <div class="card-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/></svg>
        </div>
        <div class="card-content">
          <span class="badge badge-gray">Segera Hadir</span>
          <h3>Sewa Rig & Alat Berat</h3>
          <p>Penyewaan harian/bulanan mesin bore pile mini crane, gawangan, dan peralatan pendukung konstruksi lainnya untuk area {cityData.name}.</p>
          <span class="action-link text-muted">Belum Tersedia</span>
        </div>
      </div>

    </div>
  </section>

  <!-- LOCAL VALUE PROPOSITION -->
  <section class="local-advantages">
    <div class="advantage-image">
      <img src="/imgs/header-beranda-bore-pile-aseven.webp" alt={`Layanan Konstruksi ASeven Pile di ${cityData.name}`} loading="lazy" />
      <div class="overlay-stats">
        <div class="stat-box">
          <span class="num">100+</span>
          <span class="label">Proyek Selesai</span>
        </div>
      </div>
    </div>
    
    <div class="advantage-content">
      <h2>Mengapa Percayakan Proyek {cityData.name} Anda Kepada Kami?</h2>
      <ul class="benefit-list">
        <li>
          <div class="icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div>
            <h4>Armada Milik Sendiri (Bukan Broker)</h4>
            <p>Kami memiliki garasi dan armada rig mini crane sendiri. Penjadwalan mobilisasi alat ke {cityData.name} jauh lebih cepat dan pasti tanpa oper tangan pihak ketiga.</p>
          </div>
        </li>
        <li>
          <div class="icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div>
            <h4>Paham Karakteristik Lahan {cityData.name}</h4>
            <p>Pengalaman panjang mengerjakan proyek di berbagai sudut {cityData.name} membuat tim kami paham strategi menghadapi kontur tanah lempung, berpasir, maupun padas.</p>
          </div>
        </li>
        <li>
          <div class="icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div>
            <h4>Material Standar SNI</h4>
            <p>Semua spesifikasi besi tulangan dan campuran beton yang digunakan mengikuti pedoman SNI untuk memastikan durabilitas struktur bangunan bertingkat Anda.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- OTHER CITIES LINKS -->
  <section class="other-cities">
    <h3>Proyek Anda di Luar Wilayah {cityData.name}?</h3>
    <p>Tenang, armada kami menjangkau seluruh area Jabodetabek dan kota-kota besar di sekitarnya. Temukan cabang layanan kami di kota Anda:</p>
    <div class="city-chips">
      {otherCities.map((city) => (
        <a href={`/area-layanan/${city.slug}`} class="city-chip">
          {city.name}
        </a>
      ))}
      <a href="/area-layanan" class="city-chip chip-all">
        Lihat Semua Kota &rarr;
      </a>
    </div>
  </section>

  <Fragment slot="bottom-content">
    <ProcessSteps 
      title={`SOP Layanan Kami di ${cityData.name}`} 
      subtitle={`Cara mudah menjadwalkan survei dan pengerjaan konstruksi untuk area ${cityData.name} sekitarnya.`}
      steps={[
        { number: 1, title: `Konsultasi Proyek ${cityData.name}`, desc: `Diskusikan kondisi lahan dan spesifikasi struktur bangunan Anda di ${cityData.name} dengan tim ahli kami.` },
        { number: 2, title: `Cek Akses Lahan`, desc: `Tim survei akan memastikan akses jalan masuk ke lokasi memadai untuk manuver peralatan kerja.` },
        { number: 3, title: "RAB & SPK Transparan", desc: "Perhitungan RAB dibuat detail dan transparan tanpa biaya tersembunyi, dilanjutkan penandatanganan SPK resmi." },
        { number: 4, title: "Eksekusi Profesional", desc: `Pengerjaan di ${cityData.name} dilakukan sesuai jadwal yang disepakati dengan laporan progres lapangan harian kepada Anda.` }
      ]}
    />
    <MiniGallery 
      title={`Galeri Proyek di Wilayah ${cityData.name}`} 
      subtitle={`Kumpulan foto asli hasil eksekusi lapangan dari tim konstruksi ASeven Pile.`}
      images={[
        { src: "/imgs/header-beranda-bore-pile-aseven-2.webp", alt: `Rig Mini Crane Beroperasi di ${cityData.name}`, fallback: `Alat+Berat+${cityData.name}` },
        { src: "/imgs/wa-gallery-1.webp", alt: `Tim ASeven Pile Bekerja di ${cityData.name}`, fallback: `Pekerja+${cityData.name}` },
        { src: "/imgs/header-beranda-bore-pile-aseven.webp", alt: `Hasil Pengerjaan Kokoh di ${cityData.name}`, fallback: `Struktur+Kokoh+${cityData.name}` }
      ]}
    />
  </Fragment>
</LocalSEOLayout>

<style>
  /* HUB INTRO */
  .hub-intro {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  .lead-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-text);
    max-width: 760px;
    margin: 0 auto;
  }

  /* DIRECTORY GRID */
  .services-directory {
    margin-bottom: var(--space-16);
  }
  .section-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .section-header h2 {
    font-size: 2rem;
    margin-bottom: var(--space-3);
    color: var(--color-primary);
  }
  .section-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }
  .directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* DIR CARDS */
  .dir-card {
    display: flex;
    align-items: flex-start;
    padding: var(--space-6);
    background: #ffffff;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    position: relative;
    overflow: hidden;
  }
  .dir-card:hover:not(.disabled) {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    border-color: var(--color-primary);
  }
  .dir-card.disabled {
    background: #f8f9fa;
    opacity: 0.8;
    cursor: not-allowed;
  }
  
  .card-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    margin-right: var(--space-5);
  }
  .primary-service .card-icon {
    background: rgba(139,0,0,0.1);
    color: var(--color-primary);
  }
  .alt-service .card-icon {
    background: #f0fdf4;
    color: #166534;
  }
  .disabled .card-icon {
    background: #e2e8f0;
    color: #64748b;
  }

  .card-content {
    flex-grow: 1;
  }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 20px;
    margin-bottom: var(--space-3);
  }
  .primary-service .badge {
    background: var(--color-primary);
    color: white;
  }
  .badge-alt {
    background: #166534;
    color: white;
  }
  .badge-gray {
    background: #64748b;
    color: white;
  }
  
  .card-content h3 {
    margin: 0 0 8px 0;
    font-size: 1.35rem;
    color: var(--color-text);
  }
  .card-content p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 16px 0;
  }
  .action-link {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .primary-service .action-link { color: var(--color-primary); }
  .alt-service .action-link { color: #166534; }
  .text-muted { color: #94a3b8 !important; }

  /* LOCAL ADVANTAGES */
  .local-advantages {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    background: var(--color-bg-alt);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: var(--space-16);
    border: 1px solid var(--color-border-light);
  }
  @media (min-width: 768px) {
    .local-advantages {
      grid-template-columns: 1fr 1fr;
    }
  }
  .advantage-image {
    position: relative;
    min-height: 300px;
  }
  .advantage-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .overlay-stats {
    position: absolute;
    bottom: var(--space-6);
    left: var(--space-6);
    background: white;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
  }
  .stat-box {
    display: flex;
    flex-direction: column;
  }
  .stat-box .num {
    font-size: 2rem;
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1;
  }
  .stat-box .label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-top: 4px;
  }
  
  .advantage-content {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .advantage-content h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-6);
    line-height: 1.3;
  }
  .benefit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .benefit-list li {
    display: flex;
    align-items: flex-start;
  }
  .icon-wrap {
    color: var(--color-primary);
    background: rgba(139,0,0,0.1);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    margin-right: var(--space-4);
    flex-shrink: 0;
  }
  .benefit-list h4 {
    margin: 0 0 4px 0;
    font-size: 1.1rem;
    color: var(--color-text);
  }
  .benefit-list p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* OTHER CITIES */
  .other-cities {
    text-align: center;
    padding: var(--space-8);
    border: 1px dashed var(--color-border-light);
    border-radius: var(--radius-lg);
    background: #ffffff;
    margin-bottom: var(--space-12);
  }
  .other-cities h3 {
    margin-bottom: var(--space-3);
  }
  .other-cities p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .city-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .city-chip {
    padding: 8px 16px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    border-radius: 20px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .city-chip:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }
  .chip-all {
    background: transparent;
    border-style: dashed;
    color: var(--color-primary);
  }
  .chip-all:hover {
    background: rgba(139,0,0,0.05);
    color: var(--color-primary);
  }
</style>