---
import LocalSEOLayout from '../../components/layout/LocalSEOLayout.astro';
import ProcessSteps from '../../components/ui/ProcessSteps.astro';
import MiniGallery from '../../components/ui/MiniGallery.astro';
import { SERVICE_CITIES } from '../../data/seo-data';

export async function getStaticPaths() {
  const activeCities = SERVICE_CITIES.filter(c => !c.draft);
  return activeCities.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const activeCities = SERVICE_CITIES.filter(c => !c.draft);
const otherCities = activeCities.filter(c => c.slug !== cityData.slug).slice(0, 6);
---

<LocalSEOLayout 
  title={`Layanan ASeven Pile di ${cityData.name}`} 
  description={`Jasa pengeboran pondasi (Bore Pile & Strauss Pile) profesional untuk area ${cityData.name}. Pengerjaan cepat, rapi, dan harga transparan.`}
  city={cityData.name}
  serviceName="Bore Pile & Strauss Pile"
  pathContext="general"
>

  <!-- HUB INTRODUCTION -->
  <div class="hub-intro">
    <p class="lead-text">
      Sedang merencanakan pembangunan di <strong>{cityData.name}</strong>? ASeven Pile siap membantu mengerjakan pondasi bangunan Anda. Kami melayani jasa pengeboran pondasi untuk berbagai kebutuhan, mulai dari rumah tinggal, ruko, hingga gedung.
    </p>
  </div>

  <!-- SERVICE DIRECTORY -->
  <section class="services-directory">
    <div class="section-header">
      <h2>Pilihan Layanan</h2>
      <p>Pilih metode yang paling sesuai dengan kebutuhan bangunan dan lokasi proyek Anda di {cityData.name}.</p>
    </div>

    <div class="directory-grid">
      
      <!-- SERVICE 1: BORE PILE -->
      <a href={`/area-layanan/bore-pile/${cityData.slug}`} class="dir-card">
        <div class="card-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <div class="card-content">
          <h3>Bore Pile Mesin</h3>
          <p>Pengeboran menggunakan alat mesin (mini crane). Sangat cocok untuk bangunan skala menengah ke atas yang membutuhkan pondasi kokoh dan dalam.</p>
          <span class="action-link">Lihat Harga & Detail &rarr;</span>
        </div>
      </a>

      <!-- SERVICE 2: STRAUSS PILE -->
      <a href={`/area-layanan/strauss-pile/${cityData.slug}`} class="dir-card">
        <div class="card-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 16 16 12 12 8"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        </div>
        <div class="card-content">
          <h3>Strauss Pile Manual</h3>
          <p>Pengeboran dengan tenaga manusia. Tanpa getaran dan suara bising, sehingga sangat aman untuk perumahan atau proyek di area padat penduduk.</p>
          <span class="action-link">Lihat Harga & Detail &rarr;</span>
        </div>
      </a>

    </div>
  </section>

  <!-- LOCAL VALUE PROPOSITION -->
  <section class="local-advantages">
    <div class="advantage-image">
      <img src="/imgs/header-beranda-bore-pile-aseven.webp" alt={`Pekerjaan Pondasi di ${cityData.name}`} loading="lazy" />
    </div>
    
    <div class="advantage-content">
      <h2>Mengapa Memilih Kami?</h2>
      <ul class="benefit-list">
        <li>
          <div class="icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div>
            <h4>Peralatan Milik Sendiri</h4>
            <p>Alat bor dan peralatan pendukung adalah milik ASeven Pile sendiri, bukan sewaan pihak ketiga. Proses pengiriman alat ke {cityData.name} jadi lebih cepat dan pasti.</p>
          </div>
        </li>
        <li>
          <div class="icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div>
            <h4>Tim Berpengalaman</h4>
            <p>Tenaga kerja kami sudah terbiasa menangani berbagai kondisi tanah, sehingga bisa mengantisipasi kendala lapangan dan menyelesaikan pekerjaan dengan rapi.</p>
          </div>
        </li>
        <li>
          <div class="icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div>
            <h4>Harga Transparan</h4>
            <p>Kami memberikan rincian perhitungan biaya yang jelas di awal. Anda bisa mengecek estimasi biayanya langsung di website kami tanpa biaya tersembunyi.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- OTHER CITIES LINKS -->
  <section class="other-cities">
    <h3>Cari Area Layanan Lain?</h3>
    <p>Selain {cityData.name}, kami juga melayani pekerjaan pondasi di kota-kota berikut:</p>
    <div class="city-chips">
      {otherCities.map((city) => (
        <a href={`/area-layanan/${city.slug}`} class="city-chip">
          {city.name}
        </a>
      ))}
      <a href="/area-layanan" class="city-chip chip-all">
        Lihat Semua Kota &rarr;
      </a>
    </div>
  </section>

  <Fragment slot="bottom-content">
    <ProcessSteps 
      title={`Proses Kerja Kami`} 
      subtitle={`Langkah mudah untuk mulai bekerja sama dengan ASeven Pile di ${cityData.name}.`}
      steps={[
        { number: 1, title: `Konsultasi & Tanya Jawab`, desc: `Hubungi kami via WhatsApp. Ceritakan jenis bangunan dan rencana pondasi yang ingin Anda buat di ${cityData.name}.` },
        { number: 2, title: `Pengecekan Akses`, desc: `Kami akan mensurvei atau meminta foto jalan masuk lokasi proyek untuk memastikan alat berat bisa masuk dengan aman.` },
        { number: 3, title: "Kesepakatan Biaya", desc: "Kami memberikan penawaran harga. Jika setuju, alat dan pekerja kami akan segera diberangkatkan ke lokasi." },
        { number: 4, title: "Pengerjaan Pondasi", desc: `Proses pengeboran dan pengecoran dilakukan sesuai target dengan laporan pekerjaan harian.` }
      ]}
    />
    <MiniGallery 
      title={`Galeri Pekerjaan Kami di ${cityData.name}`} 
      subtitle={`Beberapa foto hasil pekerjaan pondasi yang dilakukan oleh tim lapangan ASeven Pile.`}
      images={[
        { src: "/imgs/header-beranda-bore-pile-aseven-2.webp", alt: `Rig Mesin Bore Pile Bekerja di ${cityData.name}`, fallback: `Pengerjaan+Pondasi+${cityData.name}` },
        { src: "/imgs/wa-gallery-1.webp", alt: `Tim Sedang Memasang Pipa di ${cityData.name}`, fallback: `Pekerja+${cityData.name}` },
        { src: "/imgs/header-beranda-bore-pile-aseven.webp", alt: `Besi Pondasi yang Telah Terpasang di ${cityData.name}`, fallback: `Besi+Pondasi+${cityData.name}` }
      ]}
    />
  </Fragment>
</LocalSEOLayout>

<style>
  /* HUB INTRO */
  .hub-intro {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  .lead-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-text);
    max-width: 760px;
    margin: 0 auto;
  }

  /* DIRECTORY GRID */
  .services-directory {
    margin-bottom: var(--space-16);
  }
  .section-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .section-header h2 {
    font-size: 2rem;
    margin-bottom: var(--space-3);
    color: var(--color-text);
  }
  .section-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }
  .directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 900px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* DIR CARDS */
  .dir-card {
    display: flex;
    align-items: flex-start;
    padding: var(--space-6);
    background: #ffffff;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .dir-card:hover {
    border-color: var(--color-primary);
  }
  
  .card-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    margin-right: var(--space-5);
    background: rgba(139,0,0,0.05);
    color: var(--color-primary);
  }

  .card-content {
    flex-grow: 1;
  }
  
  .card-content h3 {
    margin: 0 0 8px 0;
    font-size: 1.25rem;
    color: var(--color-text);
  }
  .card-content p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 16px 0;
  }
  .action-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  /* LOCAL ADVANTAGES */
  .local-advantages {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    background: #f8f9fa;
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: var(--space-16);
    border: 1px solid var(--color-border-light);
  }
  @media (min-width: 768px) {
    .local-advantages {
      grid-template-columns: 1fr 1fr;
    }
  }
  .advantage-image {
    position: relative;
    min-height: 300px;
  }
  .advantage-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .advantage-content {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .advantage-content h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-6);
    line-height: 1.3;
  }
  .benefit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .benefit-list li {
    display: flex;
    align-items: flex-start;
  }
  .icon-wrap {
    color: var(--color-primary);
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: var(--space-4);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .benefit-list h4 {
    margin: 0 0 4px 0;
    font-size: 1.1rem;
    color: var(--color-text);
  }
  .benefit-list p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* OTHER CITIES */
  .other-cities {
    text-align: center;
    padding: var(--space-8);
    border-top: 1px solid var(--color-border-light);
    margin-bottom: var(--space-12);
  }
  .other-cities h3 {
    margin-bottom: var(--space-3);
  }
  .other-cities p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .city-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .city-chip {
    padding: 8px 16px;
    background: #f8f9fa;
    border: 1px solid var(--color-border-light);
    border-radius: 20px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .city-chip:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }
  .chip-all {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .chip-all:hover {
    background: var(--color-primary);
    color: white;
  }
</style>