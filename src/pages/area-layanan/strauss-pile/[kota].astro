---
import LocalSEOLayout from '../../../components/layout/LocalSEOLayout.astro';
import CalculatorUI from '../../../components/interactive/CalculatorUI';
import PricingTable from '../../../components/ui/PricingTable.astro';
import ProcessSteps from '../../../components/ui/ProcessSteps.astro';
import MiniGallery from '../../../components/ui/MiniGallery.astro';
import '../../../styles/calculator.css';
import { SERVICE_CITIES, GLOBAL_FAQS } from '../../../data/seo-data';
import { siteConfig } from '../../../data/site.config';

export async function getStaticPaths() {
  return SERVICE_CITIES.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const combinedFaqs = [...GLOBAL_FAQS, ...cityData.localFaqs];
const otherCities = SERVICE_CITIES.filter(c => c.slug !== cityData.slug).slice(0, 6);

const getCalculatorLocation = (slug: string, province: string) => {
  const jabodetabek = ['jakarta', 'jakarta-selatan', 'jakarta-timur', 'jakarta-barat', 'jakarta-pusat', 'jakarta-utara', 'bogor', 'depok', 'tangerang', 'tangerang-selatan', 'bekasi'];
  if (jabodetabek.includes(slug)) return 'jabodetabek';
  if (province.toLowerCase().includes('banten')) return 'banten';
  if (slug.includes('bandung')) return 'bandung';
  if (province.toLowerCase().includes('jawa tengah') || province.toLowerCase().includes('yogyakarta')) return 'jawatengah';
  if (province.toLowerCase().includes('jawa timur')) return 'jawatimur';
  return 'other';
};
const calcLoc = getCalculatorLocation(cityData.slug, cityData.province);
---

<LocalSEOLayout 
  title={`Jasa Strauss Pile ${cityData.name} Paling Ekonomis`} 
  description={`Jasa strauss pile manual di ${cityData.name} 100% tanpa polusi suara. Paling cocok untuk proyek perumahan padat atau gang sempit. Cek harga per meternya di sini!`}
  city={cityData.name}
  serviceName="Strauss Pile"
  pathContext="strauss-pile"
  faqs={combinedFaqs}
>
  <span slot="header-badge" style="display:inline-block; padding: 4px 12px; background: rgba(22, 163, 74, 0.1); color: #16a34a; border-radius: 20px; font-weight:600; font-size: 0.875rem; margin-bottom: var(--space-4);">Strauss Pile Manual</span>

  <!-- 1. Intro E-E-A-T -->
  <section style="margin-bottom: var(--space-12);">
    <h2>Alternatif Pondasi Sunyi di {cityData.name}</h2>
    <p>Punya proyek bangunan 1-3 lantai di perumahan padat {cityData.name} dan tidak boleh berisik? <strong>Strauss Pile</strong> (bor manual tenaga manusia) adalah solusi paling tepat. Karena dikerjakan murni tanpa mesin diesel, metode ini 100% bebas polusi suara.</p>
    <p>Tim spesialis strauss pile dari <strong>{siteConfig.brand}</strong> siap meluncur ke area sesempit apapun di {cityData.name}. Sangat cocok untuk renovasi dalam rumah, pembuatan ruko kecil, maupun pondasi pagar.</p>
  </section>

  <!-- 2. Tabel Harga -->
  <PricingTable method="strauss" city={cityData.name} />

  <!-- 3. Kalkulator -->
  <div slot="calculator" style="margin-bottom: var(--space-12);">
    <div class="calculator-edge-to-edge">
      <CalculatorUI 
        client:load 
        title={`Kalkulator Estimasi Biaya Strauss Pile ${cityData.name}`}
        description="Gunakan kalkulator ini untuk menghitung total RAB pondasi strauss pile proyek Anda."
        defaults={{ method: 'strauss', location: calcLoc, depth: 4, points: 30 }} 
      />
    </div>
  </div>

  <!-- 4. Keunggulan Kami -->
  <section style="margin-bottom: var(--space-12); padding: var(--space-6); background: var(--color-bg-alt); border-radius: var(--radius-lg);">
    <h2 style="text-align: center; margin-bottom: var(--space-6);">Kenapa Memilih Kami di {cityData.name}?</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-4);">
      <div style="background: white; padding: var(--space-4); border-radius: var(--radius-md);">
        <h3 style="color: #16a34a; font-size: 1.125rem;">Bisa Masuk Gang Sempit</h3>
        <p style="font-size: 0.95rem;">Alat strauss pile kami sangat ringkas. Bisa dipanggul masuk gang kecil atau bahkan ke dalam rumah yang sedang direnovasi di {cityData.name}.</p>
      </div>
      <div style="background: white; padding: var(--space-4); border-radius: var(--radius-md);">
        <h3 style="color: #16a34a; font-size: 1.125rem;">Nol Polusi Suara</h3>
        <p style="font-size: 0.95rem;">Pengerjaan 100% sunyi. Dijamin tidak akan ada komplain dari tetangga sebelah proyek.</p>
      </div>
      <div style="background: white; padding: var(--space-4); border-radius: var(--radius-md);">
        <h3 style="color: #16a34a; font-size: 1.125rem;">Harga Sangat Ekonomis</h3>
        <p style="font-size: 0.95rem;">Tanpa bahan bakar mesin, harga jasa per meter strauss pile jauh lebih murah dibanding bore pile mesin.</p>
      </div>
    </div>
  </section>

  <!-- 5. Portofolio (Placeholder) -->
  <section style="margin-bottom: var(--space-12);">
    <h2>Proyek Strauss Pile Kami di {cityData.name}</h2>
    <p style="color: var(--color-text-muted);">Dokumentasi hasil pengeboran tanah secara manual oleh tim lapangan kami.</p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); margin-top: var(--space-4);">
      <!-- PLACEHOLDER IMAGES -->
      <div style="aspect-ratio: 4/3; background: #e2e8f0; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 0.875rem;">Foto Proyek 1</div>
      <div style="aspect-ratio: 4/3; background: #e2e8f0; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 0.875rem;">Foto Proyek 2</div>
      <div style="aspect-ratio: 4/3; background: #e2e8f0; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 0.875rem;">Foto Proyek 3</div>
    </div>
  </section>

  <!-- 6. FAQ (Schema otomatis ter-generate via layout) -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Pertanyaan Seputar Strauss Pile di {cityData.name}</h2>
    <div style="display: flex; flex-direction: column; gap: var(--space-4);">
      {combinedFaqs.map((faq) => (
        <details style="border: 1px solid var(--color-border-light); border-radius: var(--radius-md); padding: var(--space-4); background: white; cursor: pointer;">
          <summary style="font-weight: 600; color: var(--color-text); list-style: none; display: flex; justify-content: space-between; align-items: center;">
            {faq.question}
            <span style="color: #16a34a; font-size: 1.5rem; line-height: 1;">+</span>
          </summary>
          <p style="margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-border-light); color: var(--color-text-muted);">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- 7. Cross Link & Area -->
  <section style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); margin-bottom: var(--space-12);">
    <div style="background: white; border: 1px solid var(--color-border-light); padding: var(--space-6); border-radius: var(--radius-lg);">
      <h3 style="font-size: 1.125rem; margin-bottom: var(--space-2);">Butuh Bore Pile Mesin?</h3>
      <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: var(--space-4);">Jika kontur tanah di {cityData.name} terlalu keras atau Anda butuh diameter di atas 40cm, metode mesin (Bore Pile) adalah pilihannya.</p>
      <a href={`/area-layanan/bore-pile/${cityData.slug}`} style="color: var(--color-primary); font-weight: 600; text-decoration: none;">Cek Bore Pile Mesin {cityData.name} â†’</a>
    </div>
    
    <div style="background: white; border: 1px solid var(--color-border-light); padding: var(--space-6); border-radius: var(--radius-lg);">
      <h3 style="font-size: 1.125rem; margin-bottom: var(--space-2);">Strauss Pile Kota Lain</h3>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        {otherCities.map(c => (
          <a href={`/area-layanan/strauss-pile/${c.slug}`} style="font-size: 0.875rem; color: #475569; text-decoration: underline;">{c.name}</a>
        ))}
      </div>
    </div>
  </section>

    

  <Fragment slot="bottom-content">

    <section class="container" style="margin-top: var(--space-8);">
      <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); text-align: center; margin-bottom: var(--space-2); color: var(--color-primary);">Bore Pile Mesin vs Strauss Pile Manual</h2>
      <p style="text-align: center; color: var(--color-text-muted); margin-bottom: var(--space-8); max-width: 700px; margin-left: auto; margin-right: auto;">Bingung memilih metode pondasi yang tepat untuk proyek Anda di {cityData.name}? Berikut panduan perbandingannya.</p>
      
      <div style="overflow-x: auto; padding-bottom: var(--space-4);">
        <table style="width: 100%; min-width: 700px; border-collapse: collapse; text-align: left; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); border: 1px solid #e2e8f0;">
          <thead>
            <tr style="background: var(--color-primary); color: white;">
              <th style="padding: 16px; font-weight: 600; width: 20%;">Spesifikasi</th>
              <th style="padding: 16px; font-weight: 600; width: 40%; border-left: 1px solid rgba(255,255,255,0.2);">Bore Pile Mesin (Mini Crane)</th>
              <th style="padding: 16px; font-weight: 600; width: 40%; border-left: 1px solid rgba(255,255,255,0.2);">Strauss Pile (Manual)</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 16px; font-weight: 600; color: #334155; background: #f8fafc;">Kedalaman Maksimal</td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0; font-weight: 600;">Hingga 30 Meter <span style="font-weight:normal;">(Bisa tembus tanah keras)</span></td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0;">6 - 10 Meter <span style="font-weight:normal;">(Tergantung kepadatan tanah)</span></td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 16px; font-weight: 600; color: #334155; background: #f8fafc;">Diameter Lubang</td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0;">30cm, 40cm, 50cm, 60cm</td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0;">20cm, 25cm, 30cm, 40cm</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 16px; font-weight: 600; color: #334155; background: #f8fafc;">Peruntukan Proyek</td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0;">Gedung Bertingkat, Ruko 3+ Lantai, Pabrik, Gudang, Jembatan</td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0;">Rumah Tinggal 1-3 Lantai, Pagar Panel, Turap Penahan Tanah</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 16px; font-weight: 600; color: #334155; background: #f8fafc;">Akses Lokasi</td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0;">Minimal lebar jalan 2.5m (Bisa dilalui Truk)</td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0;">Bisa masuk gang sempit / area padat penduduk</td>
            </tr>
            <tr>
              <td style="padding: 16px; font-weight: 600; color: #334155; background: #f8fafc;">Tingkat Kebisingan</td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0;">Sedang <span style="font-weight:normal;">(Alat kami menggunakan peredam suara)</span></td>
              <td style="padding: 16px; color: #475569; border-left: 1px solid #e2e8f0; font-weight: 600;">Sangat Rendah <span style="font-weight:normal;">(Tanpa mesin, ramah lingkungan)</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>


    <!-- 8. Komponen Silo / Wilayah (Dinamis dari JSON) -->
  {cityData.groupedAreas && cityData.groupedAreas.length > 0 ? (
    <section class="container" style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border-light);">
      <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); text-align: center; margin-bottom: var(--space-2); color: var(--color-primary);">Wilayah Layanan {cityData.name}</h2>
      <p style="text-align: center; color: var(--color-text-muted); margin-bottom: var(--space-8); max-width: 600px; margin-left: auto; margin-right: auto;">Tim teknis kami siap memobilisasi alat pengeboran berstandar SNI ke seluruh kecamatan di {cityData.name} berikut ini (bebas biaya survei lokasi).</p>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6);">
        {cityData.groupedAreas.map((group: any) => (
          <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: var(--space-6); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); transition: transform 0.2s, box-shadow 0.2s;" class="hover:shadow-lg hover:-translate-y-1">
            <h3 style="font-size: 1.25rem; margin-bottom: var(--space-4); border-bottom: 2px solid #f1f5f9; padding-bottom: 12px;">
              <span style="color: var(--color-primary); font-weight: 700;">{group.groupName}</span>
            </h3>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              {group.areas.map((area: string) => (
                <span style="display: inline-block; padding: 6px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px; font-size: 0.8rem; color: #475569;">
                  {area}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  ) : (
    cityData.subAreas && cityData.subAreas.length > 0 && (
      <section class="container" style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border-light);">
        <h3 style="font-size: 1.2rem; margin-bottom: var(--space-2);">Area Layanan {cityData.name}</h3>
        <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: var(--space-4);">Pilih area spesifik di {cityData.name} untuk melihat info harga lebih akurat:</p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
          {cityData.subAreas.map((area: any) => (
            <span style="display: inline-block; padding: 4px 12px; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 16px; font-size: 0.85rem; color: #475569; font-weight: 500;">
              {area.name}
            </span>
          ))}
        </div>
      </section>
    )
  )}
  

    <ProcessSteps 
      title={`Standar Kerja Strauss Pile Manual di ${cityData.name}`} 
      subtitle={`Langkah-langkah profesional tim Aseven Pile dalam mengerjakan pondasi strauss pile di wilayah ${cityData.name}.`}
      steps={[
        { number: 1, title: `Cek Kontur Tanah ${cityData.name}`, desc: `Pengecekan area lahan di ${cityData.name} untuk memastikan kondisi tanah ideal untuk bor manual.` },
        { number: 2, title: "Pengeboran Manual", desc: "Pemutaran mata bor strauss pile oleh dua orang tenaga ahli tanpa bantuan alat berat mesin." },
        { number: 3, title: "Perakitan Besi", desc: `Perakitan besi tulangan spiral standar SNI langsung di lokasi proyek ${cityData.name}.` },
        { number: 4, title: "Pengecoran & Pemadatan", desc: "Penuangan beton segar secara bertahap sambil dipadatkan agar bebas dari keropos." }
      ]}
    />
    <MiniGallery 
      title={`Dokumentasi Strauss Pile di ${cityData.name}`} 
      subtitle={`Galeri pekerjaan lapangan strauss pile manual tanpa getaran oleh tenaga spesialis kami.`}
      images={[
        { src: "/imgs/wa-gallery-1.webp", alt: `Tim Strauss Pile Bekerja di ${cityData.name}`, fallback: `Bor+Manual+${cityData.name}` },
        { src: "/imgs/header-beranda-bore-pile-aseven.webp", alt: `Mata Bor Strauss Pile ${cityData.name}`, fallback: `Alat+Strauss+Pile+${cityData.name}` },
        { src: "/imgs/header-beranda-bore-pile-aseven-2.webp", alt: `Tulangan Spiral Strauss Pile ${cityData.name}`, fallback: `Besi+Strauss+Pile+${cityData.name}` }
      ]}
    />
  </Fragment>
</LocalSEOLayout>


