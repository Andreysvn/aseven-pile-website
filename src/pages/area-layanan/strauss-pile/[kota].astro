---
import LocalSEOLayout from '../../../components/layout/LocalSEOLayout.astro';
import ServiceIntro from '../../../components/ui/ServiceIntro.astro';
import CostExample from '../../../components/ui/CostExample.astro';
import CostAddons from '../../../components/ui/CostAddons.astro';
import SoilCharacter from '../../../components/ui/SoilCharacter.astro';
import ProjectGallery from '../../../components/ui/ProjectGallery.astro';
import ProcessSteps from '../../../components/ui/ProcessSteps.astro';
import PremiumCTA from '../../../components/ui/PremiumCTA.astro';
import CityCrossLinks from '../../../components/ui/CityCrossLinks.astro';
import LocationMap from '../../../components/ui/LocationMap.astro';
import ArticleList from '../../../components/ui/ArticleList.astro';
import ServiceFeatures from '../../../components/ui/ServiceFeatures.astro';
import ComparisonSection from '../../../components/ui/ComparisonSection.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';

import '../../../styles/calculator.css';
import { SERVICE_CITIES, getCityFaqs } from '../../../data/seo-data';
import { getProjects } from '../../../data/projects';
import { exampleForCity } from '../../../data/example';

export async function getStaticPaths() {
  return SERVICE_CITIES.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const cityFaqs = getCityFaqs(cityData, 'strauss');

const hargaStraussPile = 80000;
const projects = getProjects(cityData.slug, 'strauss');
const fallbackProjects = getProjects('jakarta', 'strauss');
const displayProjects = projects.length > 0 ? projects : fallbackProjects;

const rupiah = (n: number) => `Rp ${n.toLocaleString('id-ID')}`;

const ex = exampleForCity(cityData);
const projectTitle = ex.isReal
  ? `Rincian Biaya Asli Proyek Strauss Pile di ${cityData.name}`
  : `Contoh Perhitungan Biaya Strauss Pile di ${cityData.name}`;

const projectDesc = ex.isReal
  ? `Berikut rincian biaya jasa bor manual dari salah satu proyek pondasi yang kami kerjakan di ${cityData.name}.`
  : `Sebagai gambaran, berikut contoh perhitungan biaya jasa strauss pile di ${cityData.name} untuk ${ex.items[0].points} titik pondasi sedalam ${ex.items[0].depthM} meter diameter ${ex.items[0].diameterCm} cm:`;

const caseNote = ex.isReal
  ? `*Rincian dari proyek nyata. Harga jasa bor manual saja; belum termasuk material pengecoran.`
  : `*Contoh perhitungan (bukan proyek spesifik). Harga jasa bor manual saja; belum termasuk material pengecoran.`;
---

<LocalSEOLayout 
  title={`Jasa Strauss Pile ${cityData.name} Terbaik (Bor Manual) - Aseven Pile`}
  description={`Layanan jasa pondasi strauss pile manual di ${cityData.name} untuk rumah tinggal, pagar, dan bangunan ringan. Aman untuk gang sempit, tanpa getaran & kebisingan.`}
  canonicalUrl={`https://asevenpile.com/area-layanan/strauss-pile/${cityData.slug}`}
  city={cityData.name}
  serviceType="Strauss Pile"
>
  <!-- ================================================ -->
  <!-- SECTION 1: Header / Intro                        -->
  <!-- ================================================ -->
  <ServiceIntro service="strauss" cityName={cityData.name} hargaMulai={hargaStraussPile} />

  <!-- ================================================ -->
  <!-- SECTION 2: Karakteristik Tanah                   -->
  <!-- ================================================ -->
  <SoilCharacter city={cityData} />

  <!-- ================================================ -->
  <!-- SECTION 3: Galeri Proyek                         -->
  <!-- ================================================ -->
  <ProjectGallery 
    projects={displayProjects}
    city={cityData.name} 
    fallbackMessage={`Galeri dokumentasi pengerjaan Strauss Pile di wilayah ${cityData.name} dan sekitarnya.`}
  />

  <!-- ================================================ -->
  <!-- SECTION 4: CTA Konsultasi 1                      -->
  <!-- ================================================ -->
  <PremiumCTA 
    title={`Butuh Jasa Strauss Pile di ${cityData.name}?`}
    subtitle="Konsultasikan desain pondasi dan kondisi tanah lokasi proyek Anda langsung dengan tim lapangan kami."
    buttonText="Tanya via WhatsApp"
    waMessage={`Halo Aseven Pile, saya mau konsultasi jasa strauss pile untuk proyek di ${cityData.name}`}
  />

  <!-- ================================================ -->
  <!-- SECTION 5: Contoh Hitungan                       -->
  <!-- ================================================ -->
  <CostExample
    title={projectTitle}
    description={projectDesc}
    ex={ex}
    note={caseNote}
  />

  <CostAddons service="strauss" />

  <!-- ================================================ -->
  <!-- SECTION 6: Keunggulan                            -->
  <!-- ================================================ -->
  <ServiceFeatures
    title={`Keunggulan Strauss Pile Manual di ${cityData.name}`}
    features={[
      { title: "Tanpa Alat Berat", desc: `Dikerjakan dengan tenaga manusia memutar stang bor. Memungkinkan masuk ke gang sangat sempit atau di dalam bangunan existing di ${cityData.name} yang tidak bisa dilalui kendaraan.`, iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>` },
      { title: "Bebas Getaran & Bising", desc: "Tidak ada suara mesin menderu atau getaran alat berat, sehingga pengerjaan bisa dilakukan tanpa mengganggu tetangga sekitar sama sekali.", iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h3l3 -9l5 18l5 -18l3 9h3"></path></svg>` },
      { title: "Biaya Lebih Ekonomis", desc: "Karena tidak membutuhkan mobilisasi alat berat, biaya operasionalnya jauh lebih terjangkau, cocok untuk proyek skala menengah ke bawah.", iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>` }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 7: Strauss Pile vs Bore Pile Mesin       -->
  <!-- ================================================ -->
  <ComparisonSection
    title={`Strauss Pile Manual vs Bore Pile Mesin di ${cityData.name}`}
    description={`Pilih Strauss Pile atau Bore Pile? Berikut perbandingannya untuk membantu Anda menentukan metode terbaik di ${cityData.name}:`}
    primaryTitle="Strauss Pile Manual"
    primaryDesc={`Strauss pile dikerjakan murni dengan tenaga manusia yang memutar mata bor. Karena ukurannya ringkas, alat ini bisa masuk menembus gang sempit, pekarangan kecil, bahkan <strong>di dalam bangunan yang sudah jadi</strong>. Ini adalah pilihan paling tepat (dan seringkali satu-satunya) jika akses lokasi proyek Anda di ${cityData.name} benar-benar terbatas. Kelemahannya, karena manual, alat ini akan berhenti jika bertemu lapisan batu atau tanah keras (cadas), sehingga kedalamannya umumnya mentok di 6-8 meter dengan diameter maksimal 30cm.`}
    secondaryTitle="Bore Pile Mesin (Mini Crane)"
    secondaryDesc={`Bore pile menggunakan mesin diesel (mini crane) yang jauh lebih bertenaga. Metode ini sanggup menembus lapisan cadas/tanah keras hingga kedalaman 30 meter, dengan pilihan diameter besar (hingga 80cm). Sangat direkomendasikan untuk gedung bertingkat, ruko, atau struktur beban berat. Namun, mesin ini membutuhkan akses jalan minimal 1,5 sampai 2 meter untuk masuk ke lokasi.`}
    conclusion={`<strong>Kesimpulan:</strong> Jika Anda membangun ruko 3 lantai ke atas atau pabrik di <strong>${cityData.name}</strong>, pakailah Bore Pile Mesin demi daya dukung maksimal. Namun, jika Anda membangun rumah tinggal 2 lantai, menambah ruangan di belakang rumah, atau jalan masuknya hanya berupa gang sempit, <strong>Strauss Pile Manual</strong> adalah solusi yang paling hemat dan masuk akal.`}
  />

  <!-- ================================================ -->
  <!-- SECTION 8: SOP Pengerjaan                        -->
  <!-- ================================================ -->
  <ProcessSteps 
    title={`SOP Pengerjaan Strauss Pile di ${cityData.name}`} 
    subtitle="Tahapan kerja standar untuk memastikan pondasi manual yang kuat dan akurat."
    steps={[
      { number: 1, title: `Persiapan Titik & Alat`, desc: `Tim memastikan titik bor sesuai gambar kerja dan merakit alat strauss manual (stang dan mata bor) di lokasi proyek ${cityData.name}.` },
      { number: 2, title: "Pengeboran Manual", desc: "Tanah dibor dengan memutar stang secara manual oleh 2 pekerja hingga mencapai kedalaman tanah keras yang direncanakan (umumnya 6-8 meter)." },
      { number: 3, title: "Pemasangan Besi Tulangan", desc: "Memasukkan keranjang besi tulangan (spiral) ke dalam lubang yang telah dibersihkan." },
      { number: 4, title: "Pengecoran Beton", desc: "Proses penuangan beton segar secara hati-hati agar tidak tercampur longsoran tanah, sehingga terbentuk tiang beton utuh." }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 9: FAQ Lokal                             -->
  <!-- ================================================ -->
  <FAQSection 
    title={`Pertanyaan Seputar Strauss Pile di ${cityData.name}`} 
    subtitle="Hal-hal yang sering ditanyakan terkait jasa bor manual."
    faqs={cityFaqs} 
  />

  <!-- ================================================ -->
  <!-- SECTION 10: Artikel Terkait                      -->
  <!-- ================================================ -->
  <section class="ls-section">
    <h2 class="ls-art-heading">Artikel Terkait</h2>
    <ArticleList limit={1} />
  </section>

  <!-- ================================================ -->
  <!-- SECTION 11: CTA & Wilayah Layanan                -->
  <!-- ================================================ -->
  <PremiumCTA 
    title="Konsultasi & Survei Lapangan"
    subtitle={`Hubungi kami via WhatsApp untuk diskusi teknis dan jadwal survei lapangan di ${cityData.name}.`}
    buttonText="Konsultasi via WhatsApp"
    waMessage={`Halo Aseven Pile, saya mau konsultasi jasa strauss pile manual untuk daerah ${cityData.name}`}
  />
  
  <CityCrossLinks currentSlug={cityData.slug} serviceType="strauss-pile" serviceName="Strauss Pile Manual" />

  <Fragment slot="bottom-content">
    <LocationMap />

    {cityData.groupedAreas && cityData.groupedAreas.length > 0 ? (
      <section class="container ls-area-section">
        <h2 class="ls-area-title">Wilayah Layanan Strauss Pile {cityData.name}</h2>
        <p class="ls-center-desc ls-desc-600">Layanan bor manual kami menjangkau seluruh area di bawah ini. Tim kami siap datang ke lokasi Anda, termasuk untuk area yang sempit.</p>
        
        <div class="ls-area-grid">
          {cityData.groupedAreas.map((group) => (
            <div class="ls-area-card">
              <h3>
                <span>{group.groupName}</span>
              </h3>
              <div class="ls-area-chips">
                {group.areas.map((area) => (
                  <span class="ls-area-chip">
                    {area}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ) : (
      cityData.subAreas && cityData.subAreas.length > 0 && (
        <section class="container ls-area-section">
          <h3 class="ls-subarea-title">Area Layanan {cityData.name}</h3>
          <p class="ls-subarea-desc">Cakupan layanan jasa strauss pile kami di wilayah {cityData.name}:</p>
          <div class="ls-area-chips">
            {cityData.subAreas.map((area) => (
              <span class="ls-subarea-chip">
                {area.name}
              </span>
            ))}
          </div>
        </section>
      )
    )}
  </Fragment>
</LocalSEOLayout>
