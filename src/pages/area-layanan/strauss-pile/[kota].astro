---
import LocalSEOLayout from '../../../components/layout/LocalSEOLayout.astro';
import CalculatorUI from '../../../components/interactive/CalculatorUI.astro';
import PricingTable from '../../../components/ui/PricingTable.astro';
import CostAddons from '../../../components/ui/CostAddons.astro';
import SoilCharacter from '../../../components/ui/SoilCharacter.astro';
import ProjectGallery from '../../../components/ui/ProjectGallery.astro';
import ProcessSteps from '../../../components/ui/ProcessSteps.astro';
import MiniGallery from '../../../components/ui/MiniGallery.astro';
import PremiumCTA from '../../../components/ui/PremiumCTA.astro';
import CityCrossLinks from '../../../components/ui/CityCrossLinks.astro';

import '../../../styles/calculator.css';
import { SERVICE_CITIES, getCityFaqs } from '../../../data/seo-data';
import { getProjects } from '../../../data/projects';
import { siteConfig } from '../../../data/site.config';

export async function getStaticPaths() {
  return SERVICE_CITIES.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const cityFaqs = getCityFaqs(cityData, 'strauss');
const otherCities = SERVICE_CITIES.filter(c => c.slug !== cityData.slug).slice(0, 6);

const getCalculatorLocation = (slug: string, province: string) => {
  const jabodetabek = ['jakarta', 'jakarta-selatan', 'jakarta-timur', 'jakarta-barat', 'jakarta-pusat', 'jakarta-utara', 'bogor', 'depok', 'tangerang', 'tangerang-selatan', 'bekasi'];
  if (jabodetabek.includes(slug)) return 'jabodetabek';
  if (province.toLowerCase().includes('banten')) return 'banten';
  if (slug.includes('bandung')) return 'bandung';
  if (province.toLowerCase().includes('jawa tengah') || province.toLowerCase().includes('yogyakarta')) return 'jawatengah';
  if (province.toLowerCase().includes('jawa timur')) return 'jawatimur';
  return 'other';
};
const calcLoc = getCalculatorLocation(cityData.slug, cityData.province);
---

<LocalSEOLayout 
  title={`Jasa Strauss Pile ${cityData.name} Paling Ekonomis`} 
  description={`Jasa strauss pile manual di ${cityData.name} 100% tanpa polusi suara. Paling cocok untuk proyek perumahan padat atau gang sempit. Cek harga per meternya di sini!`}
  city={cityData.name}
  serviceName="Strauss Pile"
  pathContext="strauss-pile"
  faqs={cityFaqs}
>
  <span slot="header-badge" class="ls-sp-badge">Strauss Pile Manual</span>

  <!-- 1. Intro E-E-A-T -->
  <section class="ls-section">
    <h2>Alternatif Pondasi Sunyi di {cityData.name}</h2>
    <p>Punya proyek bangunan 1-3 lantai di perumahan padat {cityData.name} dan tidak boleh berisik? <strong>Strauss Pile</strong> (bor manual tenaga manusia) adalah solusi paling tepat. Karena dikerjakan murni tanpa mesin diesel, metode ini 100% bebas polusi suara.</p>
    <p>Tim spesialis strauss pile dari <strong>{siteConfig.brand}</strong> siap meluncur ke area sesempit apapun di {cityData.name}. Sangat cocok untuk renovasi dalam rumah, pembuatan ruko kecil, maupun pondasi pagar.</p>
  </section>

  <!-- 2. Tabel Harga -->
  <PricingTable method="strauss" city={cityData.name} />

  <!-- 3. Kalkulator -->
  <div slot="calculator" class="ls-section">
    <div class="calculator-edge-to-edge">
      <CalculatorUI 
        title={`Kalkulator Estimasi Biaya Strauss Pile ${cityData.name}`}
        description="Gunakan kalkulator ini untuk menghitung total RAB pondasi strauss pile proyek Anda."
        defaults={{ method: 'strauss', location: calcLoc, depth: 4, points: 30 }} 
      />
    </div>
  </div>

  <section class="ls-section">
    <CostAddons service="strauss" />
  </section>

  <!-- 4. Keunggulan Kami -->
  <section class="ls-sp-why-section">
    <h2 class="ls-sp-why-title">Kenapa Memilih Kami di {cityData.name}?</h2>
    <div class="ls-sp-why-grid">
      <div class="ls-sp-why-card">
        <h3>Bisa Masuk Gang Sempit</h3>
        <p>Alat strauss pile kami sangat ringkas. Bisa dipanggul masuk gang kecil atau bahkan ke dalam rumah yang sedang direnovasi di {cityData.name}.</p>
      </div>
      <div class="ls-sp-why-card">
        <h3>Nol Polusi Suara</h3>
        <p>Pengerjaan 100% sunyi. Dijamin tidak akan ada komplain dari tetangga sebelah proyek.</p>
      </div>
      <div class="ls-sp-why-card">
        <h3>Harga Sangat Ekonomis</h3>
        <p>Tanpa bahan bakar mesin, harga jasa per meter strauss pile jauh lebih murah dibanding bore pile mesin.</p>
      </div>
    </div>
  </section>

  <!-- Karakteristik tanah (unik per kota) -->
  <SoilCharacter city={cityData} />

  <!-- 5. Portofolio (Placeholder) -->
  <section class="ls-section">
    <h2>Proyek Strauss Pile Kami di {cityData.name}</h2>
    <p>Dokumentasi hasil pengeboran tanah secara manual oleh tim lapangan kami.</p>
    <div class="ls-sp-gal-grid">
      <!-- PLACEHOLDER IMAGES -->
      <div class="ls-sp-gal-ph">Foto Proyek 1</div>
      <div class="ls-sp-gal-ph">Foto Proyek 2</div>
      <div class="ls-sp-gal-ph">Foto Proyek 3</div>
    </div>
  </section>

  <!-- 6. FAQ (Schema otomatis ter-generate via layout) -->
  <section class="ls-section">
    <h2 class="ls-faq-title">Pertanyaan Seputar Strauss Pile di {cityData.name}</h2>
    <div class="ls-sp-faq-wrap">
      {cityFaqs.map((faq) => (
        <details class="ls-sp-faq-item">
          <summary>
            {faq.question}
            <span class="ls-sp-faq-plus">+</span>
          </summary>
          <p>
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>


    

  <Fragment slot="bottom-content">

    <section class="container ls-sec-mt">
      <h2 class="ls-area-title">Bore Pile Mesin vs Strauss Pile Manual</h2>
      <p class="ls-center-desc ls-desc-700">Bingung memilih metode pondasi yang tepat untuk proyek Anda di {cityData.name}? Berikut panduan perbandingannya.</p>
      
      <div class="ls-table-scroll">
        <table class="ls-compare-table">
          <thead>
            <tr>
              <th>Spesifikasi</th>
              <th class="ls-w40">Bore Pile Mesin (Mini Crane)</th>
              <th class="ls-w40">Strauss Pile (Manual)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="ls-tr-bordered">
              <td class="ls-lbl">Kedalaman Maksimal</td>
              <td class="ls-cell-strong">Hingga 30 Meter <span class="ls-normal">(Bisa tembus tanah keras)</span></td>
              <td class="ls-cell">6 - 10 Meter <span class="ls-normal">(Tergantung kepadatan tanah)</span></td>
            </tr>
            <tr class="ls-tr-bordered">
              <td class="ls-lbl">Diameter Lubang</td>
              <td class="ls-cell">30cm, 40cm, 50cm, 60cm</td>
              <td class="ls-cell">20cm, 25cm, 30cm, 40cm</td>
            </tr>
            <tr class="ls-tr-bordered">
              <td class="ls-lbl">Peruntukan Proyek</td>
              <td class="ls-cell">Gedung Bertingkat, Ruko 3+ Lantai, Pabrik, Gudang, Jembatan</td>
              <td class="ls-cell">Rumah Tinggal 1-3 Lantai, Pagar Panel, Turap Penahan Tanah</td>
            </tr>
            <tr class="ls-tr-bordered">
              <td class="ls-lbl">Akses Lokasi</td>
              <td class="ls-cell">Minimal lebar jalan 2.5m (Bisa dilalui Truk)</td>
              <td class="ls-cell">Bisa masuk gang sempit / area padat penduduk</td>
            </tr>
            <tr>
              <td class="ls-lbl">Tingkat Kebisingan</td>
              <td class="ls-cell">Sedang <span class="ls-normal">(Alat kami menggunakan peredam suara)</span></td>
              <td class="ls-cell-strong">Sangat Rendah <span class="ls-normal">(Tanpa mesin, ramah lingkungan)</span></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="ls-compare-cta">
        <a href={`/area-layanan/bore-pile/${cityData.slug}`}>Pelajari Layanan Bore Pile Mesin di {cityData.name} &rarr;</a>
      </p>
    </section>


    <!-- 8. Komponen Silo / Wilayah (Dinamis dari JSON) -->
  {cityData.groupedAreas && cityData.groupedAreas.length > 0 ? (
    <section class="container ls-area-section">
      <h2 class="ls-area-title">Wilayah Layanan {cityData.name}</h2>
      <p class="ls-center-desc ls-desc-600">Layanan kami mencakup seluruh area di bawah ini. Tim dan peralatan operasional kami siap didatangkan ke lokasi Anda.</p>
      
      <div class="ls-area-grid">
        {cityData.groupedAreas.map((group: any) => (
          <div class="ls-area-card">
            <h3>
              <span>{group.groupName}</span>
            </h3>
            <div class="ls-area-chips">
              {group.areas.map((area: string) => (
                <span class="ls-area-chip">
                  {area}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  ) : (
    cityData.subAreas && cityData.subAreas.length > 0 && (
      <section class="container ls-area-section">
        <h3 class="ls-subarea-title">Area Layanan {cityData.name}</h3>
        <p class="ls-subarea-desc">Pilih area spesifik di {cityData.name} untuk melihat info harga lebih akurat:</p>
        <div class="ls-area-chips">
          {cityData.subAreas.map((area: any) => (
            <span class="ls-subarea-chip">
              {area.name}
            </span>
          ))}
        </div>
      </section>
    )
  )}
  

    <ProcessSteps 
      title={`Standar Kerja Strauss Pile Manual di ${cityData.name}`} 
      subtitle={`Langkah-langkah profesional tim Aseven Pile dalam mengerjakan pondasi strauss pile di wilayah ${cityData.name}.`}
      steps={[
        { number: 1, title: `Cek Kontur Tanah ${cityData.name}`, desc: `Pengecekan area lahan di ${cityData.name} untuk memastikan kondisi tanah ideal untuk bor manual.` },
        { number: 2, title: "Pengeboran Manual", desc: "Pemutaran mata bor strauss pile oleh dua orang tenaga ahli tanpa bantuan alat berat mesin." },
        { number: 3, title: "Perakitan Besi", desc: `Perakitan besi tulangan spiral standar SNI langsung di lokasi proyek ${cityData.name}.` },
        { number: 4, title: "Pengecoran & Pemadatan", desc: "Penuangan beton segar secara bertahap sambil dipadatkan agar bebas dari keropos." }
      ]}
    />
    {getProjects(cityData.slug, 'strauss').length ? (
      <ProjectGallery city={cityData.name} projects={getProjects(cityData.slug, 'strauss')} />
    ) : (
      <MiniGallery 
      title={`Dokumentasi Strauss Pile di ${cityData.name}`} 
      subtitle={`Galeri pekerjaan lapangan strauss pile manual tanpa getaran oleh tenaga spesialis kami.`}
      images={[
        { src: "/imgs/wa-gallery-1.webp", alt: `Tim Strauss Pile Bekerja di ${cityData.name}`, fallback: `Bor+Manual+${cityData.name}` },
        { src: "/imgs/header-beranda-bore-pile-aseven.webp", alt: `Mata Bor Strauss Pile ${cityData.name}`, fallback: `Alat+Strauss+Pile+${cityData.name}` },
        { src: "/imgs/header-beranda-bore-pile-aseven-2.webp", alt: `Tulangan Spiral Strauss Pile ${cityData.name}`, fallback: `Besi+Strauss+Pile+${cityData.name}` }
      ]}
      />
    )}
    <PremiumCTA 
      title="Konsultasi & Survei Lapangan"
      subtitle={`Hubungi kami via WhatsApp untuk konsultasi proyek dan penjadwalan survei lokasi di ${cityData.name}.`}
      buttonText="Konsultasi via WhatsApp"
      waMessage={`Halo Aseven Pile, saya mau konsultasi jasa strauss pile untuk daerah ${cityData.name}`}
    />
      
      <div class="cll-center">
        <CityCrossLinks currentSlug={cityData.slug} serviceType="strauss-pile" serviceName="Strauss Pile Manual" />
      </div>
    </section>

  </Fragment>
</LocalSEOLayout>



