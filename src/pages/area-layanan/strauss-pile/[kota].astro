---
import LocalSEOLayout from '../../../components/layout/LocalSEOLayout.astro';
import ServiceArea from '../../../components/ui/ServiceArea.astro';
import ServiceIntro from '../../../components/ui/ServiceIntro.astro';
import CalculatorUI from '../../../components/interactive/CalculatorUI.astro';
import PricingTable from '../../../components/ui/PricingTable.astro';
import CostExample from '../../../components/ui/CostExample.astro';
import CostAddons from '../../../components/ui/CostAddons.astro';
import SoilCharacter from '../../../components/ui/SoilCharacter.astro';
import MachineSpec from '../../../components/ui/MachineSpec.astro';
import ArticleList from '../../../components/ui/ArticleList.astro';
import ProjectGallery from '../../../components/ui/ProjectGallery.astro';
import ComparisonSection from '../../../components/ui/ComparisonSection.astro';
import ServiceFeatures from '../../../components/ui/ServiceFeatures.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import ProcessSteps from '../../../components/ui/ProcessSteps.astro';
import MiniGallery from '../../../components/ui/MiniGallery.astro';
import LocationMap from '../../../components/ui/LocationMap.astro';
import PremiumCTA from '../../../components/ui/PremiumCTA.astro';
import CityCrossLinks from '../../../components/ui/CityCrossLinks.astro';

import '../../../styles/calculator.css';
import { SERVICE_CITIES, getCityFaqs } from '../../../data/seo-data';
import { getProjects } from '../../../data/projects';
import { exampleForCity } from '../../../data/example';
import { siteConfig } from '../../../data/site.config';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const allowedCities = ['jakarta', 'bekasi'];
  const straussCities = SERVICE_CITIES.filter(city => allowedCities.includes(city.slug));
  return straussCities.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}


const { cityData } = Astro.props;
const cityFaqs = getCityFaqs(cityData, 'strauss');
const otherCities = SERVICE_CITIES.filter(c => c.slug !== cityData.slug).slice(0, 6);

// Contoh perhitungan biaya strauss pile (PINTAR per kota):
const ex = exampleForCity(cityData, 'strauss');
const rupiah = (n) => `Rp ${n.toLocaleString('id-ID')}`;
const projectTitle = ex.isReal
  ? `Rincian Biaya Asli Proyek Strauss Pile di ${cityData.name}`
  : `Contoh Perhitungan Biaya Strauss Pile di ${cityData.name}`;
const projectDesc = ex.isReal
  ? `Berikut rincian biaya jasa dari salah satu proyek pondasi yang kami kerjakan di ${cityData.name}.`
  : `Sebagai gambaran, berikut contoh perhitungan biaya jasa strauss pile di ${cityData.name} untuk ${ex.items[0].points} titik pondasi sedalam ${ex.items[0].depthM} meter diameter ${ex.items[0].diameterCm} cm:`;
const caseNote = ex.isReal
  ? `*Rincian dari proyek nyata. Harga jasa bor saja; belum termasuk material, pengiriman alat, dan pembuangan tanah galian.`
  : `*Contoh perhitungan (bukan proyek spesifik). Harga jasa bor saja; belum termasuk material, pengiriman alat, dan pembuangan tanah galian.`;


const getCalculatorLocation = (slug, province) => {
  const jabodetabek = ['jakarta', 'jakarta-selatan', 'jakarta-timur', 'jakarta-barat', 'jakarta-pusat', 'jakarta-utara', 'bogor', 'depok', 'tangerang', 'tangerang-selatan', 'bekasi'];
  if (jabodetabek.includes(slug)) return 'jabodetabek';
  if (province.toLowerCase().includes('banten')) return 'banten';
  if (slug.includes('bandung')) return 'bandung';
  if (province.toLowerCase().includes('jawa tengah') || province.toLowerCase().includes('yogyakarta')) return 'jawatengah';
  if (province.toLowerCase().includes('jawa timur')) return 'jawatimur';
  return 'other';
};
const calcLoc = getCalculatorLocation(cityData.slug, cityData.province);
const hargaStraussPile = 70000;
const expectedHeroImagePath = '/imgs/header-jasa-strauss-pile-' + cityData.slug + '-aseven-pile.webp';
const hasHeroImage = fs.existsSync(path.join(process.cwd(), 'public', expectedHeroImagePath));
---

<LocalSEOLayout 
  title={`Harga Jasa Strauss Pile ${cityData.name} 2026`} 
  description={`Jasa strauss pile manual di ${cityData.name}. Harga mulai Rp 70.000/m (Diameter 20cm). Cocok untuk gang sempit dan perumahan padat. Survei & konsultasi gratis.`}
  city={cityData.name}
  serviceName="Strauss Pile"
  pathContext="strauss-pile"
  heroImage={hasHeroImage ? expectedHeroImagePath : undefined}
  faqs={cityFaqs}
>

  <!-- ================================================ -->
  <!-- SECTION 1: Header / Intro                        -->
  <!-- ================================================ -->
  <ServiceIntro service="strauss" cityName={cityData.name} hargaMulai={hargaStraussPile} foundingYear={siteConfig.foundingYear} crossLink={{ url: `/area-layanan/bore-pile/${cityData.slug}`, text: `jasa bore pile mesin ${cityData.name}` }} />

  <!-- ================================================ -->
  <!-- SECTION 2: Tabel Harga Strauss Pile              -->
  <!-- ================================================ -->
  <PricingTable method="strauss" city={cityData.name} />

  <!-- ================================================ -->
  <!-- SECTION 2b: Kalkulator Interaktif                -->
  <!-- ================================================ -->
  <section id="kalkulator" class="ls-section">
    <CalculatorUI 
      title={`Harga Jasa Strauss Pile ${cityData.name} 2026 | Aseven Pile`}
      description="Gunakan kalkulator ini untuk menghitung total RAB pondasi strauss pile proyek Anda."
      defaults={{ method: 'strauss', location: calcLoc, depth: 6, points: 15 }} 
    />
  </section>

  <!-- ================================================ -->
  <!-- SECTION 5: Contoh Hitungan -->
  <CostExample
    method="strauss"
    title={projectTitle}
    description={projectDesc}
    ex={ex}
    note={caseNote}
  />

  <CostAddons service="strauss" />

  <!-- ================================================ -->
  <!-- SECTION 6: Keunggulan -->
  <ServiceFeatures
    title={`Keunggulan jasa strauss pile Aseven Pile di ${cityData.name}`}
    features={[
      { title: "Tanpa Alat Berat", desc: `Strauss pile kami dikerjakan sepenuhnya dengan tenaga manusia dan alat bor ringkas. Tidak ada mesin berat yang perlu masuk ke lokasi. Cukup diangkut mobil pick-up, dan bisa dikerjakan di dalam ruangan atau gang sempit di wilayah ${cityData.name} yang lebarnya kurang dari 1,5 meter.`, iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>` },
      { title: "Tanpa Getaran & Tanpa Suara", desc: `Karena tidak menggunakan mesin, strauss pile tidak menimbulkan getaran maupun suara bising. Sangat aman untuk proyek renovasi di perumahan padat ${cityData.name}, atau pagar yang berbatasan langsung dengan tembok tetangga.`, iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2v2"></path><path d="M11 20v2"></path><path d="M4.22 4.22l1.42 1.42"></path><path d="M18.36 18.36l1.42 1.42"></path><path d="M2 11h2"></path><path d="M20 11h2"></path><path d="M4.22 17.78l1.42-1.42"></path><path d="M18.36 5.64l1.42-1.42"></path></svg>` },
      { title: "Berpengalaman", desc: `Tim kami sudah berpengalaman sejak 2015 dalam pekerjaan pondasi manual, khususnya strauss pile, dan terbiasa menangani berbagai kondisi tanah di ${cityData.name}, termasuk tanah berair dan akses yang sangat sempit.`, iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>` },
      { title: "Komitmen Kualitas", desc: "Layanan yang dihasilkan mengutamakan kualitas dan dikerjakan sesuai prosedur, spesifikasi yang disepakati, serta Standar Nasional Indonesia (SNI).", iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path><path d="M8 18h.01"></path><path d="M16 18h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M16 14h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M16 10h.01"></path></svg>` }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 7: Strauss Pile vs Bore Pile -->
  <ComparisonSection
    title={`Strauss Pile Manual vs Bore Pile Mesin di ${cityData.name}`}
    description={`Bingung antara pondasi bor manual (strauss pile) atau bore pile mesin? Berikut bedanya, disesuaikan dengan kondisi lapangan di ${cityData.name}:`}
    primaryTitle="Strauss Pile Manual"
    primaryDesc={`Strauss pile adalah metode pengeboran tanah secara manual (tenaga manusia) memutar mata bor. Karena alatnya ringkas, metode ini 100% bebas bising dan bebas getaran. Sangat cocok untuk proyek di gang sempit atau perumahan padat di ${cityData.name} yang tidak bisa dimasuki alat berat. Namun, karena manual, kedalamannya terbatas (rata-rata 6-8 meter) dan hanya bisa menembus tanah lunak hingga sedang.`}
    secondaryTitle="Bore Pile Mesin (Mini Crane)"
    secondaryDesc="Bore pile mesin menggunakan alat mini crane hidrolik. Metodenya sama-sama mengebor tanah, tetapi karena menggunakan mesin, kemampuannya jauh lebih besar. Bisa mengebor hingga kedalaman 30 meter dan menembus lapisan tanah keras atau berbatu. Cocok untuk bangunan beban berat seperti ruko 3 lantai ke atas atau pabrik. Kelemahannya, butuh ruang manuver alat dan suplai air yang cukup besar untuk sirkulasi."
    conclusion={`<strong>Kesimpulan:</strong> Jika proyek Anda di <strong>${cityData.name}</strong> adalah rumah 2 lantai atau pagar yang berlokasi di gang sempit dan tidak butuh kedalaman lebih dari 8 meter, Strauss Pile adalah pilihan paling efisien dan murah. Namun, jika butuh daya dukung besar untuk bangunan 3 lantai ke atas, atau kondisi tanah kerasnya sangat dalam, maka Bore Pile Mesin adalah solusinya.`}
  />

  <!-- ================================================ -->
  <!-- SECTION: Karakteristik Tanah & Mesin             -->
  <!-- ================================================ -->
  <SoilCharacter city={cityData} service="strauss" />
  <MachineSpec service="strauss" city={cityData} />

  <!-- ================================================ -->
  <!-- SECTION 8: Galeri / Portofolio Proyek            -->
  <!-- ================================================ -->
  {getProjects(cityData.slug, 'strauss').length ? (
    <ProjectGallery city={cityData.name} projects={getProjects(cityData.slug, 'strauss')} subtitle={`Beberapa proyek pondasi strauss pile manual yang kami kerjakan di wilayah ${cityData.name}.`} />
  ) : (
    <MiniGallery 
    title={`Dokumentasi Proyek Strauss Pile ${cityData.name}`} 
    subtitle="Bukti pengerjaan lapangan pondasi strauss pile manual yang dikerjakan langsung oleh tim spesialis kami."
    images={[
      { src: "/imgs/proses-strauss-pile-jakarta-aseven-pile.webp", alt: `Proses Pengerjaan Strauss Pile di ${cityData.name}`, fallback: `Pengeboran+${cityData.name}` },
      { src: "/imgs/proses-strauss-pile-2-jakarta-aseven-pile.webp", alt: `Pemasangan Besi Tulangan Strauss Pile ${cityData.name}`, fallback: `Besi+Tulangan` }
    ]}
    />
  )}

  <!-- ================================================ -->
  <!-- SECTION 9: SOP / Tahapan Pengerjaan              -->
  <!-- ================================================ -->
  <ProcessSteps 
    title={`SOP Pengerjaan Strauss Pile di ${cityData.name}`} 
    subtitle="Standar kerja sistematis Aseven Pile untuk menjamin mutu dan keamanan struktur pondasi."
    steps={[
      { number: 1, title: `Persiapan Alat & Titik`, desc: `Tim membawa alat bor manual ke lokasi di ${cityData.name}. Sangat ringkas, cukup diangkut mobil pick-up kecil dan bisa masuk gang sempit atau di dalam ruangan.` },
      { number: 2, title: "Pengeboran Manual", desc: "Pengeboran dilakukan dengan memutar pipa dan mata bor secara manual oleh 2-3 orang pekerja hingga mencapai kedalaman tanah keras (rata-rata 6-8 meter)." },
      { number: 3, title: "Pemasangan Besi Tulangan", desc: "Penurunan keranjang besi tulangan SNI ke dalam lubang bor yang sudah dibersihkan." },
      { number: 4, title: "Pengecoran Beton", desc: "Pengecoran beton dilakukan langsung ke dalam lubang bor. Karena lubang biasanya relatif dangkal dan kering (bebas lumpur), beton langsung dituang merata tanpa tercampur tanah." }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 10: FAQ Lokal                            -->
  <!-- ================================================ -->
  <FAQSection 
    title={`Pertanyaan Seputar Strauss Pile di ${cityData.name}`} 
    subtitle="Informasi lengkap biaya dan operasional."
    faqs={cityFaqs} 
  />

  <!-- ================================================ -->
  <!-- SECTION 11: Link Artikel / Blog                  -->
  <!-- ================================================ -->
  <section class="ls-section">
    <h2 class="ls-art-heading">Artikel Terkait</h2>
    <ArticleList limit={1} />
  </section>

  <!-- ================================================ -->
  <!-- SECTION 12: Konsultasi & Jadwal Survei           -->
  <!-- ================================================ -->
  <PremiumCTA 
    title="Konsultasi & Survei Lapangan"
    subtitle={`Hubungi kami via WhatsApp untuk konsultasi proyek dan penjadwalan survei lokasi di ${cityData.name}.`}
    buttonText="Konsultasi via WhatsApp"
    waMessage={`Halo Aseven Pile, saya mau konsultasi jasa strauss pile untuk daerah ${cityData.name}`}
  />
    
  <CityCrossLinks currentSlug={cityData.slug} serviceType="strauss-pile" serviceName="Strauss Pile" />

  <!-- ================================================ -->
  <!-- SECTION 13: Google Maps & Wilayah Kecamatan      -->
  <!-- ================================================ -->
  <Fragment slot="bottom-content">
    <LocationMap />
    <ServiceArea cityData={cityData} serviceName="Strauss Pile" />
  </Fragment>
</LocalSEOLayout>
