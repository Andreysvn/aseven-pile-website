---
import LocalSEOLayout from '../../../components/layout/LocalSEOLayout.astro';
import CalculatorUI from '../../../components/interactive/CalculatorUI.astro';
import PricingTable from '../../../components/ui/PricingTable.astro';
import CostAddons from '../../../components/ui/CostAddons.astro';
import SoilCharacter from '../../../components/ui/SoilCharacter.astro';
import ProjectGallery from '../../../components/ui/ProjectGallery.astro';
import ComparisonSection from '../../../components/ui/ComparisonSection.astro';
import ServiceFeatures from '../../../components/ui/ServiceFeatures.astro';
import ArticleList from '../../../components/ui/ArticleList.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import ProcessSteps from '../../../components/ui/ProcessSteps.astro';
import MiniGallery from '../../../components/ui/MiniGallery.astro';
import LocationMap from '../../../components/ui/LocationMap.astro';
import PremiumCTA from '../../../components/ui/PremiumCTA.astro';
import CityCrossLinks from '../../../components/ui/CityCrossLinks.astro';

import '../../../styles/calculator.css';
import { SERVICE_CITIES, getCityFaqs } from '../../../data/seo-data';
import { getProjects } from '../../../data/projects';
import { exampleForCity } from '../../../data/example';
import { siteConfig } from '../../../data/site.config';

export async function getStaticPaths() {
  return SERVICE_CITIES.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}


const { cityData } = Astro.props;
const cityFaqs = getCityFaqs(cityData, 'borepile');
const otherCities = SERVICE_CITIES.filter(c => c.slug !== cityData.slug).slice(0, 6);

// Contoh perhitungan biaya bore pile (PINTAR per kota):
// - Bila cities.json punya "caseStudy": { "isReal": true, "diameter":30, "depthM":12, "points":15 } â†’ tampil "Studi Kasus" (angka nyata).
// - Bila tidak â†’ contoh digenerate dari data kota (kedalaman dari averageDepth, jumlah titik divariasikan) â†’ angka beda tiap wilayah.
const ex = exampleForCity(cityData);
const rupiah = (n) => `Rp ${n.toLocaleString('id-ID')}`;
const projectTitle = ex.isReal
  ? `Rincian Biaya Asli Proyek Bore Pile di ${cityData.name}`
  : `Contoh Perhitungan Biaya Bore Pile di ${cityData.name}`;
  const projectDesc = ex.isReal
    ? `Berikut rincian biaya jasa dari salah satu proyek pondasi yang kami kerjakan di ${cityData.name}.`
    : `Sebagai gambaran, berikut contoh perhitungan biaya jasa bore pile di ${cityData.name} untuk ${ex.items[0].points} titik pondasi sedalam ${ex.items[0].depthM} meter diameter ${ex.items[0].diameterCm} cm:`;
const caseNote = ex.isReal
  ? `*Rincian dari proyek nyata. Harga jasa bor saja; belum termasuk material, mob/demob alat, dan bak sirkulasi air.`
  : `*Contoh perhitungan (bukan proyek spesifik). Harga jasa bor saja; belum termasuk material, pengiriman alat, dan penampungan air.`;


const getCalculatorLocation = (slug, province) => {
  const jabodetabek = ['jakarta', 'jakarta-selatan', 'jakarta-timur', 'jakarta-barat', 'jakarta-pusat', 'jakarta-utara', 'bogor', 'depok', 'tangerang', 'tangerang-selatan', 'bekasi'];
  if (jabodetabek.includes(slug)) return 'jabodetabek';
  if (province.toLowerCase().includes('banten')) return 'banten';
  if (slug.includes('bandung')) return 'bandung';
  if (province.toLowerCase().includes('jawa tengah') || province.toLowerCase().includes('yogyakarta')) return 'jawatengah';
  if (province.toLowerCase().includes('jawa timur')) return 'jawatimur';
  return 'other';
};
const calcLoc = getCalculatorLocation(cityData.slug, cityData.province);
---

<LocalSEOLayout 
  title={`Harga Jasa Bore Pile ${cityData.name} 2026 | Aseven Pile`} 
  description={`Jasa bore pile mesin di ${cityData.name}. Harga mulai Rp 120.000/m (O30cm). Alat mini crane milik sendiri, berpengalaman sejak ${siteConfig.foundingYear}. Survei & konsultasi gratis.`}
  city={cityData.name}
  serviceName="Bore Pile"
  pathContext="bore-pile"
  heroImage={cityData.slug === 'jakarta' ? '/imgs/header-jasa-bore-pile-jakarta-aseven-pile.webp' : undefined}
  faqs={cityFaqs}
>

  <!-- ================================================ -->
  <!-- SECTION 1: Hero + Trust Badges + Direct Answer   -->
  <!-- ================================================ -->
  

  <section class="ls-section">
    <div class="ls-summary-box">
      <div class="ls-summary-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
      </div>
      <p class="ls-summary-text"><strong>Ringkasan:</strong> Harga jasa bore pile mesin di {cityData.name} berkisar antara <strong>Rp 115.000 - Rp 350.000 / meter lari (m&sup1;)</strong>. Harga ini baru biaya jasa bor, belum termasuk material (besi dan beton), mob/demob alat, dan pembuatan bak sirkulasi air.</p>
    </div>
            <p class="ls-intro-p">Membangun rumah tinggal, ruko, gedung bertingkat, pabrik, sampai jembatan skala kecil di <strong>{cityData.name}</strong> membutuhkan pondasi yang tepat. Perbedaannya hanya skala dan daya dukung, tetapi tantangannya mirip: kondisi tanah tidak selalu sama antar lokasi. Di sinilah peran bore pile, yang mampu menyesuaikan kedalaman dan diameter sesuai kondisi tanah masing-masing proyek.</p>
    <p class="ls-intro-p-flat">Kami menyediakan jasa pengeboran <strong>bore pile mesin mini crane</strong> untuk kedalaman hingga 30 meter, diameter 30 sampai 80 cm, dan bisa masuk ke lokasi dengan akses terbatas. Berpengalaman sejak {siteConfig.foundingYear}, tim kami mengutamakan ketepatan titik bor, stabilitas lubang, dan pengecoran sistem pipa tremi. Minim getaran, sehingga risiko keretakan pada bangunan sekitar dapat dikurangi.</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 2: Tabel Harga Bore Pile                 -->
  <!-- ================================================ -->
  <PricingTable method="borepile" city={cityData.name} />

  <!-- ================================================ -->
  <!-- SECTION 2b: Kalkulator Interaktif                -->
  <!-- Tepat di bawah tabel harga                       -->
  <!-- ================================================ -->
  <section class="ls-section">
    <CalculatorUI 
      title={`Harga Jasa Bore Pile ${cityData.name} 2026 | Aseven Pile`}
      description="Gunakan kalkulator ini untuk menghitung total RAB pondasi bore pile proyek Anda."
      defaults={{ method: 'borepile', location: calcLoc, depth: 12, points: 30 }} 
    />
  </section>


  <!-- ================================================ -->
  <!-- SECTION 5: Contoh Hitungan                       -->
  <!-- ================================================ -->
        <section class="ls-section">
    <h3 class="ls-case-title">{projectTitle}</h3>
    <p class="ls-case-desc" set:html={projectDesc}></p>
    
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
      
      {ex.items.map((item, idx) => (
        <div style={`padding: ${idx > 0 ? '16px 0 0 0' : '0 0 16px 0'}; border-bottom: ${idx < ex.items.length - 1 ? '2px dashed #cbd5e1' : 'none'};`}>
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; padding: 12px 0; border-bottom: 1px solid #e2e8f0;">
            <div style="color: #64748b; font-size: 0.95rem;">Spesifikasi</div>
            <div style="font-weight: 600; color: #0f172a; text-align: right;">
              Diameter {item.diameterCm} cm 
              <span style="font-weight:normal; color:#64748b; font-size:0.85rem; display:block;">(Jasa {rupiah(item.pricePerM)} / m&sup1;)</span>
            </div>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; padding: 12px 0; border-bottom: 1px solid #e2e8f0;">
            <div style="color: #64748b; font-size: 0.95rem;">Kedalaman / Titik</div>
            <div style="font-weight: 600; color: #0f172a; text-align: right;">{item.depthM} meter</div>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; padding: 12px 0;">
            <div style="color: #64748b; font-size: 0.95rem;">Jumlah Titik</div>
            <div style="font-weight: 600; color: #0f172a; text-align: right;">{item.points} titik</div>
          </div>
        </div>
      ))}
      
      <div style="margin-top: 16px; padding-top: 16px; border-top: 2px dashed #cbd5e1;">
        <div style="font-size: 0.9rem; color: #64748b; margin-bottom: 4px;">Total Estimasi Biaya Jasa:</div>
                        <div style="font-size: 0.95rem; color: #475569; margin-bottom: 8px;">
          {ex.items.length > 1 
            ? ex.items.map(i => (
                <div style="margin-bottom: 6px; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; flex-wrap: wrap;">
                  <span>&bull; D{i.diameterCm}: {i.points} titik &times; {i.depthM} m &times; {rupiah(i.pricePerM)}</span>
                  <span style="font-weight: 600; color: #334155;">= {rupiah(i.subtotal)}</span>
                </div>
              ))
            : `${ex.items[0].points} titik \u00D7 ${ex.items[0].depthM} m \u00D7 ${rupiah(ex.items[0].pricePerM)}`
          }
        </div>
        <div style="font-size: 1.25rem; font-weight: 700; color: var(--color-primary);">{rupiah(ex.total)}</div>
        {ex.isReal && (
          <div style="margin-top: 16px;">
            <a href="#galeri" style="display: inline-block; font-size: 0.85rem; color: var(--color-primary); text-decoration: none; font-weight: 500; background: #eff6ff; padding: 6px 16px; border-radius: 20px; border: 1px solid #bfdbfe; transition: all 0.2s ease;">
              Lihat foto proyek ini di galeri &darr;
            </a>
          </div>
        )}
      </div>
    </div>

    <p class="ls-case-note">
      {caseNote}
    </p>
  </section>

  <CostAddons service="borepile" />

  <!-- ================================================ -->
  <!-- SECTION 6: Keunggulan -->
  <ServiceFeatures
    title={`Keunggulan Jasa Bore Pile Aseven Pile di ${cityData.name}`}
    features={[
      { title: "Minim Getaran & Aman", desc: `Mesin bor kami dirancang bekerja tanpa menimbulkan getaran keras. Sangat aman diaplikasikan di lingkungan padat penduduk ${cityData.name} tanpa merusak tembok rumah tetangga.`, iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>` },
      { title: "Berpengalaman", desc: "Tim kami sudah berpengalaman dalam pekerjaan pondasi, khususnya bore pile, dan terbiasa menangani berbagai kondisi tanah di lapangan.", iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>` },
      { title: "Komitmen Kualitas", desc: "Layanan yang dihasilkan mengutamakan kualitas dan dikerjakan sesuai prosedur, spesifikasi yang disepakati, serta Standar Nasional Indonesia (SNI).", iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path><path d="M8 18h.01"></path><path d="M16 18h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M16 14h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M16 10h.01"></path></svg>` }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 7: Bore Pile Mesin vs Tiang Pancang -->
  <ComparisonSection
    title={`Bore Pile Mesin vs Tiang Pancang di ${cityData.name}`}
    description={`Bingung antara pondasi bor (bore pile) atau tiang pancang? Berikut bedanya, disesuaikan dengan kondisi lapangan di ${cityData.name}:`}
    primaryTitle="Bore Pile Mesin"
    primaryDesc={`Bore pile mesin merupakan metode <em>cast in-situ</em>, yaitu lubang dibor terlebih dahulu di lokasi, kemudian diisi besi tulangan dan dicor beton langsung di tempat. Karena tidak melalui proses pemancangan, getaran dan suara yang dihasilkan sangat minim sehingga aman diterapkan di lingkungan padat bangunan seperti ${cityData.name}. Diameternya fleksibel, mulai 30 hingga 80 cm, dengan kedalaman mencapai 30 meter tergantung kondisi tanah. Mini crane yang kami gunakan dirancang untuk masuk ke gang sempit dan jalan terbatas, sehingga bore pile dapat dikerjakan di lokasi yang tidak dapat dijangkau truk besar. Untuk area yang benar-benar sempit, metode alternatifnya adalah <a href="/area-layanan/strauss-pile/${cityData.slug}">Strauss Pile</a> yang menggunakan tenaga manual.`}
    secondaryTitle="Tiang Pancang (Paku Bumi)"
    secondaryDesc="Tiang pancang merupakan kebalikannya. Beton dicetak di pabrik secara <em>precast</em>, lalu dipancang ke dalam tanah menggunakan palu berat. Metode ini lebih cepat dan seringkali lebih ekonomis untuk tanah lunak, serta mutu betonnya lebih terkontrol karena dicetak di pabrik. Namun, ada konsekuensi yang perlu dipertimbangkan. Getaran yang ditimbulkan cukup besar sehingga berisiko meretakkan dinding bangunan tua di sekitarnya, suaranya bising, dan alat pancang membutuhkan akses jalan lebar minimal 4 sampai 5 meter sehingga tidak dapat masuk ke gang sempit. Tiang pancang baru menjadi pertimbangan apabila lokasi jauh dari bangunan tetangga, akses jalan lebar, dan tanahnya lunak homogen."
    conclusion={`<strong>Kesimpulan:</strong> Untuk mayoritas proyek di <strong>${cityData.name}</strong>, terutama ruko, rumah tinggal, dan gedung bertingkat di lingkungan padat, bore pile mesin hampir selalu menjadi pilihan yang lebih aman. Bukan karena lebih murah, sebab kadang justru lebih mahal, tetapi karena tidak berisiko merusak bangunan tetangga dan dapat masuk ke lokasi yang tidak dapat diakses alat pancang. Apabila masih ragu, tim kami dapat melakukan survei lapangan untuk menilai kondisi tanah dan akses, lalu merekomendasikan metode yang paling efisien untuk proyek Anda.`}
  />

  <!-- ================================================ -->
  <!-- SECTION 8: Galeri / Portofolio Proyek            -->
  <!-- ================================================ -->
  {getProjects(cityData.slug, 'borepile').length ? (
    <ProjectGallery city={cityData.name} projects={getProjects(cityData.slug, 'borepile')} />
  ) : (
    <MiniGallery 
    title={`Dokumentasi Proyek Bore Pile ${cityData.name}`} 
    subtitle="Bukti pengerjaan lapangan pondasi bore pile mesin yang dikerjakan langsung oleh tim spesialis kami."
    images={[
      { src: "/imgs/header-beranda-bore-pile-aseven.webp", alt: `Proses Pengeboran Bore Pile Mesin di ${cityData.name}`, fallback: `Pengeboran+${cityData.name}` },
      { src: "/imgs/header-beranda-bore-pile-aseven-2.webp", alt: `Pemasangan Besi Tulangan Bore Pile ${cityData.name}`, fallback: `Besi+Tulangan` },
      { src: "/imgs/wa-gallery-1.webp", alt: `Pengecoran Pipa Tremi ${cityData.name}`, fallback: `Pengecoran+Tremi` }
    ]}
    />
  )}

  <!-- ================================================ -->
  <!-- SECTION 9: SOP / Tahapan Pengerjaan              -->
  <!-- ================================================ -->
    <ProcessSteps 
    title={`SOP Pengerjaan Bore Pile di ${cityData.name}`} 
    subtitle="Standar kerja sistematis Aseven Pile untuk menjamin mutu dan keamanan struktur pondasi."
    steps={[
      { number: 1, title: `Survei Lapangan`, desc: `Tim meninjau kondisi tanah dan akses jalan masuk di ${cityData.name} untuk memastikan manuver alat berat mini crane aman.` },
      { number: 2, title: "Setting Mesin & Pengeboran", desc: "Perakitan rig bore pile mesin di titik awal. Pengeboran dilakukan hingga mencapai kedalaman tanah keras yang diisyaratkan konsultan." },
      { number: 3, title: "Pemasangan Besi Tulangan", desc: "Penurunan keranjang besi tulangan SNI ke dalam lubang bor yang sudah dibersihkan dari endapan lumpur." },
      { number: 4, title: "Pengecoran Pipa Tremi", desc: "Pengecoran beton dilakukan menggunakan teknik pipa tremi dari dasar lubang, menekan lumpur dan air naik keluar sehingga beton murni utuh tanpa segregasi." }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 10: FAQ Lokal                            -->
  <!-- ================================================ -->
  <FAQSection 
    title={`Pertanyaan Seputar Bore Pile di ${cityData.name}`} 
    subtitle="Informasi lengkap biaya dan operasional."
    faqs={cityFaqs} 
  />

  <!-- ================================================ -->
  <!-- SECTION 11: Link Artikel / Blog                  -->
  <!-- ================================================ -->
  <section class="ls-section">
    <h2 class="ls-art-heading">Artikel Terkait</h2>
    <ArticleList limit={1} />
  </section>

  <!-- ================================================ -->
  <!-- SECTION 12: Konsultasi & Jadwal Survei           -->
  <!-- ================================================ -->
  <PremiumCTA 
      title="Konsultasi & Survei Lapangan"
      subtitle={`Hubungi kami via WhatsApp untuk konsultasi proyek dan penjadwalan survei lokasi di ${cityData.name}.`}
      buttonText="Konsultasi via WhatsApp"
      waMessage={`Halo Aseven Pile, saya mau konsultasi jasa bore pile untuk daerah ${cityData.name}`}
    />
    
    <CityCrossLinks currentSlug={cityData.slug} serviceType="bore-pile" serviceName="Bore Pile" />

  <!-- ================================================ -->
  <!-- SECTION 13: Google Maps & Wilayah Kecamatan      -->
  <!-- ================================================ -->
  <Fragment slot="bottom-content">
    <LocationMap />

    {cityData.groupedAreas && cityData.groupedAreas.length > 0 ? (
      <section class="container ls-area-section">
        <h2 class="ls-area-title">Wilayah Layanan Bore Pile {cityData.name}</h2>
        <p class="ls-center-desc ls-desc-600">Layanan kami mencakup seluruh area di bawah ini. Tim dan peralatan operasional kami siap didatangkan ke lokasi Anda.</p>
        
        <div class="ls-area-grid">
          {cityData.groupedAreas.map((group) => (
            <div class="ls-area-card">
              <h3>
                <span>{group.groupName}</span>
              </h3>
              <div class="ls-area-chips">
                {group.areas.map((area) => (
                  <span class="ls-area-chip">
                    {area}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ) : (
      cityData.subAreas && cityData.subAreas.length > 0 && (
        <section class="container ls-area-section">
          <h3 class="ls-subarea-title">Area Layanan {cityData.name}</h3>
          <p class="ls-subarea-desc">Area layanan kami di {cityData.name}:</p>
          <div class="ls-area-chips">
            {cityData.subAreas.map((area) => (
              <span class="ls-subarea-chip">
                {area.name}
              </span>
            ))}
          </div>
        </section>
      )
    )}
  </Fragment>
</LocalSEOLayout>











































