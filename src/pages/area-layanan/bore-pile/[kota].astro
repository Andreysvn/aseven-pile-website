---
import LocalSEOLayout from '../../../components/layout/LocalSEOLayout.astro';
import CalculatorUI from '../../../components/interactive/CalculatorUI';
import PricingTable from '../../../components/ui/PricingTable.astro';
import '../../../styles/calculator.css';
import { SERVICE_CITIES, GLOBAL_FAQS } from '../../../data/seo-data';
import { siteConfig } from '../../../data/site.config';

export async function getStaticPaths() {
  return SERVICE_CITIES.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}

const { cityData } = Astro.props;
const combinedFaqs = [...GLOBAL_FAQS, ...cityData.localFaqs];
const otherCities = SERVICE_CITIES.filter(c => c.slug !== cityData.slug).slice(0, 6);

const getCalculatorLocation = (slug, province) => {
  const jabodetabek = ['jakarta', 'jakarta-selatan', 'jakarta-timur', 'jakarta-barat', 'jakarta-pusat', 'jakarta-utara', 'bogor', 'depok', 'tangerang', 'tangerang-selatan', 'bekasi'];
  if (jabodetabek.includes(slug)) return 'jabodetabek';
  if (province.toLowerCase().includes('banten')) return 'banten';
  if (slug.includes('bandung')) return 'bandung';
  if (province.toLowerCase().includes('jawa tengah') || province.toLowerCase().includes('yogyakarta')) return 'jawatengah';
  if (province.toLowerCase().includes('jawa timur')) return 'jawatimur';
  return 'other';
};
const calcLoc = getCalculatorLocation(cityData.slug, cityData.province);
---

<LocalSEOLayout 
  title={`Jasa Bore Pile ${cityData.name} — Harga Mulai Rp 115.000/m`} 
  description={`Jasa bore pile mesin di ${cityData.name}. Harga mulai Rp 115.000/m (Ø30cm). Alat mini crane milik sendiri, berpengalaman sejak ${siteConfig.foundingYear}. Survei & konsultasi gratis.`}
  city={cityData.name}
  serviceName="Bore Pile"
  pathContext="bore-pile"
  faqs={combinedFaqs}
>

  <!-- ================================================ -->
  <!-- SECTION 1: Hero + Trust Badges + Direct Answer   -->
  <!-- ================================================ -->
  <div slot="header-badge" style="display: flex; gap: 8px; justify-content: center; margin-bottom: var(--space-4); flex-wrap: wrap;">
    <span style="display:inline-block; padding: 4px 12px; background: rgba(139,0,0,0.1); color: var(--color-primary); border-radius: 20px; font-weight:600; font-size: 0.875rem;">Bore Pile Mesin</span>
    <span style="display:inline-block; padding: 4px 12px; background: #e0f2fe; color: #0284c7; border-radius: 20px; font-weight:600; font-size: 0.875rem;">✔ Standar SNI</span>
    <span style="display:inline-block; padding: 4px 12px; background: #dcfce7; color: #166534; border-radius: 20px; font-weight:600; font-size: 0.875rem;">✔ Survei Gratis</span>
  </div>

  <section style="margin-bottom: var(--space-12);">
    <div style="background: var(--color-bg-alt); padding: var(--space-6); border-left: 4px solid var(--color-primary); border-radius: 0 var(--radius-md) var(--radius-md) 0; margin-bottom: var(--space-8);">
      <p style="margin: 0; font-weight: 500; font-size: 1.05rem; line-height: 1.6;"><strong>Ringkasan:</strong> Harga jasa bore pile mesin di <strong>{cityData.name}</strong> berkisar antara <strong>Rp 115.000 hingga Rp 350.000 per meter</strong> (jasa bor saja), tergantung diameter (30cm - 80cm) dan kondisi tanah.</p>
    </div>
    <p style="color: var(--color-text-muted); font-style: italic;">[Konten intro belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 2: Tabel Harga Bore Pile                 -->
  <!-- ================================================ -->
  <PricingTable method="borepile" city={cityData.name} />

  <!-- ================================================ -->
  <!-- SECTION 2b: Kalkulator Interaktif                -->
  <!-- Tepat di bawah tabel harga                       -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <CalculatorUI 
      client:visible 
      title={`Kalkulator Estimasi Biaya Bore Pile ${cityData.name}`}
      description="Gunakan kalkulator ini untuk menghitung total RAB pondasi bore pile proyek Anda."
      defaults={{ method: 'borepile', location: calcLoc, depth: 12, points: 30 }} 
    />
  </section>

  <!-- ================================================ -->
  <!-- SECTION 3: Biaya Tambahan & Ketentuan            -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12); margin-top: var(--space-8);">
    <h2 style="margin-bottom: var(--space-6);">Ketentuan & Biaya Tambahan</h2>
    <p style="color: var(--color-text-muted); font-style: italic;">[Konten belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 4: Contoh Hitungan Proyek Nyata          -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Simulasi Biaya Proyek di {cityData.name}</h2>
    <p style="color: var(--color-text-muted); font-style: italic;">[Konten belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 5: Tabel Perbandingan Bore vs Strauss    -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Bore Pile Mesin vs Strauss Pile Manual</h2>
    <p style="color: var(--color-text-muted); font-style: italic;">[Konten belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 6: Kenapa Memilih Bore Pile Mesin        -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Kenapa Memilih Bore Pile Mesin?</h2>
    <p style="color: var(--color-text-muted); font-style: italic;">[Konten belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 7: Kondisi Tanah per Wilayah (E-E-A-T)   -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Kondisi Tanah di {cityData.name}</h2>
    <p style="color: var(--color-text-muted); font-style: italic;">[Konten belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 8: SOP / Tahapan Pengerjaan              -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Tahapan Pengerjaan Bore Pile di {cityData.name}</h2>
    <p style="color: var(--color-text-muted); font-style: italic;">[Konten belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 9: Galeri / Portofolio Proyek            -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Dokumentasi Proyek Bore Pile {cityData.name}</h2>
    <p style="color: var(--color-text-muted); font-style: italic;">[Konten belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 10: FAQ Lokal                            -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Pertanyaan Seputar Bore Pile di {cityData.name}</h2>
    <div style="display: flex; flex-direction: column; gap: var(--space-4);">
      {combinedFaqs.map((faq) => (
        <details style="border: 1px solid var(--color-border-light); border-radius: var(--radius-md); padding: var(--space-4); background: white; cursor: pointer;">
          <summary style="font-weight: 600; color: var(--color-text); list-style: none; display: flex; justify-content: space-between; align-items: center;">
            {faq.question}
            <span style="color: var(--color-primary); font-size: 1.5rem; line-height: 1;">+</span>
          </summary>
          <p style="margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-border-light); color: var(--color-text-muted);">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 11: Link Artikel / Blog                  -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Artikel Terkait</h2>
    <p style="color: var(--color-text-muted); font-style: italic;">[Konten belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 12: Cross-Links Layanan & Kota Lain      -->
  <!-- ================================================ -->
  <section style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); margin-bottom: var(--space-12);">
    <div style="background: white; border: 1px solid var(--color-border-light); padding: var(--space-6); border-radius: var(--radius-lg);">
      <h3 style="font-size: 1.125rem; margin-bottom: var(--space-2);">Butuh Strauss Pile?</h3>
      <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: var(--space-4);">Jika proyek di {cityData.name} tidak bisa diakses mesin, pertimbangkan Strauss Pile.</p>
      <a href={`/area-layanan/strauss-pile/${cityData.slug}`} style="color: var(--color-primary); font-weight: 600; text-decoration: none;">Cek Strauss Pile {cityData.name} →</a>
    </div>
    <div style="background: white; border: 1px solid var(--color-border-light); padding: var(--space-6); border-radius: var(--radius-lg);">
      <h3 style="font-size: 1.125rem; margin-bottom: var(--space-2);">Bore Pile Kota Lain</h3>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        {otherCities.map(c => (
          <a href={`/area-layanan/bore-pile/${c.slug}`} style="font-size: 0.875rem; color: #475569; text-decoration: underline;">{c.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 13: Google Maps Embed                    -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Lokasi Kami</h2>
    <p style="color: var(--color-text-muted); font-style: italic;">[Google Maps embed belum ada, nanti dikirim]</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 14: CTA Penutup + Publisher Byline       -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12); text-align: center; padding: var(--space-8); background: var(--color-bg-alt); border-radius: var(--radius-lg);">
    <p style="color: var(--color-text-muted); font-style: italic;">[CTA Penutup & Publisher Byline belum ada, nanti dikirim]</p>
  </section>



  <!-- ================================================ -->
  <!-- SLOT: Bottom Content (Wilayah Kecamatan)         -->
  <!-- ================================================ -->
  <Fragment slot="bottom-content">
    {cityData.groupedAreas && cityData.groupedAreas.length > 0 ? (
      <section class="container" style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border-light);">
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); text-align: center; margin-bottom: var(--space-2); color: var(--color-primary);">Wilayah Layanan Bore Pile {cityData.name}</h2>
        <p style="text-align: center; color: var(--color-text-muted); margin-bottom: var(--space-8); max-width: 600px; margin-left: auto; margin-right: auto;">Layanan kami mencakup seluruh area di bawah ini. Tim dan peralatan operasional kami siap didatangkan ke lokasi Anda.</p>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6);">
          {cityData.groupedAreas.map((group) => (
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: var(--space-6); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
              <h3 style="font-size: 1.25rem; margin-bottom: var(--space-4); border-bottom: 2px solid #f1f5f9; padding-bottom: 12px;">
                <span style="color: var(--color-primary); font-weight: 700;">{group.groupName}</span>
              </h3>
              <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                {group.areas.map((area) => (
                  <span style="display: inline-block; padding: 6px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px; font-size: 0.8rem; color: #475569;">
                    {area}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ) : (
      cityData.subAreas && cityData.subAreas.length > 0 && (
        <section class="container" style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border-light);">
          <h3 style="font-size: 1.2rem; margin-bottom: var(--space-2);">Area Layanan {cityData.name}</h3>
          <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: var(--space-4);">Area layanan kami di {cityData.name}:</p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            {cityData.subAreas.map((area) => (
              <span style="display: inline-block; padding: 4px 12px; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 16px; font-size: 0.85rem; color: #475569; font-weight: 500;">
                {area.name}
              </span>
            ))}
          </div>
        </section>
      )
    )}
  </Fragment>
</LocalSEOLayout>
