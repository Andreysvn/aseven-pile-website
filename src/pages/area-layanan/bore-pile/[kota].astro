---
import LocalSEOLayout from '../../../components/layout/LocalSEOLayout.astro';
import ServiceArea from '../../../components/ui/ServiceArea.astro';
import ServiceIntro from '../../../components/ui/ServiceIntro.astro';
import CalculatorUI from '../../../components/interactive/CalculatorUI.astro';
import PricingTable from '../../../components/ui/PricingTable.astro';
import CostExample from '../../../components/ui/CostExample.astro';
import CostAddons from '../../../components/ui/CostAddons.astro';
import SoilCharacter from '../../../components/ui/SoilCharacter.astro';
import MachineSpec from '../../../components/ui/MachineSpec.astro';
import ProjectGallery from '../../../components/ui/ProjectGallery.astro';
import ComparisonSection from '../../../components/ui/ComparisonSection.astro';
import ServiceFeatures from '../../../components/ui/ServiceFeatures.astro';
import ArticleList from '../../../components/ui/ArticleList.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import ProcessSteps from '../../../components/ui/ProcessSteps.astro';
import MiniGallery from '../../../components/ui/MiniGallery.astro';
import LocationMap from '../../../components/ui/LocationMap.astro';
import PremiumCTA from '../../../components/ui/PremiumCTA.astro';
import CityCrossLinks from '../../../components/ui/CityCrossLinks.astro';

import '../../../styles/calculator.css';
import { SERVICE_CITIES, getCityFaqs } from '../../../data/seo-data';
import { getProjects } from '../../../data/projects';
import { exampleForCity } from '../../../data/example';
import { siteConfig } from '../../../data/site.config';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  return SERVICE_CITIES.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}


const { cityData } = Astro.props;
const cityFaqs = getCityFaqs(cityData, 'borepile');
const otherCities = SERVICE_CITIES.filter(c => c.slug !== cityData.slug).slice(0, 6);
const straussUrl = ['jakarta', 'bekasi'].includes(cityData.slug) ? `/area-layanan/strauss-pile/${cityData.slug}` : '/layanan/strauss-pile-manual';

// Contoh perhitungan biaya bore pile (PINTAR per kota):
// - Bila cities.json punya "caseStudy": { "isReal": true, "diameter":30, "depthM":12, "points":15 } â†’ tampil "Studi Kasus" (angka nyata).
// - Bila tidak â†’ contoh digenerate dari data kota (kedalaman dari averageDepth, jumlah titik divariasikan) â†’ angka beda tiap wilayah.
const ex = exampleForCity(cityData);
const rupiah = (n) => `Rp ${n.toLocaleString('id-ID')}`;
const projectTitle = ex.isReal
  ? `Perhitungan Biaya Berdasarkan Proyek Bore Pile di ${cityData.name}`
  : `Contoh Perhitungan Biaya Bore Pile di ${cityData.name}`;
  const projectDesc = ex.isReal
    ? `Spesifikasi ini berasal dari dokumentasi proyek nyata di ${cityData.name}. Perhitungan biaya menggunakan tarif jasa per meter yang tercantum pada halaman ini.`
    : `Sebagai gambaran, berikut contoh perhitungan biaya jasa bore pile di ${cityData.name} untuk ${ex.items[0].points} titik pondasi sedalam ${ex.items[0].depthM} meter diameter ${ex.items[0].diameterCm} cm:`;
const caseNote = ex.isReal
  ? `*Spesifikasi berasal dari proyek nyata; total dihitung menggunakan tarif jasa per meter yang tercantum pada halaman ini, bukan nilai invoice/kontrak proyek. Belum termasuk material, mob/demob alat, dan bak sirkulasi air.`
  : `*Contoh perhitungan (bukan proyek spesifik). Harga jasa bor saja; belum termasuk material, pengiriman alat, dan penampungan air.`;


const getCalculatorLocation = (slug, province) => {
  const jabodetabek = ['jakarta', 'jakarta-selatan', 'jakarta-timur', 'jakarta-barat', 'jakarta-pusat', 'jakarta-utara', 'bogor', 'depok', 'tangerang', 'tangerang-selatan', 'bekasi'];
  if (jabodetabek.includes(slug)) return 'jabodetabek';
  if (province.toLowerCase().includes('banten')) return 'banten';
  if (slug.includes('bandung')) return 'bandung';
  if (province.toLowerCase().includes('jawa tengah') || province.toLowerCase().includes('yogyakarta')) return 'jawatengah';
  if (province.toLowerCase().includes('jawa timur')) return 'jawatimur';
  return 'other';
};
const calcLoc = getCalculatorLocation(cityData.slug, cityData.province);
const expectedHeroImagePath = '/imgs/header-jasa-bore-pile-' + cityData.slug + '-aseven-pile.webp';
const hasHeroImage = fs.existsSync(path.join(process.cwd(), 'public', expectedHeroImagePath));
---

<LocalSEOLayout 
  title={`Harga Jasa Bore Pile ${cityData.name} 2026`} 
  description={`Jasa bore pile mesin di ${cityData.name}. Harga mulai Rp 139.000/m (Ø30cm). Alat mini crane milik sendiri, berpengalaman sejak ${siteConfig.foundingYear}. Survei & konsultasi gratis.`}
  city={cityData.name}
  serviceName="Bore Pile"
  pathContext="bore-pile"
  heroImage={hasHeroImage ? expectedHeroImagePath : undefined}
  faqs={cityFaqs}
>

  <!-- ================================================ -->
  <!-- SECTION 1: Header / Intro                        -->
  <!-- ================================================ -->
  <ServiceIntro service="borepile" cityName={cityData.name} hargaMulai={139000} foundingYear={siteConfig.foundingYear} crossLink={{ url: straussUrl, text: `jasa strauss pile manual ${cityData.name}` }} />

    <!-- ================================================ -->
  <!-- SECTION 2: Tabel Harga Bore Pile                 -->
  <!-- ================================================ -->
  <PricingTable method="borepile" city={cityData.name} />

  <!-- ================================================ -->
  <!-- SECTION 2b: Kalkulator Interaktif                -->
  <!-- ================================================ -->
  <section id="kalkulator" class="ls-section">
    <CalculatorUI 
      title={`Harga Jasa Bore Pile ${cityData.name} 2026 | Aseven Pile`}
      description="Gunakan kalkulator ini untuk menghitung total RAB pondasi bore pile proyek Anda."
      defaults={{ method: 'borepile', location: calcLoc, depth: 12, points: 30 }} 
    />
  </section>

  <!-- SECTION 5: Contoh Hitungan -->
  <CostExample
    method="borepile"
    title={projectTitle}
    description={projectDesc}
    ex={ex}
    note={caseNote}
  />

  <CostAddons service="borepile" />





  <!-- ================================================ -->
  <!-- SECTION 6: Keunggulan -->
  <ServiceFeatures
    title={`Keunggulan Jasa Bore Pile Aseven Pile di ${cityData.name}`}
    features={[
      { 
        title: "Minim Getaran & Aman Lingkungan", 
        desc: `Pengeboran dengan mini crane bekerja tanpa benturan palu pancang yang keras. Sangat aman dikerjakan berdampingan dengan dinding bangunan tetangga di area padat pemukiman ${cityData.name}.`, 
        iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>` 
      },
      { 
        title: "Akses Jalan Sempit & Area Terbatas", 
        desc: `Rangka alat mini crane kami dirancang ringkas dan fleksibel, mampu masuk ke jalan lingkungan selebar 2,5 – 3 meter yang tidak dapat diakses alat berat tiang pancang.`, 
        iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>` 
      },
      { 
        title: "Kualitas Sesuai Gambar & SNI", 
        desc: "Pekerjaan pembesian, kedalaman titik, dan pengecoran sistem tremi dikerjakan secara presisi mengikuti gambar teknis serta spesifikasi perencana struktur proyek Anda.", 
        iconRawSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path><path d="M8 18h.01"></path><path d="M16 18h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M16 14h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M16 10h.01"></path></svg>` 
      }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 7: Bore Pile Mesin vs Tiang Pancang -->
  <ComparisonSection
    title={`Bore Pile Mesin vs Tiang Pancang di ${cityData.name}`}
    description={`Bingung memilih antara pondasi bore pile mesin atau tiang pancang? Berikut perbandingan teknisnya disesuaikan dengan kondisi lapangan di ${cityData.name}:`}
    primaryTitle="Bore Pile Mesin"
    primaryDesc={`Bore pile mesin merupakan metode <em>cast in-situ</em>, yaitu lubang dibor terlebih dahulu di lokasi sampai kedalaman tanah keras yang direncanakan, kemudian dimasukkan keranjang besi tulangan dan dicor beton langsung di tempat menggunakan pipa tremi. Karena proses pengeboran mengandalkan putaran mesin (bukan tumbukan keras palu), getaran dan suara yang ditimbulkan sangat minim sehingga aman diterapkan di lingkungan padat bangunan seperti ${cityData.name}. Pilihan diameter sangat fleksibel mulai dari 30 cm, 40 cm, 50 cm, hingga 60 cm. Mini crane yang kami gunakan dirancang khusus agar dapat bermanuver di jalan perumahan atau gang sempit yang tidak bisa dilalui truk tronton tiang pancang. Untuk area yang luar biasa sempit di mana mesin tidak bisa didirikan, tersedia alternatif pekerjaan manual yaitu <a href="${straussUrl}">Strauss Pile</a>.`}
    secondaryTitle="Tiang Pancang (Paku Bumi)"
    secondaryDesc="Tiang pancang pracetak menggunakan tiang beton masif yang dicetak di pabrik (<em>precast</em>), lalu dipancang ke dalam tanah menggunakan palu berat (drop hammer atau hydraulic hammer). Keunggulannya adalah proses pemancangan cepat dan mutu beton terjamin dari batching plant pabrik. Namun, tumbukan palu pancang menimbulkan getaran seismik tanah yang kuat dan suara bising berulang yang berisiko tinggi meretakkan dinding bangunan tetangga di area padat. Selain itu, truk pengangkut tiang panjang dan alat crane pancang berbobot puluhan ton membutuhkan akses jalan minimal 4 sampai 5 meter dan ruang kerja yang lapang."
    conclusion={`<strong>Kesimpulan:</strong> Untuk mayoritas proyek di kawasan <strong>${cityData.name}</strong>—khususnya ruko, rumah tinggal bertingkat, atau gudang di lingkungan padat penduduk—bore pile mesin menjadi solusi yang jauh lebih aman terhadap lingkungan tetangga. Pilihan metode tetap disesuaikan dengan rekomendasi penyelidikan tanah (sondir) dan gambar struktur perencana Anda. Tim teknis Aseven Pile siap melakukan survei lokasi untuk memeriksa kondisi akses dan merekomendasikan metode kerja paling efisien.`}
  />

  <!-- SECTION: Spesifikasi Alat & Kapasitas Mesin -->
  <MachineSpec service="borepile" city={cityData} />

  <!-- ================================================ -->
  <!-- SECTION 8: Galeri / Portofolio Proyek            -->
  <!-- ================================================ -->
  {getProjects(cityData.slug, 'borepile').length ? (
    <ProjectGallery city={cityData.name} projects={getProjects(cityData.slug, 'borepile')} />
  ) : (
    <MiniGallery 
    title={`Dokumentasi Proyek Bore Pile ${cityData.name}`} 
    subtitle="Bukti pengerjaan lapangan pondasi bore pile mesin yang dikerjakan langsung oleh tim spesialis kami."
    images={[
      { src: "/imgs/header-beranda-bore-pile-aseven.webp", alt: `Proses Pengeboran Bore Pile Mesin di ${cityData.name}`, fallback: `Pengeboran+${cityData.name}` },
      { src: "/imgs/header-beranda-bore-pile-aseven-2.webp", alt: `Pemasangan Besi Tulangan Bore Pile ${cityData.name}`, fallback: `Besi+Tulangan` },
      { src: "/imgs/wa-gallery-1.webp", alt: `Pengecoran Pipa Tremi ${cityData.name}`, fallback: `Pengecoran+Tremi` }
    ]}
    />
  )}

  <!-- ================================================ -->
  <!-- SECTION 9: SOP / Tahapan Pengerjaan              -->
  <!-- ================================================ -->
    <ProcessSteps 
    title={`SOP Pengerjaan Bore Pile di ${cityData.name}`} 
    subtitle="Standar kerja sistematis Aseven Pile untuk menjamin mutu dan keamanan struktur pondasi."
    steps={[
      { number: 1, title: `Survei Lapangan`, desc: `Tim meninjau kondisi tanah dan akses jalan masuk di ${cityData.name} untuk memastikan manuver alat berat mini crane aman.` },
      { number: 2, title: "Setting Mesin & Pengeboran", desc: "Perakitan rig bore pile mesin di titik awal. Pengeboran dilakukan hingga mencapai kedalaman tanah keras yang diisyaratkan konsultan." },
      { number: 3, title: "Pemasangan Besi Tulangan", desc: "Penurunan keranjang besi tulangan SNI ke dalam lubang bor yang sudah dibersihkan dari endapan lumpur." },
      { number: 4, title: "Pengecoran Pipa Tremi", desc: "Pengecoran beton dilakukan menggunakan teknik pipa tremi dari dasar lubang, menekan lumpur dan air naik keluar sehingga beton murni utuh tanpa segregasi." }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 10: FAQ Lokal                            -->
  <!-- ================================================ -->
  <FAQSection 
    title={`Pertanyaan Seputar Bore Pile di ${cityData.name}`} 
    subtitle="Informasi lengkap biaya dan operasional."
    faqs={cityFaqs} 
  />

  <!-- ================================================ -->
  <!-- SECTION 11: Link Artikel / Blog                  -->
  <!-- ================================================ -->
  <section class="ls-section">
    <h2 class="ls-art-heading">Artikel Terkait</h2>
    <ArticleList limit={1} />
  </section>

  <!-- ================================================ -->
  <!-- SECTION 12: Konsultasi & Jadwal Survei           -->
  <!-- ================================================ -->
  <PremiumCTA 
      title="Konsultasi & Survei Lapangan"
      subtitle={`Hubungi kami via WhatsApp untuk konsultasi proyek dan penjadwalan survei lokasi di ${cityData.name}.`}
      buttonText="WhatsApp"
      waMessage={`Halo Aseven Pile, saya dari website ingin menanyakan terkait Jasa Bore Pile ${cityData.name}`}
    />
    
    <CityCrossLinks currentSlug={cityData.slug} serviceType="bore-pile" serviceName="Bore Pile" />

  <!-- ================================================ -->
  <!-- SECTION 13: Google Maps & Wilayah Kecamatan      -->
  <!-- ================================================ -->
  <Fragment slot="bottom-content">
    <LocationMap />
    <ServiceArea cityData={cityData} serviceName="Bore Pile" />
  </Fragment>
</LocalSEOLayout>
