---
import LocalSEOLayout from '../../../components/layout/LocalSEOLayout.astro';
import CalculatorUI from '../../../components/interactive/CalculatorUI';
import PricingTable from '../../../components/ui/PricingTable.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import ProcessSteps from '../../../components/ui/ProcessSteps.astro';
import MiniGallery from '../../../components/ui/MiniGallery.astro';
import LocationMap from '../../../components/ui/LocationMap.astro';
import CityCrossLinks from '../../../components/ui/CityCrossLinks.astro';

import '../../../styles/calculator.css';
import { SERVICE_CITIES, GLOBAL_FAQS } from '../../../data/seo-data';
import { siteConfig } from '../../../data/site.config';

export async function getStaticPaths() {
  return SERVICE_CITIES.map((cityData) => {
    return {
      params: { kota: cityData.slug },
      props: { cityData },
    };
  });
}


const { cityData } = Astro.props;
const combinedFaqs = [...GLOBAL_FAQS, ...cityData.localFaqs];
const otherCities = SERVICE_CITIES.filter(c => c.slug !== cityData.slug).slice(0, 6);

const jabodetabekSlugs = ['jakarta', 'jakarta-selatan', 'jakarta-timur', 'jakarta-barat', 'jakarta-pusat', 'jakarta-utara', 'bogor', 'depok', 'tangerang', 'tangerang-selatan', 'bekasi'];
const hasRealProject = jabodetabekSlugs.includes(cityData.slug);
const projectTitle = hasRealProject 
  ? `Studi Kasus: Proyek Riil Rumah 2 Lantai di ${cityData.name}`
  : `Simulasi Biaya Bore Pile Rumah 2 Lantai di ${cityData.name}`;
const projectDesc = hasRealProject
  ? `Banyak klien kami di ${cityData.name} membangun rumah 2 atau 3 lantai menggunakan pondasi bore pile diameter 30cm. Berikut adalah estimasi <strong>biaya jasa aktual</strong> dari salah satu proyek kami untuk rumah dengan kebutuhan 15 titik pondasi sedalam 10 meter:`
  : `Banyak klien kami membangun rumah 2 atau 3 lantai menggunakan pondasi bore pile diameter 30cm. Berikut adalah estimasi <strong>simulasi biaya jasa murni</strong> untuk rumah di ${cityData.name} dengan kebutuhan 15 titik pondasi sedalam 10 meter:`;


const getCalculatorLocation = (slug, province) => {
  const jabodetabek = ['jakarta', 'jakarta-selatan', 'jakarta-timur', 'jakarta-barat', 'jakarta-pusat', 'jakarta-utara', 'bogor', 'depok', 'tangerang', 'tangerang-selatan', 'bekasi'];
  if (jabodetabek.includes(slug)) return 'jabodetabek';
  if (province.toLowerCase().includes('banten')) return 'banten';
  if (slug.includes('bandung')) return 'bandung';
  if (province.toLowerCase().includes('jawa tengah') || province.toLowerCase().includes('yogyakarta')) return 'jawatengah';
  if (province.toLowerCase().includes('jawa timur')) return 'jawatimur';
  return 'other';
};
const calcLoc = getCalculatorLocation(cityData.slug, cityData.province);
---

<LocalSEOLayout 
  title={`Jasa Bore Pile ${cityData.name} — Harga Mulai Rp 115.000/m`} 
  description={`Jasa bore pile mesin di ${cityData.name}. Harga mulai Rp 115.000/m (Ø30cm). Alat mini crane milik sendiri, berpengalaman sejak ${siteConfig.foundingYear}. Survei & konsultasi gratis.`}
  city={cityData.name}
  serviceName="Bore Pile"
  pathContext="bore-pile"
  faqs={combinedFaqs}
>

  <!-- ================================================ -->
  <!-- SECTION 1: Hero + Trust Badges + Direct Answer   -->
  <!-- ================================================ -->
  

  <section style="margin-bottom: var(--space-12);">
    <div style="background: #f8fafc; padding: 16px; border: 1px solid #e2e8f0; border-radius: 12px; margin-bottom: 24px; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); display: flex; align-items: flex-start; gap: 12px;">
      <div style="flex-shrink: 0; margin-top: 2px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
      </div>
      <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: #475569;"><strong>Ringkasan:</strong> Harga jasa bore pile mesin (jasa murni) di {cityData.name} berkisar antara <strong>Rp 115.000 - Rp 350.000 / meter lari (m&sup1;)</strong>, harga tersebut belum termasuk biaya material (besi dan beton), mob/demob alat, dan pembuatan bak sirkulasi air.</p>
    </div>
    <p style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 16px;">Membangun gedung bertingkat, pabrik, atau ruko 3 lantai di wilayah {cityData.name} membutuhkan pondasi yang ekstra kuat dan stabil. Kami menyediakan jasa pengeboran <strong>bore pile mesin mini crane</strong> yang dirancang khusus untuk menembus kerasnya kontur tanah {cityData.name} hingga kedalaman 30 meter.</p>
    <p style="font-size: 1.05rem; line-height: 1.7;">Berpengalaman sejak {siteConfig.foundingYear}, tim teknis <strong>{siteConfig.brand}</strong> menjamin ketepatan titik bor, stabilitas lubang, dan kualitas pengecoran menggunakan sistem pipa tremi agar beton tidak bercampur lumpur. Pengerjaan cepat, standar SNI, dan 100% aman tanpa risiko retak pada bangunan tetangga.</p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 2: Tabel Harga Bore Pile                 -->
  <!-- ================================================ -->
  <PricingTable method="borepile" city={cityData.name} />

  <!-- ================================================ -->
  <!-- SECTION 2b: Kalkulator Interaktif                -->
  <!-- Tepat di bawah tabel harga                       -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <CalculatorUI 
      client:visible 
      title={`Kalkulator Estimasi Biaya Bore Pile ${cityData.name}`}
      description="Gunakan kalkulator ini untuk menghitung total RAB pondasi bore pile proyek Anda."
      defaults={{ method: 'borepile', location: calcLoc, depth: 12, points: 30 }} 
    />
  </section>


  <!-- ================================================ -->
  <!-- SECTION 5: Contoh Hitungan                       -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12); background: white; border: 1px solid var(--color-border-light); border-radius: var(--radius-lg); padding: var(--space-6) var(--space-8);">
    <h3 style="font-size: 1.25rem; margin-bottom: 16px; color: var(--color-primary);">{projectTitle}</h3>
      <p style="font-size: 0.95rem; line-height: 1.6; color: var(--color-text-muted); margin-bottom: 16px;" set:html={projectDesc}></p>
    <ul style="margin: 0 0 16px 20px; padding: 0; font-size: 0.95rem; color: #334155;">
      <li style="margin-bottom: 8px;">Spesifikasi: <strong>Diameter 30 cm</strong> (Jasa Rp 115.000 / m&sup1;)</li>
      <li style="margin-bottom: 8px;">Kedalaman per Titik: <strong>10 meter</strong></li>
      <li style="margin-bottom: 8px;">Jumlah Titik: <strong>15 titik</strong></li>
    </ul>
    <div style="background: #f1f5f9; padding: 12px 16px; border-radius: 8px; font-weight: 600; color: #0f172a; margin-bottom: 12px;">
      Total Jasa Pengeboran = 15 x 10m x Rp 115.000 = Rp 17.250.000
    </div>
    <p style="font-size: 0.85rem; color: #64748b; margin: 0; font-style: italic;">
      *Ini adalah contoh hitungan jasa murni. Belum termasuk biaya material, pengiriman alat, dan penampungan sirkulasi lumpur.
    </p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 6: Keunggulan                            -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="font-size: 1.75rem; margin-bottom: 24px; text-align: center;">Keunggulan Jasa Bore Pile Aseven Pile di {cityData.name}</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
      <div style="background: white; border: 1px solid var(--color-border-light); padding: 24px; border-radius: 12px;">
        <div style="width: 48px; height: 48px; background: #e0f2fe; color: #0284c7; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <h3 style="font-size: 1.15rem; margin-bottom: 12px;">Minim Getaran & Aman</h3>
        <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">Mesin bor kami dirancang bekerja tanpa menimbulkan getaran keras. Sangat aman diaplikasikan di lingkungan padat penduduk {cityData.name} tanpa merusak tembok rumah tetangga.</p>
      </div>
      <div style="background: white; border: 1px solid var(--color-border-light); padding: 24px; border-radius: 12px;">
        <div style="width: 48px; height: 48px; background: #e0f2fe; color: #0284c7; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 19 21 12 17 5 21 12 2"></polygon></svg>
        </div>
        <h3 style="font-size: 1.15rem; margin-bottom: 12px;">Kualitas Cor Pipa Tremi</h3>
        <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">Kami sangat ketat pada standar prosedur. Pengecoran selalu memakai sistem pipa tremi bawah air untuk mencegah adukan beton bercampur dengan lumpur sisa galian.</p>
      </div>
      <div style="background: white; border: 1px solid var(--color-border-light); padding: 24px; border-radius: 12px;">
        <div style="width: 48px; height: 48px; background: #e0f2fe; color: #0284c7; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <h3 style="font-size: 1.15rem; margin-bottom: 12px;">Eksekusi Tepat Waktu</h3>
        <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">Dengan tim teknisi berpengalaman dan jam terbang tinggi, manajemen operasional kami tertata rapi agar durasi proyek pondasi tidak molor dari Rencana Anggaran Biaya.</p>
      </div>
    </div>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 7: Bore Pile vs Strauss                  -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12); display: flex; flex-direction: column; gap: 24px; background: #f8fafc; padding: 32px; border-radius: var(--radius-lg);">
    <h2 style="font-size: 1.5rem; margin-bottom: 0;">Bore Pile Mesin vs Strauss Pile di {cityData.name}</h2>
    <p style="color: var(--color-text-muted); margin-bottom: 16px; font-size: 1rem;">Bingung memilih antara mesin atau manual? Berikut panduan singkat menyesuaikan dengan kondisi lapangan di {cityData.name}:</p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
      <div style="background: white; padding: 20px; border-radius: 8px; border-left: 4px solid var(--color-primary); box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
        <h3 style="margin-bottom: 8px; font-size: 1.1rem;">Bore Pile Mesin</h3>
        <p style="font-size: 0.9rem; color: #475569; margin: 0;">Mampu mengebor hingga kedalaman 30m. Cocok untuk bangunan 3+ lantai dan sanggup menembus lapisan tanah cadas. Membutuhkan akses jalan setidaknya seukuran mobil engkel.</p>
      </div>
      <div style="background: white; padding: 20px; border-radius: 8px; border-left: 4px solid #f59e0b; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
        <h3 style="margin-bottom: 8px; font-size: 1.1rem;">Strauss Pile Manual</h3>
        <p style="font-size: 0.9rem; color: #475569; margin: 0 0 12px 0;">Digerakkan tenaga manusia (maks 6-8m). Paling pas untuk gang sangat sempit di {cityData.name} (cuma muat motor) dan bangunan ringan 1-2 lantai. Tidak bisa menembus batuan keras.</p>
        <a href={`/area-layanan/strauss-pile/${cityData.slug}`} style="font-size: 0.88rem; font-weight: 600; color: var(--color-primary); text-decoration: underline;">Lihat Jasa Strauss Pile {cityData.name} &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 7: Kondisi Tanah per Wilayah (E-E-A-T)   -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="font-size: 1.5rem; margin-bottom: 16px;">Karakteristik Tanah & Geoteknik {cityData.name}</h2>
    
    <p style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 16px;">
      Wilayah <strong>{cityData.name}</strong> memiliki kondisi geoteknik yang didominasi oleh <strong>{cityData.soilType || 'tanah aluvial & lempung'}</strong> dengan kontur lahan <strong>{cityData.terrain || 'datar'}</strong>. Berdasarkan pengalaman proyek kami, lapisan tanah keras (<em>hard strata</em>) di area ini umumnya berada pada kedalaman rata-rata <strong>{cityData.averageDepth || '18 - 25 meter'}</strong>, sehingga penentuan kedalaman tiang pondasi harus presisi agar bangunan tidak mengalami penurunan (<em>settlement</em>).
    </p>

    <p style="font-size: 1.05rem; line-height: 1.7;">
      Untuk mengantisipasi risiko kelongsoran lubang bor akibat tingginya muka air tanah di {cityData.name}, kami memadukan teknik bor basah (<em>wash boring</em>) dengan pemasangan pipa pelindung sementara (<em>temporary casing</em>). Seluruh proses pengecoran diwajibkan menggunakan sistem <strong>Pipa Tremi SNI</strong> agar adukan beton mengalir murni dari dasar lubang dan menekan air keluar tanpa segregasi, menjamin mutu beton tetap padat dan kokoh sempurna.
    </p>
  </section>

  <!-- ================================================ -->
  <!-- SECTION 8: Galeri / Portofolio Proyek            -->
  <!-- ================================================ -->
    <MiniGallery 
    title={`Dokumentasi Proyek Bore Pile ${cityData.name}`} 
    subtitle="Bukti pengerjaan lapangan pondasi bore pile mesin yang dikerjakan langsung oleh tim spesialis kami."
    images={[
      { src: "/imgs/header-beranda-bore-pile-aseven.webp", alt: `Proses Pengeboran Bore Pile Mesin di ${cityData.name}`, fallback: `Pengeboran+${cityData.name}` },
      { src: "/imgs/header-beranda-bore-pile-aseven-2.webp", alt: `Pemasangan Besi Tulangan Bore Pile ${cityData.name}`, fallback: `Besi+Tulangan` },
      { src: "/imgs/wa-gallery-1.webp", alt: `Pengecoran Pipa Tremi ${cityData.name}`, fallback: `Pengecoran+Tremi` }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 9: SOP / Tahapan Pengerjaan              -->
  <!-- ================================================ -->
    <ProcessSteps 
    title={`SOP Pengerjaan Bore Pile di ${cityData.name}`} 
    subtitle="Standar kerja sistematis Aseven Pile untuk menjamin mutu dan keamanan struktur pondasi."
    steps={[
      { number: 1, title: `Survei Lapangan`, desc: `Tim meninjau kondisi tanah dan akses jalan masuk di ${cityData.name} untuk memastikan manuver alat berat mini crane aman.` },
      { number: 2, title: "Setting Mesin & Pengeboran", desc: "Perakitan rig bore pile mesin di titik awal. Pengeboran dilakukan hingga mencapai kedalaman tanah keras yang diisyaratkan konsultan." },
      { number: 3, title: "Pemasangan Besi Tulangan", desc: "Penurunan keranjang besi tulangan SNI ke dalam lubang bor yang sudah dibersihkan dari endapan lumpur." },
      { number: 4, title: "Pengecoran Pipa Tremi", desc: "Pengecoran beton dilakukan menggunakan teknik pipa tremi dari dasar lubang, menekan lumpur dan air naik keluar sehingga beton murni utuh tanpa segregasi." }
    ]}
  />

  <!-- ================================================ -->
  <!-- SECTION 10: FAQ Lokal                            -->
  <!-- ================================================ -->
  <FAQSection 
    title={`Pertanyaan Seputar Bore Pile di ${cityData.name}`} 
    subtitle="Informasi lengkap biaya dan operasional."
    faqs={combinedFaqs} 
  />

  <!-- ================================================ -->
  <!-- SECTION 11: Link Artikel / Blog                  -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <h2 style="margin-bottom: var(--space-6);">Artikel Terkait</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-6);">
      <!-- Card 1 -->
      <a href="/artikel/menghitung-rab-bore-pile" style="display: flex; flex-direction: column; background: white; border: 1px solid var(--color-border-light); border-radius: var(--radius-lg); overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s;" class="hover-card">
        <div style="aspect-ratio: 16/9; background: #e2e8f0; position: relative;">
          <div style="position: absolute; bottom: 8px; left: 8px; background: var(--color-primary); color: white; padding: 4px 12px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">Edukasi</div>
        </div>
        <div style="padding: var(--space-4);">
          <h3 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--color-text);">Cara Menghitung Kebutuhan Besi & Beton untuk Pondasi Bore Pile</h3>
          <p style="font-size: 0.9rem; color: var(--color-text-muted); margin: 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">Pelajari cara menghitung RAB material (besi tulangan dan beton readymix) setelah mengetahui harga jasa bor.</p>
        </div>
      </a>

      <!-- Card 2 -->
      <a href="/artikel/bahaya-lumpur-bore-pile" style="display: flex; flex-direction: column; background: white; border: 1px solid var(--color-border-light); border-radius: var(--radius-lg); overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s;" class="hover-card">
        <div style="aspect-ratio: 16/9; background: #e2e8f0; position: relative;">
          <div style="position: absolute; bottom: 8px; left: 8px; background: #0284c7; color: white; padding: 4px 12px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">Tips Proyek</div>
        </div>
        <div style="padding: var(--space-4);">
          <h3 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--color-text);">Kenapa Cor Beton Wajib Pakai Pipa Tremi?</h3>
          <p style="font-size: 0.9rem; color: var(--color-text-muted); margin: 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">Hindari kegagalan struktur pondasi akibat beton yang bercampur dengan lumpur galian. Pipa tremi adalah solusinya.</p>
        </div>
      </a>
    </div>
  </section>

  <style>
    .hover-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }
  </style>

  <!-- ================================================ -->
  <!-- SECTION 12: Konsultasi & Jadwal Survei           -->
  <!-- ================================================ -->
  <section style="margin-bottom: var(--space-12);">
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 32px; text-align: center; margin-bottom: 32px;">
      <h2 style="font-size: 1.5rem; color: #0f172a; margin-bottom: 12px;">Siap Memulai Proyek Anda?</h2>
      <p style="color: #475569; margin-bottom: 24px; font-size: 1.05rem;">Tim teknis Aseven Pile siap meninjau lokasi proyek di <strong>{cityData.name}</strong> dan menghitung estimasi RAB secara gratis.</p>
      <a href={`https://wa.me/${siteConfig.whatsapp}?text=Halo%20Aseven%20Pile,%20saya%20mau%20konsultasi%20jasa%20bore%20pile%20untuk%20daerah%20${cityData.name}`} target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; justify-content: center; background: #0f172a; color: white; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 500; font-size: 1rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
         Hubungi Tim Teknis via WhatsApp
      </a>
    </div>
    
    <CityCrossLinks currentSlug={cityData.slug} serviceType="bore-pile" serviceName="Bore Pile" />
  </section>

  <!-- ================================================ -->
  <!-- SECTION 13: Google Maps & Wilayah Kecamatan      -->
  <!-- ================================================ -->
  <Fragment slot="bottom-content">
    <LocationMap />

    {cityData.groupedAreas && cityData.groupedAreas.length > 0 ? (
      <section class="container" style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border-light);">
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); text-align: center; margin-bottom: var(--space-2); color: var(--color-primary);">Wilayah Layanan Bore Pile {cityData.name}</h2>
        <p style="text-align: center; color: var(--color-text-muted); margin-bottom: var(--space-8); max-width: 600px; margin-left: auto; margin-right: auto;">Layanan kami mencakup seluruh area di bawah ini. Tim dan peralatan operasional kami siap didatangkan ke lokasi Anda.</p>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6);">
          {cityData.groupedAreas.map((group) => (
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: var(--space-6); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
              <h3 style="font-size: 1.25rem; margin-bottom: var(--space-4); border-bottom: 2px solid #f1f5f9; padding-bottom: 12px;">
                <span style="color: var(--color-primary); font-weight: 700;">{group.groupName}</span>
              </h3>
              <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                {group.areas.map((area) => (
                  <span style="display: inline-block; padding: 6px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px; font-size: 0.8rem; color: #475569;">
                    {area}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ) : (
      cityData.subAreas && cityData.subAreas.length > 0 && (
        <section class="container" style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border-light);">
          <h3 style="font-size: 1.2rem; margin-bottom: var(--space-2);">Area Layanan {cityData.name}</h3>
          <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: var(--space-4);">Area layanan kami di {cityData.name}:</p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            {cityData.subAreas.map((area) => (
              <span style="display: inline-block; padding: 4px 12px; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 16px; font-size: 0.85rem; color: #475569; font-weight: 500;">
                {area.name}
