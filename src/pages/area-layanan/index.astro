---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AreaGrid from '../../components/ui/AreaGrid.astro';
import InteractiveCoverageMap from '../../components/ui/InteractiveCoverageMap.astro';
import PremiumCTA from '../../components/ui/PremiumCTA.astro';
import { siteConfig } from '../../data/site.config';

const title = "Area Layanan Jasa Pondasi | ASeven Pile";
const description = `Pilih kota Anda untuk melihat detail layanan, harga, dan estimasi biaya pondasi dari ${siteConfig.brand}. Melayani Jabodetabek dan sekitarnya.`;
---

<BaseLayout title={title} description={description}>
  
  <header class="section section-bg-alt" style="padding-top: var(--space-12); padding-bottom: var(--space-8); text-align: center;">
    <div class="container" style="max-width: 700px;">
      <h1 style="color: var(--color-primary); margin-bottom: var(--space-4); font-size: clamp(28px, 4vw, 42px); line-height: 1.3;">Pilih Kota Layanan Anda</h1>
      <p style="font-size: 1.1rem; color: var(--color-text-muted); line-height: 1.7; max-width: 560px; margin: 0 auto;">
        Klik kota di bawah untuk melihat layanan, harga, dan estimasi biaya pondasi di wilayah Anda.
      </p>
    </div>
  </header>

  <!-- GRID KOTA -->
  <AreaGrid hideTitle={true} noPaddingTop={true} />

  <!-- PETA CAKUPAN -->
  <InteractiveCoverageMap />

  <!-- CTA -->
  <PremiumCTA 
    title="Kota Anda Tidak Ada di Sini?" 
    subtitle="Hubungi kami langsung. Kami bisa survei ke luar area standar dengan biaya mobilisasi yang transparan."
    waMessage="Halo ASEVEN PILE, saya ingin tanya apakah bisa melayani lokasi saya"
  />


  <div style="text-align: center; padding-bottom: var(--space-12);">
    <a href="/kontak" style="display: inline-block; padding: 12px 28px; background: white; color: var(--color-primary); border: 2px solid var(--color-primary); border-radius: 8px; font-weight: 600; text-decoration: none; transition: all 0.3s ease;" onmouseover="this.style.background='var(--color-primary)'; this.style.color='white';" onmouseout="this.style.background='white'; this.style.color='var(--color-primary)';">
      Lihat Lokasi Kami &rarr;
    </a>
  </div>

</BaseLayout>



