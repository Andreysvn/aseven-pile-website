---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AreaGrid from '../../components/ui/AreaGrid.astro';
import InteractiveCoverageMap from '../../components/ui/InteractiveCoverageMap.astro';
import { siteConfig } from '../../data/site.config';

const title = "Area Layanan Bore Pile & Strauss Pile";
const description = `Jangkauan layanan kontraktor pondasi ${siteConfig.brand} mencakup seluruh wilayah Jabodetabek, Jawa Barat, Banten, Jawa Tengah, dan Jawa Timur.`;
---

<BaseLayout title={title} description={description}>
  
  <header class="section section-bg-alt" style="padding-top: var(--space-12); padding-bottom: var(--space-8); border-bottom: 1px solid var(--color-border-light); text-align: center;">
    <div class="container" style="max-width: 800px;">
      <h1 style="color: var(--color-primary); margin-bottom: var(--space-4); font-size: clamp(28px, 4vw, 42px); line-height: 1.3;">Jangkauan Area Layanan</h1>
      <p style="font-size: 1.125rem; color: var(--color-text-light); line-height: 1.7; max-width: 650px; margin: 0 auto;">
        Tim spesialis pengeboran pondasi kami siap meluncur ke proyek Anda. Klik kota di bawah ini untuk melihat detail harga dan estimasi RAB sesuai lokasi.
      </p>
    </div>
  </header>

  <!-- MAP SECTION -->
  <section class="section">
    <div class="container">
      <div style="text-align: center; margin-bottom: var(--space-8);">
        <h2 style="font-size: var(--text-2xl); color: var(--color-text);">Peta Jangkauan Interaktif</h2>
        <p style="color: var(--color-text-muted);">Cari area proyek Anda di peta dan lihat estimasi mob-demob</p>
      </div>
      <InteractiveCoverageMap />
    </div>
  </section>

  <!-- GRID SECTION -->
  <section class="section section-bg-alt" style="padding-top: var(--space-12); padding-bottom: var(--space-12);">
    <div class="container">
      <div style="text-align: center; margin-bottom: var(--space-8);">
        <h2 style="font-size: var(--text-2xl); color: var(--color-text);">Daftar Wilayah Operasional</h2>
        <p style="color: var(--color-text-muted);">Pilih kota untuk menghitung estimasi biaya otomatis via kalkulator</p>
      </div>
      <AreaGrid />
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="background-color: var(--color-primary); color: white; text-align: center;">
    <div class="container">
      <h2 style="color: white; margin-bottom: var(--space-4);">Kota Anda Belum Terdaftar?</h2>
      <p style="margin-bottom: var(--space-8); color: rgba(255,255,255,0.9); font-size: 1.125rem; max-width: 600px; margin-left: auto; margin-right: auto;">
        Jangan khawatir! Kami tetap melayani proyek khusus di luar area operasional utama dengan kesepakatan harga mob-demob tersendiri.
      </p>
      <a href={`https://wa.me/${siteConfig.whatsapp}?text=Halo%20ASEVEN%20PILE,%20saya%20punya%20proyek%20tapi%20lokasinya%20di%20luar%20Jabodetabek/Jawa,%20apakah%20bisa%20dibantu?`} class="btn" style="background-color: #25D366; color: white; border-color: #25D366; padding: 14px 32px; font-size: 1.125rem; box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; margin-right:8px; vertical-align:text-bottom;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        Konsultasi via WA
      </a>
    </div>
  </section>

</BaseLayout>
