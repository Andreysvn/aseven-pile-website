---
import BaseLayout from '../../components/layout/BaseLayout.astro';

const title = "Tentang Kami";
const description = "Mengenal lebih dekat Aseven Pile, penyedia jasa spesialis bore pile dan strauss pile terpercaya.";
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container text-center">
      <span class="eyebrow">Profil Perusahaan</span>
      <h1>Tentang Aseven Pile</h1>
      <p class="hero-sub" style="margin: 0 auto;">Spesialis pondasi bore pile dan strauss pile berpengalaman yang mengutamakan keamanan dan ketepatan waktu.</p>
    </div>
  </section>

  <section style="padding-bottom: var(--space-12);">
    <div class="container">
      <div style="max-width: 800px; margin: 0 auto; background: var(--color-bg); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-border-light);">
        <h2>Visi & Misi Kami</h2>
        <p>Aseven Pile hadir untuk memberikan solusi pondasi yang kuat dan stabil untuk berbagai jenis konstruksi bangunan. Kami berkomitmen memberikan layanan yang cepat, presisi, dan sesuai dengan standar keamanan SNI.</p>
        <p>Dengan tenaga ahli yang telah mengerjakan ratusan proyek di seluruh Jabodetabek, kami menjamin kepuasan klien mulai dari survei lokasi hingga tahap pengecoran akhir.</p>
        
        <h3 style="margin-top: var(--space-6);">Mengapa Memilih Kami?</h3>
        <ul style="margin-top: var(--space-2); padding-left: var(--space-4); line-height: 1.8;">
          <li><strong>Berpengalaman:</strong> Tim lapangan yang terlatih menghadapi berbagai kontur tanah.</li>
          <li><strong>Peralatan Lengkap:</strong> Menggunakan mesin mini crane modern.</li>
          <li><strong>Harga Transparan:</strong> Perhitungan RAB yang jelas tanpa biaya tersembunyi.</li>
          <li><strong>Tepat Waktu:</strong> Manajemen proyek yang disiplin.</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

