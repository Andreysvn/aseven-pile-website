---

<BaseLayout title="Galeri Proyek | Aseven Pile" description="Dokumentasi hasil pekerjaan pondasi bore pile dan strauss pile dari Aseven Pile.">
  <!-- Header & Search Bar -->
  <div class="page-header search-header">
    <div class="container text-center">
      <h1>Galeri Proyek</h1>
      <p class="subtitle">Dokumentasi hasil pekerjaan pondasi lapangan Aseven Pile.</p>
      
      <!-- Search Bar -->
      <div class="search-container">
        <div class="search-box">
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="searchInput" placeholder="Cari foto proyek (misal: strauss)..." autocomplete="off" />
        </div>
      </div>

      <!-- Filter Kategori -->
      <div class="problem-filters">
        <div class="filter-chips">
          <button class="chip active" data-filter="all">Semua</button>
          {allTags.map(tag => (
            <button class="chip" data-filter={tag.toLowerCase()}>{tag}</button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Area Galeri -->
  <section class="section">
    <div class="container">
      
      <div id="noResults" class="no-results hidden">
        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <h3>Foto Tidak Ditemukan</h3>
      </div>

      <!-- Grid 2 Kolom -->
      <div class="gallery-grid" id="galleryGrid">
        {photos.map((photo) => (
          <div 
            class="gallery-item" 
            data-title={photo.title.toLowerCase()} 
            data-category={photo.category.toLowerCase()}
          >
            <div class="img-wrapper">
              {photo.imageUrl ? (
                <img src={photo.imageUrl} alt={photo.altText} loading="lazy" class="gallery-zoom-img" data-large={photo.imageUrl} />
              ) : (
                <div class="placeholder-img">
                  <span>Foto {photo.id}</span>
                </div>
              )}
            </div>
            <div class="card-content">
              <span class="photo-category">{photo.category}</span>
              <p class="photo-title">{photo.title}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Pagination / Halaman -->
      <div class="pagination-container" id="paginationContainer">
        <button id="prevBtn" class="page-btn" disabled>&laquo; Sebelumnya</button>
        <span id="pageInfo" class="page-info">Halaman 1</span>
        <button id="nextBtn" class="page-btn">Selanjutnya &raquo;</button>
      </div>

    </div>
    <!-- Lightbox Dialog -->
      <dialog class="lightbox" id="galleryLightbox">
        <div class="lightbox-wrapper">
          <button class="close-btn" id="lightboxClose" aria-label="Tutup">&times;</button>
          <img class="lightbox-img" id="lightboxImg" src="" alt="Gambar Diperbesar" />
        </div>
      </dialog>
    </div>
  </section>
</BaseLayout>

<style>
  /* Header (Sama kayak artikel) */
  .search-header {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    padding: 120px 0 60px;
    border-bottom: 1px solid var(--color-border-light);
  }

  .search-header h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin-bottom: var(--space-4);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto var(--space-8);
  }

  .search-container {
    max-width: 700px;
    margin: 0 auto var(--space-6);
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border: 2px solid var(--color-border-light);
    border-radius: 50px;
    padding: 8px 24px;
    transition: all 0.2s ease;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  }

  .search-box:focus-within {
    border-color: var(--color-primary);
  }

  .search-box svg {
    color: var(--color-text-muted);
    margin-right: 12px;
  }

  .search-box input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 12px 0;
    font-size: 1.1rem;
    color: var(--color-text);
    outline: none;
  }

  .problem-filters {
    display: flex;
    justify-content: center;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .chip {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .chip:hover, .chip.active {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .chip.active {
    background: var(--color-primary);
    color: white;
  }

  /* Grid Galeri (Request 2 Kolom) */
  .gallery-grid {
    display: grid;
    /* Mutlak 2 Kolom */
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .gallery-item {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    aspect-ratio: 4/3;
    position: relative;
    display: none; /* Disembunyikan dulu, nanti diatur JS pagination */
  }

  .img-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .placeholder-img {
    width: 100%;
    height: 100%;
    background: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    font-weight: bold;
    font-size: 1.2rem;
  }

  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  /* Overlay Teks di Foto */
  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 50%, transparent 100%);
    padding: var(--space-6) var(--space-4) var(--space-4);
    color: white;
  }

  .photo-category {
    background: var(--color-primary);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 4px;
  }

  .photo-title {
      font-size: 0.9rem;
      color: #ffffff !important;
    font-weight: 500;
    margin: 0;
  }

  @media (min-width: 768px) {
    .photo-title {
      font-size: 1.1rem;
    }
  }

  /* Pagination */
  .pagination-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .page-btn {
    background: var(--color-bg);
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .page-btn:hover:not(:disabled) {
    background: var(--color-primary);
    color: white;
  }

  .page-btn:disabled {
    border-color: var(--color-border-light);
    color: var(--color-text-muted);
    cursor: not-allowed;
    opacity: 0.5;
  }

  .page-info {
    font-weight: 600;
    color: var(--color-text);
  }

  .no-results {
    text-align: center;
    padding: 60px 0;
    color: var(--color-text-muted);
  }
  
  .no-results.hidden {
    display: none;
  }

  .gallery-zoom-img {
    cursor: zoom-in;
  }
  
  

  .gallery-item:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.1); } /* Lightbox Styles */
    .lightbox { border: none !important; background: transparent !important; background-color: transparent !important; padding: 0 !important; margin: auto; width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; overflow: hidden; }
  
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(8px);
  }
  
      .lightbox-wrapper {
    position: relative;
    display: inline-block;
    padding: 0;
  }
  
  .lightbox-img {
    display: block;
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 8px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
  
  .close-btn {
    position: absolute;
    top: -20px;
    right: -20px;
    z-index: 10;
    background: var(--color-primary);
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: transform 0.2s;
  }
  
  .close-btn:hover {
    transform: scale(1.1);
    background: #a00000;
  }
</style>

<script>
  // Fitur Pencarian Pintar + Pagination Anti-Lag
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchInput');
    const chips = document.querySelectorAll('.chip');
    const allCards = Array.from(document.querySelectorAll('.gallery-item'));
    const noResults = document.getElementById('noResults');
    
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const pageInfo = document.getElementById('pageInfo');
    const paginationContainer = document.getElementById('paginationContainer');

    let currentFilter = 'all';
    let searchQuery = '';
    
    // Setting: 20 foto per halaman
    const itemsPerPage = 20;
    let currentPage = 1;
    let filteredCards = [];

    // Fungsi untuk menyaring data
    function applyFilters() {
      filteredCards = allCards.filter(card => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        
        const matchesSearch = title.includes(searchQuery) || category.includes(searchQuery);
        const matchesFilter = currentFilter === 'all' || category === currentFilter;

        return matchesSearch && matchesFilter;
      });

      currentPage = 1; // Reset ke halaman 1 tiap kali filter berubah
      renderPage();
    }

    // Fungsi untuk menampilkan kartu berdasarkan halaman
    function renderPage() {
      // Sembunyikan semua kartu dulu
      allCards.forEach(card => card.style.display = 'none');

      // Tampilkan pesan kosong jika tidak ada hasil
      if (filteredCards.length === 0) {
        noResults.classList.remove('hidden');
        paginationContainer.style.display = 'none';
        return;
      } else {
        noResults.classList.add('hidden');
        paginationContainer.style.display = 'flex';
      }

      // Hitung indeks array untuk halaman saat ini
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      
      // Tampilkan kartu yang sesuai jatah halaman ini
      const cardsToShow = filteredCards.slice(startIndex, endIndex);
      cardsToShow.forEach(card => card.style.display = 'block');

      updatePaginationButtons();
    }

    function updatePaginationButtons() {
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);
      
      pageInfo.textContent = `Halaman ${currentPage} dari ${totalPages}`;
      
      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage === totalPages || totalPages === 0;
      
      // Sembunyikan tombol kalau cuma 1 halaman
      if (totalPages <= 1) {
        paginationContainer.style.display = 'none';
      }
    }

    // Event Listener Navigasi
    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPage();
        window.scrollTo({ top: document.querySelector('.search-header').offsetHeight, behavior: 'smooth' });
      }
    });

    nextBtn.addEventListener('click', () => {
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        renderPage();
        window.scrollTo({ top: document.querySelector('.search-header').offsetHeight, behavior: 'smooth' });
      }
    });

    // Event Listener Filter Text
    if(searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        applyFilters();
      });
    }

    // Event Listener Filter Tombol (Chips)
    chips.forEach(chip => {
      chip.addEventListener('click', (e) => {
        chips.forEach(c => c.classList.remove('active'));
        e.target.classList.add('active');
        
        currentFilter = e.target.getAttribute('data-filter');
        applyFilters();
      });
    });

    // Jalankan render pertama kali (menampilkan 20 data awal)
    applyFilters();

    // Lightbox Logic
    const lightbox = document.getElementById('galleryLightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxClose = document.getElementById('lightboxClose');

    if (lightbox && lightboxImg) {
      // Delegated event listener on the grid container for performance
      const galleryGrid = document.getElementById('galleryGrid');
      galleryGrid.addEventListener('click', (e) => {
        const img = e.target.closest('.gallery-zoom-img');
        if (img) {
          const largeSrc = img.getAttribute('data-large');
          if (largeSrc) {
            lightboxImg.src = largeSrc;
            lightbox.showModal();
            document.body.style.overflow = 'hidden';
          }
        }
      });

      const closeLightbox = () => {
        lightbox.close();
        document.body.style.overflow = '';
        setTimeout(() => lightboxImg.src = '', 300);
      };

      if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
      
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) {
          closeLightbox();
        }
      });
    }
  }); // This closes the DOMContentLoaded block from the original script
</script>











