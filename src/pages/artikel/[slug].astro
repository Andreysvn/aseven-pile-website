---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PremiumCTA from '../../components/ui/PremiumCTA.astro';

export async function getStaticPaths() {
  const posts = await getCollection('artikel');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Organization",
    "name": post.data.author
  },
  "datePublished": post.data.pubDate.toISOString()
};
---

<BaseLayout 
  title={`${post.data.title} | Aseven Pile`} 
  description={post.data.description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <!-- Hero Section Artikel -->
  <section class="art-hero">
    <div class="container art-hero-container">
      <nav class="art-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span class="separator">/</span>
        <a href="/artikel">Artikel</a>
        <span class="separator">/</span>
        <span class="current" aria-current="page">Panduan Teknis</span>
      </nav>
      
      <h1 class="art-title">{post.data.title}</h1>
      <p class="art-desc">{post.data.description}</p>
      
      <div class="art-meta">
        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Ditulis oleh <strong>{post.data.author}</strong>
        </div>
        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
    </div>
  </section>

  <!-- Konten Artikel -->
  <article class="container art-content-wrapper">
    <div class="prose-content">
      <Content />
    </div>
  </article>

  <!-- Call To Action -->
  <div style="background-color: #f8fafc; padding: 40px 0; margin-top: 60px; border-top: 1px solid #e2e8f0;">
    <PremiumCTA 
      title="Butuh Jasa Bore Pile Standar SNI?"
      subtitle="Kami mematuhi standar prosedur pengecoran yang ketat (termasuk penggunaan pipa tremi) demi keamanan pondasi bangunan Anda."
      waMessage="Halo Aseven Pile, saya butuh info jasa bore pile setelah membaca artikel di web."
    />
  </div>
</BaseLayout>

<style is:global>
  /* Hero Section */
  .art-hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: white;
    padding: 60px 20px;
    text-align: center;
  }
  .art-hero-container {
    max-width: 900px;
    margin: 0 auto;
  }
  
  /* Breadcrumbs */
  .art-breadcrumbs {
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }
  .art-breadcrumbs a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s;
  }
  .art-breadcrumbs a:hover {
    color: #38bdf8;
  }
  .art-breadcrumbs .separator {
    color: #475569;
  }
  .art-breadcrumbs .current {
    color: #38bdf8;
    font-weight: 500;
  }

  /* Title & Desc */
  .art-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    color: #f8fafc;
  }
  .art-desc {
    font-size: 1.15rem;
    color: #cbd5e1;
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto 30px auto;
  }

  /* Meta Info */
  .art-meta {
    display: flex;
    justify-content: center;
    gap: 24px;
    color: #94a3b8;
    font-size: 0.95rem;
    flex-wrap: wrap;
  }
  .art-meta .meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .art-meta strong {
    color: #f8fafc;
  }

  /* Content Wrapper */
  .art-content-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 50px 20px;
    background: #ffffff;
  }

  /* Prose / Markdown Content Formatting */
  .prose-content {
    color: #334155; 
    line-height: 1.8; 
    font-size: 1.15rem;
  }
  
  .prose-content h2 {
    font-size: 1.8rem;
    color: #0f172a;
    margin-top: 3rem;
    margin-bottom: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 10px;
  }
  
  .prose-content h3 {
    font-size: 1.4rem;
    color: #1e293b;
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }
  
  .prose-content p {
    margin-bottom: 1.5rem;
  }
  
  .prose-content ul, .prose-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  
  .prose-content li {
    margin-bottom: 0.5rem;
  }

  .prose-content li::marker {
    color: var(--color-primary, #2563eb);
    font-weight: bold;
  }
  
  .prose-content strong {
    color: #0f172a;
    font-weight: 600;
  }
  
  .prose-content a {
    color: var(--color-primary, #2563eb);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  
  .prose-content a:hover {
    color: #1d4ed8;
    text-decoration-color: #1d4ed8;
  }

  /* Blockquote styling in case they use it */
  .prose-content blockquote {
    border-left: 4px solid var(--color-primary, #2563eb);
    background: #f8fafc;
    padding: 16px 20px;
    margin: 2rem 0;
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #475569;
  }
  
  .prose-content blockquote p:last-child {
    margin-bottom: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .art-hero {
      padding: 40px 16px;
    }
    .art-content-wrapper {
      padding: 30px 16px;
    }
    .prose-content {
      font-size: 1.05rem;
    }
    .prose-content h2 {
      font-size: 1.5rem;
    }
  }
</style>
