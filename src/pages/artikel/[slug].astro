---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PremiumCTA from '../../components/ui/PremiumCTA.astro';
import '../../styles/artikel.css';

export async function getStaticPaths() {
  const posts = await getCollection('artikel');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Organization",
    "name": post.data.author
  },
  "datePublished": post.data.pubDate.toISOString()
};
---

<BaseLayout 
  title={`${post.data.title} | Aseven Pile`} 
  description={post.data.description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <!-- Hero Section Artikel -->
  <section class="art-hero">
    <div class="container art-hero-container">
      <nav class="art-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span class="separator">/</span>
        <a href="/artikel">Artikel</a>
        <span class="separator">/</span>
        <span class="current" aria-current="page">Panduan Teknis</span>
      </nav>
      
      <h1 class="art-title">{post.data.title}</h1>
      <p class="art-desc">{post.data.description}</p>
      
      <div class="art-meta">
        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Ditulis oleh <strong>{post.data.author}</strong>
        </div>
        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
    </div>
  </section>

  <!-- Konten Artikel -->
  <article class="container art-content-wrapper">
    <div class="prose-content">
      <Content />
    </div>
  </article>

  <!-- Call To Action -->
  <div style="background-color: #f8fafc; padding: 40px 0; margin-top: 60px; border-top: 1px solid #e2e8f0;">
    <PremiumCTA 
      title="Butuh Jasa Bore Pile Standar SNI?"
      subtitle="Kami mematuhi standar prosedur pengecoran yang ketat (termasuk penggunaan pipa tremi) demi keamanan pondasi bangunan Anda."
      waMessage="Halo Aseven Pile, saya butuh info jasa bore pile setelah membaca artikel di web."
    />
  </div>
</BaseLayout>
