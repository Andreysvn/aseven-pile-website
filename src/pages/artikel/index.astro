---
import BaseLayout from '../../components/layout/BaseLayout.astro';

// Database Artikel (Gampang ditambah/edit di sini)
const articles = [
  {
    title: "Bore Pile Mesin vs Strauss Pile: Mana yang Tepat untuk Proyek Anda?",
    slug: "bore-pile-vs-strauss-pile",
    excerpt: "Ketahui perbedaan daya dukung, kecepatan, dan harga dari kedua metode ini agar tidak salah pilih dan boros anggaran.",
    imageText: "Bore vs Strauss",
    tags: ["Bore Pile", "Strauss Pile", "Lahan Sempit"]
  },
  {
    title: "Cara Menghitung Biaya Jasa Bore Pile per Meter di Lapangan",
    slug: "cara-menghitung-biaya-bore-pile",
    excerpt: "Jangan tertipu jebakan harga murah per meter. Pelajari komponen biaya tak terduga seperti kuli buang lumpur dan mobilisasi alat berat.",
    imageText: "Kalkulasi Biaya",
    tags: ["Bore Pile"]
  }
];

const allTags = ["Bore Pile", "Strauss Pile", "Lahan Sempit", "Tanah Rawa/Lunak"];
---

<BaseLayout title="Pusat Solusi & Artikel Pondasi | Aseven Pile">
  <!-- Header & Search Bar -->
  <div class="page-header search-header">
    <div class="container text-center">
      <h1>Pusat Solusi Pondasi</h1>
      <p class="subtitle">Cari jawaban untuk masalah konstruksi dan pondasi di lapangan.</p>
      
      <!-- Opsi 2: Search Bar Minimalis -->
      <div class="search-container">
        <div class="search-box">
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="searchInput" placeholder="Ketik masalah atau pertanyaan pondasi Anda..." autocomplete="off" />
        </div>
      </div>

      <!-- Opsi 1: Problem-Based Filter -->
      <div class="problem-filters">
        <span class="filter-label">Kendala Umum:</span>
        <div class="filter-chips">
          <button class="chip active" data-filter="all">Semua</button>
          {allTags.map(tag => (
            <button class="chip" data-filter={tag.toLowerCase()}>{tag}</button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Grid Artikel -->
  <section class="section">
    <div class="container">
      
      <!-- Pesan jika tidak ditemukan -->
      <div id="noResults" class="no-results hidden">
        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <h3>Artikel Tidak Ditemukan</h3>
        <p>Coba gunakan kata kunci lain atau pilih kendala dari tombol di atas.</p>
      </div>

      <div class="article-grid" id="articleGrid">
        {articles.map((article) => (
          <article 
            class="article-card" 
            data-title={article.title.toLowerCase()} 
            data-excerpt={article.excerpt.toLowerCase()}
            data-tags={article.tags.join(',').toLowerCase()}
          >
            <div class="card-image">
              <span>{article.imageText}</span>
            </div>
            <div class="card-content">
              <div class="card-tags">
                {article.tags.map(t => <span class="tag-badge">{t}</span>)}
              </div>
              <h2><a href={`/artikel/${article.slug}`}>{article.title}</a></h2>
              <p>{article.excerpt}</p>
              <a href={`/artikel/${article.slug}`} class="read-more">Baca Solusinya &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .search-header {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    padding: 80px 0 60px;
    border-bottom: 1px solid var(--color-border-light);
  }

  .search-header h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin-bottom: var(--space-4);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto var(--space-8);
  }

  /* Search Box */
  .search-container {
    max-width: 700px;
    margin: 0 auto var(--space-6);
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border: 2px solid var(--color-border-light);
    border-radius: 50px;
    padding: 8px 24px;
    transition: all 0.2s ease;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  }

  .search-box:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 10px 30px rgba(139, 0, 0, 0.1);
  }

  .search-box svg {
    color: var(--color-text-muted);
    margin-right: 12px;
  }

  .search-box input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 16px 0;
    font-size: 1.1rem;
    color: var(--color-text);
    outline: none;
  }

  /* Problem Filters */
  .problem-filters {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .filter-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .chip {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .chip.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  /* Article Grid */
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-8);
  }

  .article-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .card-image {
    width: 100%;
    height: 220px;
    background: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--color-border-light);
  }

  .card-image span {
    color: #64748b;
    font-weight: 600;
    font-size: 1.1rem;
  }

  .card-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-3);
  }

  .tag-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    background: rgba(139, 0, 0, 0.05);
    padding: 4px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .card-content h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    line-height: 1.4;
  }

  .card-content h2 a {
    color: inherit;
    text-decoration: none;
  }

  .card-content h2 a:hover {
    color: var(--color-primary);
  }

  .card-content p {
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: 1.6;
    margin-bottom: var(--space-5);
    flex: 1;
  }

  .read-more {
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--text-md);
    margin-top: auto;
  }

  /* No Results */
  .no-results {
    text-align: center;
    padding: 60px 0;
    color: var(--color-text-muted);
  }
  
  .no-results.hidden {
    display: none;
  }

  .no-results svg {
    margin-bottom: 16px;
    color: var(--color-border-light);
  }
</style>

<script>
  // Fitur Pencarian Pintar (Client-side)
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchInput');
    const chips = document.querySelectorAll('.chip');
    const cards = document.querySelectorAll('.article-card');
    const noResults = document.getElementById('noResults');
    let currentFilter = 'all';

    function filterArticles() {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const excerpt = card.getAttribute('data-excerpt') || '';
        const tags = card.getAttribute('data-tags') || '';
        
        // Cek apakah cocok dengan input pencarian
        const matchesSearch = title.includes(query) || excerpt.includes(query) || tags.includes(query);
        
        // Cek apakah cocok dengan filter tombol (chip)
        const matchesFilter = currentFilter === 'all' || tags.includes(currentFilter);

        if (matchesSearch && matchesFilter) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Tampilkan pesan jika kosong
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    // Event Listener untuk Input Ketikan
    if(searchInput) {
      searchInput.addEventListener('input', filterArticles);
    }

    // Event Listener untuk Tombol Filter
    chips.forEach(chip => {
      chip.addEventListener('click', (e) => {
        // Update active class
        chips.forEach(c => c.classList.remove('active'));
        e.target.classList.add('active');
        
        // Update filter & render ulang
        currentFilter = e.target.getAttribute('data-filter');
        filterArticles();
      });
    });
  });
</script>
