---
import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="FAQ - Tanya Jawab Bore Pile" description="Pertanyaan yang Sering Diajukan mengenai Jasa Bore Pile & Strauss Pile Aseven Pile.">
  <div class="container text-center" style="padding-top: 120px; max-width: 650px;">
      <div class="section-title text-center" style="margin-bottom: 40px;"><h1 style="font-size: 1.5rem; font-weight: 600; color: var(--color-text); margin-bottom: 8px;">Tanya Jawab (FAQ)</h1>
      <p style="font-size: 0.9rem; color: var(--color-text-muted);">Aturan main, teknis pengerjaan, dan informasi harga.</p></div>
      
      <!-- Search Box -->
      <div class="search-container">
        <div class="search-box">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" id="faqSearch" placeholder="Cari pertanyaan... (misal: lumpur, minimum, harga)" autocomplete="off" />
        </div>
      </div>

      <!-- Filter Chips -->
      <div class="problem-filters">
        <div class="filter-chips">
          <button class="chip active" data-filter="all">Semua</button>
          <button class="chip" data-filter="bore-pile">Bore Pile</button>
          <button class="chip" data-filter="strauss-pile">Strauss Pile</button>
          <button class="chip" data-filter="harga">Biaya & Harga</button>
          <button class="chip" data-filter="teknis">Teknis Lapangan</button>
          <button class="chip" data-filter="umum">Umum</button>
        </div>
      </div>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="container" style="max-width: 650px;">
      
      <div id="noResults" class="no-results hidden">
        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <h3>Pertanyaan Tidak Ditemukan</h3>
        <p>Coba gunakan kata kunci lain.</p>
      </div>

      <faq-accordion class="faq-accordion" id="faqContainer">
        
        <!-- FAQ 1: Minimum Order -->
        <div class="faq-item" data-category="harga bore-pile strauss-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Berapa minimum order / volume pengerjaan?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Aturan minimum order kami: <strong>200 meter</strong> untuk Bore Pile Mesin, dan <strong>100 meter</strong> untuk Strauss Pile Manual. Kalau volume proyek Anda di bawah angka tersebut tetap bisa kami kerjakan, tapi hitungannya masuk ke harga borongan minimum.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 2: Harga -->
        <div class="faq-item" data-category="harga bore-pile strauss-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Berapa harga jasa per meter?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Harga jasa bore pile mesin mulai dari <strong>Rp 139.000/m</strong> (diameter 30 cm) dan strauss pile manual mulai dari <strong>Rp 70.000/m</strong>. Biaya ini merupakan jasa bor saja (pengeboran, perakitan/pemasangan besi tulangan, dan pengecoran). Belum termasuk material (besi dan beton), mobilisasi alat, dan bak sirkulasi air.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 3: Akses -->
        <div class="faq-item" data-category="teknis bore-pile strauss-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Apakah alat bisa masuk jalan sempit di perumahan padat?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Untuk lokasi dengan akses sangat sempit (lebar jalan kurang dari 2,5 meter), pilihan terbaik adalah <strong>strauss pile manual</strong>. Sedangkan untuk mesin bore pile, alat diangkut menggunakan <strong>truk engkel</strong> sehingga membutuhkan akses jalan dan ruang manuver yang memadai bagi armada kami.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 4: Material -->
        <div class="faq-item" data-category="teknis bore-pile strauss-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Apakah harga sudah termasuk material (besi & cor beton)?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Kami melayani paket <strong>jasa bor saja</strong> maupun <strong>jasa plus material (all-in besi & beton)</strong>. Untuk paket material, kebutuhan spesifikasi besi dan mutu beton (ready mix atau site mix) mengikuti gambar kerja serta desain struktur dari konsultan perencana Anda.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 5: Pembuangan Tanah -->
        <div class="faq-item" data-category="teknis bore-pile strauss-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Bagaimana urusan buang tanah sisa galian / lumpur?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Pada metode bor basah (wash boring), lumpur hasil pengeboran ditampung di bak sirkulasi dan perlu disedot/dibuang. Kami dapat membantu menyediakan armada pengangkut lumpur dari lokasi proyek dengan biaya tambahan tersendiri di luar harga jasa bor.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 6: Mobilisasi -->
        <div class="faq-item" data-category="harga bore-pile strauss-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Apakah ada biaya tambahan seperti mobilisasi alat?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p><strong>Ada.</strong> Biaya mobilisasi pengiriman alat menggunakan truk engkel dipisah dari harga meteran. Besaran biaya menyesuaikan jarak lokasi proyek dari pool kami.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 7: Kecepatan Kerja -->
        <div class="faq-item" data-category="teknis bore-pile strauss-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Berapa lama estimasi proses pengerjaannya?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Sangat bergantung pada cuaca, kondisi tanah, dan suplai material. Estimasi kasarnya: Strauss Pile manual sekitar 8-15 meter per hari per tim. Bore Pile Mesin sekitar 20-40 meter per hari. Jadwal pasti akan disepakati pasca survei.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 8: Survei -->
        <div class="faq-item" data-category="umum bore-pile strauss-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Apakah survei lokasi berbayar?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Survei dilakukan <strong>setelah harga disepakati</strong>. Kami tidak melakukan survei sebelum ada kesepakatan penawaran harga. Setelah deal, tim kami turun ke lapangan untuk mengecek akses jalan, kesiapan lahan, dan titik bor.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 9: Kedalaman Mesin -->
        <div class="faq-item" data-category="teknis bore-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Berapa kedalaman maksimal untuk Bore Pile Mesin?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Menggunakan mesin mini crane maupun gawangan, kami bisa mengebor hingga kedalaman <strong>20-30 meter</strong> pada kondisi tanah normal, dan sanggup menembus lapisan tanah keras yang ditentukan konsultan perencana.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 10: Kedalaman Manual -->
        <div class="faq-item" data-category="teknis strauss-pile">
          <button class="faq-question" aria-expanded="false">
            <span>Berapa kedalaman maksimal untuk Strauss Pile Manual?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Karena mengandalkan tenaga manusia murni, kedalaman maksimal Strauss Pile umumnya di <strong>6-8 meter</strong>, tergantung kekerasan tanah. Begitu ketemu lapisan cadas/tanah keras, pengeboran manual akan dihentikan.</p>
            </div>
          </div>
        </div>
      </faq-accordion>

    </div>
  </section>

</BaseLayout>

<style>
  

  

  

  .search-container {
    max-width: 700px;
    margin: 0 auto 30px;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border: 2px solid var(--color-border-light);
    border-radius: 50px;
    padding: 8px 24px;
    transition: all 0.2s ease;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  }

  .search-box:focus-within {
    border-color: var(--color-primary);
  }

  .search-box svg {
    color: var(--color-text-muted);
    margin-right: 12px;
  }

  .search-box input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 12px 0;
    font-size: 1.1rem;
    color: var(--color-text);
    outline: none;
  }

  .problem-filters {
    display: flex;
    justify-content: center;
    margin-bottom: 60px;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .chip {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .chip:hover, .chip.active {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .chip.active {
    background: var(--color-primary);
    color: white;
  }

  .no-results {
    text-align: center;
    padding: 40px 20px;
    color: var(--color-text-muted);
  }
  
  .no-results.hidden {
    display: none;
  }
  
  .no-results svg {
    margin-bottom: 16px;
    opacity: 0.5;
  }

  /* FAQ Accordion Styles */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border-light);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border-light);
    background: transparent;
    transition: opacity 0.3s ease;
  }

  .faq-question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 18px 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text);
    font-family: inherit;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.3s ease;
  }

  .faq-question:hover {
    color: var(--color-primary);
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-question[aria-expanded="true"] {
    color: var(--color-primary);
  }

  .faq-question[aria-expanded="true"] .faq-icon {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq-answer-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-answer-wrapper.open {
    grid-template-rows: 1fr;
  }

  .faq-answer {
    overflow: hidden;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 0 20px 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 95%;
  }
</style>

<script>
  class FaqAccordion extends HTMLElement {
    constructor() {
      super();
      // Setup Accordion Logic
      setTimeout(() => {
        const questions = this.querySelectorAll('.faq-question');
        
        questions.forEach(question => {
          question.addEventListener('click', () => {
            const isExpanded = question.getAttribute('aria-expanded') === 'true';
            const wrapper = question.nextElementSibling;
            
            // Tutup semua yang lain
            this.querySelectorAll('.faq-question').forEach(q => {
              q.setAttribute('aria-expanded', 'false');
              if(q.nextElementSibling) q.nextElementSibling.classList.remove('open');
            });

            // Buka yang di-klik
            if (!isExpanded) {
              question.setAttribute('aria-expanded', 'true');
              if(wrapper) wrapper.classList.add('open');
            }
          });
        });
      }, 50);
    }
  }
  
  if (!customElements.get('faq-accordion')) {
    customElements.define('faq-accordion', FaqAccordion);
  }

  // Setup Search and Filter Logic
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('faqSearch');
    const chips = document.querySelectorAll('.chip');
    const faqItems = Array.from(document.querySelectorAll('.faq-item'));
    const noResults = document.getElementById('noResults');
    const faqContainer = document.getElementById('faqContainer');

    let currentFilter = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;

      faqItems.forEach(item => {
        const questionText = item.querySelector('.faq-question span').textContent.toLowerCase();
        const answerText = item.querySelector('.faq-answer p').textContent.toLowerCase();
        const category = item.getAttribute('data-category');
        
        const matchesSearch = questionText.includes(searchQuery) || answerText.includes(searchQuery);
        const matchesFilter = currentFilter === 'all' || category.split(' ').includes(currentFilter);

        if (matchesSearch && matchesFilter) {
          item.style.display = 'block';
          // Animasi fade in
          setTimeout(() => item.style.opacity = '1', 10);
          visibleCount++;
        } else {
          item.style.opacity = '0';
          setTimeout(() => item.style.display = 'none', 300);
        }
      });

      // Handle empty state
      if (visibleCount === 0) {
        setTimeout(() => {
          noResults.classList.remove('hidden');
          faqContainer.style.display = 'none';
        }, 300);
      } else {
        noResults.classList.add('hidden');
        faqContainer.style.display = 'flex';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        applyFilters();
      });
    }

    chips.forEach(chip => {
      chip.addEventListener('click', (e) => {
        chips.forEach(c => c.classList.remove('active'));
        e.target.classList.add('active');
        
        currentFilter = e.target.getAttribute('data-filter');
        applyFilters();
      });
    });
  });
</script>



