---
import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="FAQ - Tanya Jawab Bore Pile" description="Pertanyaan yang Sering Diajukan mengenai Jasa Bore Pile & Strauss Pile Aseven Pile.">
  <div class="page-header">
    <div class="container text-center">
      <h1>Tanya Jawab (FAQ)</h1>
      <p class="subtitle">Aturan main, teknis pengerjaan, dan informasi harga.</p>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="container" style="max-width: 750px;">
      
      <faq-accordion class="faq-accordion">
        
        <!-- FAQ 1: Minimum Order -->
        <div class="faq-item">
          <button class="faq-question" aria-expanded="true">
            <span>Berapa minimum order / volume pengerjaan?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper open">
            <div class="faq-answer">
              <p>Aturan minimum order kami: <strong>200 meter</strong> untuk Bore Pile Mesin, dan <strong>100 meter</strong> untuk Strauss Pile Manual. Kalau volume proyek Anda di bawah angka tersebut tetap bisa kami kerjakan, tapi hitungannya masuk ke harga borongan minimum (lump sum).</p>
            </div>
          </div>
        </div>

        <!-- FAQ 2: Harga -->
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Berapa harga jasa per meter?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Sebagai patokan, harga dasar jasa mulai dari <strong>Rp 70.000/m</strong> untuk manual (Strauss) dan <strong>Rp 150.000/m</strong> untuk Mesin. Tapi harga ini <strong>belum fix</strong>. Harga final sangat tergantung pada kedalaman, diameter, kondisi tanah keras/batu, dan akses masuk alat. Cek <a href="/harga" style="color: var(--color-primary); text-decoration: underline;">Kalkulator Harga</a> untuk estimasi lebih detail.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 3: Akses -->
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Apakah alat bisa masuk jalan sempit di perumahan padat?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p><strong>Sangat bisa.</strong> Kami menggunakan alat dengan sistem <em>knock-down</em> (bongkar pasang). Mesin Gawangan atau Mini Crane kami bisa diangkut pakai mobil pick-up, lalu dipreteli dan dipanggul manual ke dalam gang sempit atau bahkan di dalam bangunan yang sudah jadi.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 4: Material -->
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Apakah harga sudah termasuk material (besi & cor beton)?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Fokus utama kami adalah penyedia <strong>jasa pengeboran (alat & tenaga)</strong>. Namun, kalau Anda butuh paket "Terima Beres" (Jasa + Besi + Beton Ready Mix), kami bisa buatkan RAB lengkapnya setelah survei dan cek gambar rencana struktur (DED).</p>
            </div>
          </div>
        </div>

        <!-- FAQ 5: Pembuangan Tanah -->
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Bagaimana urusan buang tanah sisa galian / lumpur?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Pengangkutan dan pembuangan tanah lumpur sisa galian (loading) adalah <strong>tanggung jawab kontraktor utama atau pemilik lahan</strong>. Kami sebatas menumpuk galian di dekat lubang bor. Kalau butuh, kami bisa bantu panggilkan armada angkut, tapi biayanya di luar kontrak bor.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 6: Mobilisasi -->
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Apakah ada biaya tambahan seperti mobilisasi alat?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p><strong>Ada.</strong> Biaya mobilisasi & demobilisasi (mob-demob) alat selalu dipisah dari harga meteran. Besaran biayanya dihitung berdasarkan jarak dari pool kami ke lokasi proyek Anda. Untuk area Jabodetabek ada tarif standarnya, untuk luar kota akan dihitung terpisah.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 7: Kecepatan Kerja -->
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Berapa lama estimasi proses pengerjaannya?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Sangat bergantung pada cuaca, kondisi tanah, dan suplai material. Estimasi kasarnya: Strauss Pile manual sekitar 8-15 meter per hari per tim. Bore Pile Mesin sekitar 20-40 meter per hari. Jadwal pasti akan disepakati pasca survei.</p>
            </div>
          </div>
        </div>

        <!-- FAQ 8: Survei -->
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Apakah survei lokasi berbayar?</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Survei lokasi <strong>GRATIS</strong> untuk area Jabodetabek. Tapi survei baru kami lakukan <strong>setelah ada kesepakatan harga indikatif</strong>. Tim turun ke lapangan murni untuk cek teknis (akses manuver alat, sumber air, cek tanah) dan mematangkan rencana kerja, bukan untuk nego harga dari nol.</p>
            </div>
          </div>
        </div>

      </faq-accordion>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    padding: 120px 0 60px;
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-8);
  }

  .page-header h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin-bottom: var(--space-4);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Persis dari FAQSection.astro */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border-light);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border-light);
    background: transparent;
  }

  .faq-question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 20px 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    font-family: inherit;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.3s ease;
  }

  .faq-question:hover {
    color: var(--color-primary);
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-question[aria-expanded="true"] {
    color: var(--color-primary);
  }

  .faq-question[aria-expanded="true"] .faq-icon {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq-answer-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-answer-wrapper.open {
    grid-template-rows: 1fr;
  }

  .faq-answer {
    overflow: hidden;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 0 24px 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 95%;
  }
</style>

<script>
  class FaqAccordion extends HTMLElement {
    constructor() {
      super();
      // Gunakan setTimeout supaya web component punya waktu untuk mount ke DOM
      setTimeout(() => {
        const questions = this.querySelectorAll('.faq-question');
        
        questions.forEach(question => {
          question.addEventListener('click', () => {
            const isExpanded = question.getAttribute('aria-expanded') === 'true';
            const wrapper = question.nextElementSibling;
            
            // Tutup semua yang lain
            this.querySelectorAll('.faq-question').forEach(q => {
              q.setAttribute('aria-expanded', 'false');
              if(q.nextElementSibling) q.nextElementSibling.classList.remove('open');
            });

            // Buka yang di-klik
            if (!isExpanded) {
              question.setAttribute('aria-expanded', 'true');
              if(wrapper) wrapper.classList.add('open');
            }
          });
        });
      }, 50);
    }
  }
  
  if (!customElements.get('faq-accordion')) {
    customElements.define('faq-accordion', FaqAccordion);
  }
</script>
