---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ContactSection from '../../components/ui/ContactSection.astro';
---

<BaseLayout 
  title="Hubungi Kami" 
  description="Hubungi Aseven Pile. Langsung kirim detail proyek untuk hitung harga dan jadwal survei lapangan."
>
  <div style="padding-top: 100px;">
    <!-- Section Kontak Utama -->
    <ContactSection hideLink={true} />
  </div>

        <!-- Section Peta -->
  <section class="section" style="padding-top: var(--space-4); padding-bottom: var(--space-12);">
    <div class="container map-container">
      <div class="map-card">
        <iframe src="https://maps.google.com/maps?q=-6.1627854,107.0076685&amp;t=k&amp;hl=id&amp;z=17&amp;output=embed" class="map-iframe"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
      <div class="map-caption">
        Setia Asih, Kec. Tarumajaya, Kabupaten Bekasi, Jawa Barat 17215
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .map-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .map-card {
    width: 100%;
    aspect-ratio: 4 / 3; /* More square-ish but still landscape enough */
    height: auto;
    border-radius: var(--radius-md); /* Agak kotak, ujung tidak terlalu membulat */
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    border: 1px solid var(--color-border-light);
  }

  @media (max-width: 768px) {
    .map-card {
      aspect-ratio: 1 / 1; /* Benar-benar kotak di HP */
    }
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: none;
    filter: contrast(1.1) saturate(1.1);
  }

  .map-caption {
    text-align: center;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 500;
  }
</style>







