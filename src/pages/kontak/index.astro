---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ContactSection from '../../components/ui/ContactSection.astro';
---

<BaseLayout 
  title="Hubungi Kami" 
  description="Hubungi Aseven Pile. Langsung kirim detail proyek untuk hitung harga dan jadwal survei lapangan."
>
  <div style="padding-top: 100px;">
    <!-- Section Kontak Utama -->
    <ContactSection hideLink={true} />
  </div>

  <!-- Section Peta -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="section-title">
        <h2>Lokasi Kami</h2>
      </div>

      <div class="map-card">
        <iframe src="https://maps.google.com/maps?q=-6.1627854,107.0076685&amp;hl=id&amp;z=15&amp;output=embed" class="map-iframe"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .map-card {
    width: 100%;
    height: 420px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>




