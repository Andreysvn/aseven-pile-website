---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ContactSection from '../../components/ui/ContactSection.astro';
import PremiumCTA from '../../components/ui/PremiumCTA.astro';
---

<BaseLayout 
  title="Hubungi Kami" 
  description="Hubungi Aseven Pile. Langsung kirim detail proyek untuk hitung harga dan jadwal survei lapangan."
>
  <div style="padding-top: 100px;">
    <!-- Section Kontak Utama -->
    <ContactSection hideLink={true} />
  </div>

  <!-- Section Peta -->
  <section class="section" style="padding-top: 0; padding-bottom: var(--space-8);">
    <div class="container map-container">
      <div class="map-wrapper">
        <div class="map-card">
          <iframe src="https://maps.google.com/maps?q=-6.1627854,107.0076685&amp;t=k&amp;hl=id&amp;z=17&amp;output=embed" class="map-iframe"
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
        <div class="map-address-bar">
          <strong>Lokasi:</strong> Setia Asih, Kec. Tarumajaya, Kabupaten Bekasi, Jawa Barat 17215
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Bawah -->
  <PremiumCTA />
</BaseLayout>

<style>
  .map-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .map-wrapper {
    background: var(--color-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .map-card {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    position: relative;
  }

  @media (max-width: 768px) {
    .map-card {
      aspect-ratio: 1 / 1;
    }
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: none;
    filter: contrast(1.1) saturate(1.1);
  }

  .map-address-bar {
    padding: var(--space-4);
    text-align: center;
    border-top: 1px solid var(--color-border-light);
    font-size: var(--text-md);
    color: var(--color-text-main);
  }
</style>
