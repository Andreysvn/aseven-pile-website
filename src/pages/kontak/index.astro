---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ContactSection from '../../components/ui/ContactSection.astro';
---

<BaseLayout 
  title="Hubungi Kami" 
  description="Hubungi ASeven Pile untuk konsultasi, harga, dan jadwal survei lapangan pondasi bore pile atau strauss pile."
>
  <!-- Hero Inner Page -->
  <section class="section section-bg-alt" style="padding-top: 140px; padding-bottom: var(--space-8); text-align: center; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <h1 style="font-size: var(--text-4xl); margin-bottom: var(--space-4); color: var(--color-text);">Konsultasikan Proyek Pondasi Anda</h1>
      <p style="font-size: var(--text-lg); color: var(--color-text-muted); max-width: 640px; margin: 0 auto;">
        Tim teknis kami siap memberikan estimasi harga terbaik dan menjadwalkan survei lokasi secara gratis.
      </p>
    </div>
  </section>

  <!-- Section Kontak Utama -->
  <ContactSection hideLink={true} />

  <!-- Section Peta (Simple & Clean) -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="section-title">
        <h2>Lokasi Kantor</h2>
      </div>

      <div class="map-card">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126920.24046422325!2d106.7583685!3d-6.2297465!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3e945e34b9d%3A0x5371bf0fdad786a2!2sJakarta%2C%20Daerah%20Khusus%20Ibukota%20Jakarta!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid" 
          class="map-iframe"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .map-card {
    width: 100%;
    height: 420px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
