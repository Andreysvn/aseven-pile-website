---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ContactSection from '../../components/ui/ContactSection.astro';
---

<BaseLayout 
  title="Hubungi Kami" 
  description="Hubungi Aseven Pile. Langsung kirim detail proyek untuk hitung harga dan jadwal survei lapangan."
>
  <div style="padding-top: 100px;">
    <!-- Section Kontak Utama -->
    <ContactSection hideLink={true} />
  </div>

  <!-- Section Peta -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="section-title">
        <h2>Lokasi Kami</h2>
      </div>

      <div class="map-card">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126920.24046422325!2d106.7583685!3d-6.2297465!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3e945e34b9d%3A0x5371bf0fdad786a2!2sJakarta%2C%20Daerah%20Khusus%20Ibukota%20Jakarta!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid" 
          class="map-iframe"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .map-card {
    width: 100%;
    height: 420px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>



