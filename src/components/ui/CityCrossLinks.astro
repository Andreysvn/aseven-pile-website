---
import { SERVICE_CITIES } from '../../data/seo-data';

export interface Props {
  currentSlug: string;
  serviceType?: 'bore-pile' | 'strauss-pile';
  serviceName?: string;
}

const { 
  currentSlug, 
  serviceType = 'bore-pile',
  serviceName = 'Bore Pile'
} = Astro.props;

// Filter out the current city and sub-regions (like jakarta-selatan)
const allowedStrauss = ['jakarta', 'bekasi'];
const otherCities = SERVICE_CITIES.filter(c => {
  if (serviceType === 'strauss-pile' && !allowedStrauss.includes(c.slug)) return false;
  if (c.slug === currentSlug) return false;
  if (c.slug.startsWith('jakarta-')) return false;
  return true;
});
---

<div class="cll-wrapper">
  <p class="cll-label">
    Layanan {serviceName} di Area Lain:
  </p>
  <ul class="cll-list">
    {otherCities.map((city, index) => (
      <li>
        <a 
          href={`/area-layanan/${serviceType}/${city.slug}`} 
          class="hover-link"
        >
          {city.name}
        </a>
        {index < otherCities.length - 1 && <span class="cll-sep">&bull;</span>}
      </li>
    ))}
  </ul>
</div>

<style>
  .cll-wrapper {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border-light);
  }

  .cll-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 12px;
  }

  .cll-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
  }

  .cll-list li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cll-list a {
    font-size: 0.95rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  .cll-sep {
    color: #cbd5e1;
    font-size: 0.8rem;
  }

  .hover-link:hover {
    opacity: 0.8;
  }
</style>
