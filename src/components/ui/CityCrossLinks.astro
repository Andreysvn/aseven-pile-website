---
import { SERVICE_CITIES } from '../../data/seo-data';

export interface Props {
  currentSlug: string;
  serviceType?: 'bore-pile' | 'strauss-pile';
  serviceName?: string;
}

const { 
  currentSlug, 
  serviceType = 'bore-pile',
  serviceName = 'Bore Pile'
} = Astro.props;

// Filter out the current city and sub-regions (like jakarta-selatan)
const otherCities = SERVICE_CITIES.filter(c => {
  if (c.slug === currentSlug) return false;
  if (c.slug.startsWith('jakarta-')) return false;
  return true;
});
---

<div style="margin-top: 32px; padding-top: 24px; border-top: 1px dashed var(--color-border-light);">
  <p style="font-size: 0.95rem; font-weight: 600; color: #334155; margin-bottom: 12px;">
    Layanan {serviceName} di Area Lain:
  </p>
  <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center;">
    {otherCities.map((city, index) => (
      <li style="display: flex; align-items: center; gap: 12px;">
        <a 
          href={`/area-layanan/${serviceType}/${city.slug}`} 
          style="font-size: 0.95rem; color: var(--color-primary); text-decoration: underline; text-underline-offset: 2px; font-weight: 500;"
          class="hover-link"
        >
          {city.name}
        </a>
        {index < otherCities.length - 1 && <span style="color: #94a3b8; font-size: 0.8rem;">&bull;</span>}
      </li>
    ))}
  </ul>
</div>

<style>
  .hover-link:hover {
    color: #0f172a !important;
  }
</style>
