---
import type { MethodComparisonSection } from '../../data/diameter-data';

interface Props {
  data: MethodComparisonSection;
}

const { data } = Astro.props;
---

<section class="ls-section ls-method-comparison-section">
  <h2 class="ls-sec-title">{data.title}</h2>
  <p class="ls-intro-p">{data.intro}</p>

  <div class="ls-method-grid">
    <div class="ls-method-card ls-method-card-primary">
      <h3 class="ls-method-card-title">{data.primaryTitle}</h3>
      <p class="ls-method-card-desc"><Fragment set:html={data.primaryDesc} /></p>
    </div>

    <div class="ls-method-card ls-method-card-secondary">
      <h3 class="ls-method-card-title">{data.secondaryTitle}</h3>
      <p class="ls-method-card-desc"><Fragment set:html={data.secondaryDesc} /></p>
    </div>
  </div>

  {data.sensibleItems && data.sensibleItems.length > 0 && (
    <div class="ls-sensible-box">
      {data.sensibleTitle && (
        <h3 class="ls-sensible-title">{data.sensibleTitle}</h3>
      )}
      <ul class="ls-sensible-list">
        {data.sensibleItems.map((item) => (
          <li>
            <strong>{item.label}</strong> <Fragment set:html={item.text} />
          </li>
        ))}
      </ul>
      {data.conclusion && (
        <p class="ls-sensible-conclusion">
          <Fragment set:html={data.conclusion} />
        </p>
      )}
    </div>
  )}
</section>

