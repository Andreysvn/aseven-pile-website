---
import { siteConfig } from '../../data/site.config';

interface Props {
  hideLink?: boolean;
}

const { hideLink = false } = Astro.props;
---

<section class="section section-bg-alt" id="kontak">
  <div class="container">
    <div class="contact-wrapper">
      
      <!-- Kiri: Info Kontak -->
      <div class="contact-info">
        <h2>Hubungi Aseven Pile</h2>
        <p>Hubungi kami, kirimkan detail kebutuhan Anda.</p>
        
        <ul class="contact-list">
                              <li>
            <div class="icon-wrapper">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <strong>Alamat</strong>
              <span style="display: block; line-height: 1.4;">Setia Asih, Kec. Tarumajaya, Kabupaten Bekasi, Jawa Barat 17215</span>
            </div>
          </li>
          <li>
            <div class="icon-wrapper">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <strong>WhatsApp / Telepon</strong>
              <span>{siteConfig.phone}</span>
            </div>
          </li>
          <li>
            <div class="icon-wrapper">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <strong>Email</strong>
              <span>{siteConfig.email}</span>
            </div>
          </li>
          <li>
            <div class="icon-wrapper">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong>Jam Operasional</strong>
              <span>Buka 24 Jam</span>
            </div>
          </li>
          <li>
            <div class="icon-wrapper">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <strong>Area Layanan</strong>
              <span>Jabodetabek & Seluruh Pulau Jawa</span>
            </div>
          </li>
        </ul>
        
        {!hideLink && (
          <div style="margin-top: var(--space-6);">
            <a href="/kontak" class="btn btn-outline" style="width: 100%; justify-content: center;">Lihat Alamat & Lokasi Map &rarr;</a>
          </div>
        )}
      </div>

            <!-- Kanan: Peta Lokasi -->
      <div class="map-card-elegant">
        <iframe src="https://maps.google.com/maps?q=-6.1627854,107.0076685&amp;t=k&amp;hl=id&amp;z=17&amp;output=embed" class="map-iframe-elegant"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>
</section>







<style>
  .map-card-elegant {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    border: 1px solid var(--color-border-light);
    background: var(--color-bg-alt);
  }
  .map-iframe-elegant {
    width: 100%;
    height: 100%;
    border: none;
    filter: contrast(1.1) saturate(1.1);
  }
  @media (max-width: 768px) {
    .map-card-elegant {
      margin-top: var(--space-8);
    }
  }
</style>
