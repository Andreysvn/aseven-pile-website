---
export interface Props {
  hideTitle?: boolean;
  noPaddingTop?: boolean;
}

const { hideTitle = false, noPaddingTop = false } = Astro.props;

import citiesData from '../../data/cities.json';

// Create a Set of available slugs for fast lookup
const availableCitySlugs = new Set(citiesData.filter((c: any) => !c.draft).map(c => c.slug));

const getCityState = (name: string) => {
  const slug = name.toLowerCase().replace(/\s+/g, '-');
  return { name, slug, active: availableCitySlugs.has(slug) };
};

const jabodetabek = ["Jakarta", "Bogor", "Depok", "Tangerang", "Tangerang Selatan", "Bekasi"].map(getCityState);
const jawaBarat = ["Serang", "Cilegon", "Bandung", "Cimahi", "Cirebon", "Sukabumi", "Tasikmalaya", "Banjar", "Karawang", "Purwakarta", "Subang", "Garut", "Cianjur", "Indramayu"].map(getCityState);
const jawaTengah = ["Yogyakarta", "Semarang", "Surakarta (Solo)", "Magelang", "Salatiga", "Tegal", "Pekalongan", "Purwokerto", "Cilacap", "Kudus", "Jepara", "Klaten", "Boyolali"].map(getCityState);
const jawaTimur = ["Surabaya", "Sidoarjo", "Gresik", "Malang", "Batu", "Mojokerto", "Pasuruan", "Probolinggo", "Kediri", "Madiun", "Blitar", "Jember", "Banyuwangi", "Tuban", "Bojonegoro", "Madura"].map(getCityState);
---

<section class={`section section-bg-alt ${noPaddingTop ? 'pt-0' : ''}`} id="area" style={noPaddingTop ? "padding-top: 0;" : ""}>
  <div class="container">
    {!hideTitle && (
      <div class="section-title">
        <h2>Jangkauan Mobilisasi Alat</h2>
        <p>Mesin mini crane, mesin gawangan, dan kru strauss pile kami siap dimobilisasi ke seluruh proyek konstruksi Anda di Pulau Jawa.</p>
      </div>
    )}

    <!-- Smart Search Bar -->
    <div style="max-width: 500px; margin: 0 auto var(--space-8) auto; position: relative;">
      <input 
        type="text" 
        id="citySearch" 
        placeholder="Cari nama kota Anda... (misal: Bogor, Surabaya)" 
        style="width: 100%; padding: 14px 20px 14px 44px; border-radius: 30px; border: 2px solid var(--color-border-light); font-size: 1rem; outline: none; transition: border-color 0.2s;"
      >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" style="position: absolute; left: 16px; top: 15px;">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
    
    <div class="region-grid" id="regionGridContainer">
      
      <!-- JABODETABEK -->
      <div class="region-card">
        <h3>Jabodetabek</h3>
        <ul class="region-list">
          {jabodetabek.map(city => (
            city.active 
              ? <li><a href={`/area-layanan/${city.slug}`} class="city-link">{city.name}</a></li> 
              : <li>{city.name}</li>
          ))}
        </ul>
      </div>

      <!-- BANTEN & JAWA BARAT -->
      <div class="region-card">
        <h3>Banten & Jawa Barat</h3>
        <ul class="region-list">
          {jawaBarat.map(city => (
            city.active 
              ? <li><a href={`/area-layanan/${city.slug}`} class="city-link">{city.name}</a></li> 
              : <li>{city.name}</li>
          ))}
        </ul>
      </div>

      <!-- JAWA TENGAH & DIY -->
      <div class="region-card">
        <h3>Jawa Tengah & DIY</h3>
        <ul class="region-list">
          {jawaTengah.map(city => (
            city.active 
              ? <li><a href={`/area-layanan/${city.slug}`} class="city-link">{city.name}</a></li> 
              : <li>{city.name}</li>
          ))}
        </ul>
      </div>

      <!-- JAWA TIMUR -->
      <div class="region-card">
        <h3>Jawa Timur</h3>
        <ul class="region-list">
          {jawaTimur.map(city => (
            city.active 
              ? <li><a href={`/area-layanan/${city.slug}`} class="city-link">{city.name}</a></li> 
              : <li>{city.name}</li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .region-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .region-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .region-card {
    background: var(--color-bg);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
  }

  .region-card h3 {
    color: var(--color-primary);
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 2px dashed var(--color-border-light);
  }

  .region-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .region-list li {
    background: var(--color-bg-alt);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-light);
  }

  /* Hilangkan style default li jika didalamnya ada link aktif */
  .region-list li:has(.city-link) {
    padding: 0;
    border: none;
    background: transparent;
  }

  .city-link {
    display: block;
    background: #fff1f2;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    color: #800000;
    border: 1px solid #fecdd3;
    transition: all 0.2s ease;
    text-decoration: none;
    font-weight: 700;
  }

  .city-link:hover {
    background: #800000;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(128, 0, 0, 0.2);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('citySearch');
    const regionCards = document.querySelectorAll('.region-card');
    
    if (!searchInput) return;

    // Optional: Add focus style logic
    searchInput.addEventListener('focus', () => {
      searchInput.style.borderColor = 'var(--color-primary)';
    });
    searchInput.addEventListener('blur', () => {
      searchInput.style.borderColor = 'var(--color-border-light)';
    });

    searchInput.addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase();
      
      regionCards.forEach(card => {
        let hasVisibleCity = false;
        const cities = card.querySelectorAll('li');
        
        cities.forEach(city => {
          const cityName = city.textContent.toLowerCase();
          if (cityName.includes(searchTerm)) {
            city.style.display = '';
            hasVisibleCity = true;
          } else {
            city.style.display = 'none';
          }
        });
        
        // Hide the entire region card if no cities match
        if (hasVisibleCity) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
