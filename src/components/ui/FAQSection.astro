---
// FAQSection.astro
export interface Props {
  title?: string;
  subtitle?: string;
  faqs?: { question: string; answer: string }[];
}

const {
  title = 'FAQ',
  subtitle = 'Informasi teknis dan operasional pengeboran.',
  faqs = [
    { question: 'Berapa harga jasa bore pile per meternya?', answer: 'Harga kami mulai dari <strong>Rp 70.000/m</strong> untuk manual (Strauss) dan <strong>Rp 150.000/m</strong> untuk Mesin. Harga final menyesuaikan hasil survei lapangan. Anda dapat mengecek kalkulator harga di halaman area layanan terdekat Anda.' },
    { question: 'Apakah alat bisa masuk ke akses jalan sempit?', answer: '<strong>Sangat bisa.</strong> Alat Strauss Pile dan Mesin Gawangan kami dirancang <em>knock-down</em>, ideal untuk area padat penduduk yang tidak bisa dilewati truk besar.' },
    { question: 'Apakah menyediakan material (besi & beton)?', answer: 'Fokus utama kami adalah penyediaan <strong>jasa dan alat bor</strong>. Namun kami dapat melayani sistem borongan "Terima Beres" setelah melakukan kalkulasi struktur.' },
    { question: 'Bagaimana pembuangan tanah lumpur sisa galian?', answer: 'Umumnya, manajemen sisa galian adalah tanggung jawab kontraktor utama/pemilik lahan. Tetapi kami siap membantu memanggilkan armada angkut jika diperlukan.' }
  ]
} = Astro.props;
---

<section class="section faqs-transparent-bg" id="faq">
  <div class="container faqs-max-650">
    <div class="section-title text-center faqs-title-mb">
      <h2 class="faqs-h2">{title}</h2>
      <p class="faqs-sub">{subtitle}</p>
    </div>
    
    <faq-accordion class="faq-accordion">
      {faqs.map((faq, index) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded={index === 0 ? "true" : "false"}>
            <span>{faq.question}</span>
            <span class="faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class:list={["faq-answer-wrapper", { open: index === 0 }]}>
            <div class="faq-answer">
              <p set:html={faq.answer}></p>
            </div>
          </div>
        </div>
      ))}
    </faq-accordion>
  </div>
</section>

<style>
  .faqs-transparent-bg { background: transparent; }
  .container.faqs-max-650 { max-width: 650px; }
  .section-title.faqs-title-mb { margin-bottom: 40px; }
  .section-title h2.faqs-h2 { font-size: 1.5rem; font-weight: 600; color: var(--color-text); margin-bottom: 8px; }
  .section-title p.faqs-sub { font-size: 0.9rem; color: var(--color-text-muted); }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border-light);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border-light);
    background: transparent;
  }

  .faq-question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 18px 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text);
    font-family: inherit;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.3s ease;
  }

  .faq-question:hover {
    color: var(--color-primary);
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-question[aria-expanded="true"] {
    color: var(--color-primary);
  }

  .faq-question[aria-expanded="true"] .faq-icon {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq-answer-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-answer-wrapper.open {
    grid-template-rows: 1fr;
  }

  .faq-answer {
    overflow: hidden;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 0 20px 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 95%;
  }
</style>

<script>
  class FaqAccordion extends HTMLElement {
    constructor() {
      super();
      const questions = this.querySelectorAll('.faq-question');
      
      questions.forEach(question => {
        question.addEventListener('click', () => {
          const isExpanded = question.getAttribute('aria-expanded') === 'true';
          const wrapper = question.nextElementSibling;
          
          this.querySelectorAll('.faq-question').forEach(q => {
            q.setAttribute('aria-expanded', 'false');
            if(q.nextElementSibling) q.nextElementSibling.classList.remove('open');
          });

          if (!isExpanded) {
            question.setAttribute('aria-expanded', 'true');
            if(wrapper) wrapper.classList.add('open');
          }
        });
      });
    }
  }
  customElements.define('faq-accordion', FaqAccordion);
</script>
