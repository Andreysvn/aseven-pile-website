---
// FAQSection.astro
---

<section class="section" id="faq" style="background: transparent;">
  <div class="container" style="max-width: 650px;">
    <div class="section-title text-center" style="margin-bottom: 40px;">
      <h2 style="font-size: 1.5rem; font-weight: 600; color: var(--color-text); margin-bottom: 8px;">Tanya Jawab</h2>
      <p style="font-size: 0.9rem; color: var(--color-text-muted);">Informasi teknis dan operasional pengeboran.</p>
    </div>
    
    <faq-accordion class="faq-accordion">
      
      <div class="faq-item">
        <button class="faq-question" aria-expanded="true">
          <span>Berapa harga jasa bore pile per meternya?</span>
          <span class="faq-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </button>
        <div class="faq-answer-wrapper open">
          <div class="faq-answer">
            <p>Harga kami mulai dari <strong>Rp 70.000/m</strong> untuk manual (Strauss) dan <strong>Rp 150.000/m</strong> untuk Mesin. Harga final menyesuaikan hasil survei lapangan. Anda dapat mengecek <a href="/harga" style="color: var(--color-primary); text-decoration: underline;">Kalkulator Harga</a> kami.</p>
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>Apakah alat bisa masuk ke akses jalan sempit?</span>
          <span class="faq-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </button>
        <div class="faq-answer-wrapper">
          <div class="faq-answer">
            <p><strong>Sangat bisa.</strong> Alat Strauss Pile dan Mesin Gawangan kami dirancang <em>knock-down</em>, ideal untuk area padat penduduk yang tidak bisa dilewati truk besar.</p>
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>Apakah menyediakan material (besi & beton)?</span>
          <span class="faq-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </button>
        <div class="faq-answer-wrapper">
          <div class="faq-answer">
            <p>Fokus utama kami adalah penyediaan <strong>jasa dan alat bor</strong>. Namun kami dapat melayani sistem borongan "Terima Beres" setelah melakukan kalkulasi struktur.</p>
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>Bagaimana pembuangan tanah lumpur sisa galian?</span>
          <span class="faq-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </button>
        <div class="faq-answer-wrapper">
          <div class="faq-answer">
            <p>Umumnya, manajemen sisa galian adalah tanggung jawab kontraktor utama/pemilik lahan. Tetapi kami siap membantu memanggilkan armada angkut jika diperlukan.</p>
          </div>
        </div>
      </div>

    </faq-accordion>
  </div>
</section>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border-light);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border-light);
    background: transparent;
  }

  .faq-question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 18px 0;
    font-size: 0.95rem; /* ~15px - Sleek and modern */
    font-weight: 500;
    color: var(--color-text);
    font-family: inherit;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.3s ease;
  }

  .faq-question:hover {
    color: var(--color-primary);
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-question[aria-expanded="true"] {
    color: var(--color-primary);
  }

  .faq-question[aria-expanded="true"] .faq-icon {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq-answer-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-answer-wrapper.open {
    grid-template-rows: 1fr;
  }

  .faq-answer {
    overflow: hidden;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 0 20px 0;
    font-size: 0.85rem; /* ~13.6px - Perfect for reading */
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 95%;
  }
</style>

<script>
  class FaqAccordion extends HTMLElement {
    constructor() {
      super();
      const questions = this.querySelectorAll('.faq-question');
      
      questions.forEach(question => {
        question.addEventListener('click', () => {
          const isExpanded = question.getAttribute('aria-expanded') === 'true';
          const wrapper = question.nextElementSibling;
          
          this.querySelectorAll('.faq-question').forEach(q => {
            q.setAttribute('aria-expanded', 'false');
            if(q.nextElementSibling) q.nextElementSibling.classList.remove('open');
          });

          if (!isExpanded) {
            question.setAttribute('aria-expanded', 'true');
            if(wrapper) wrapper.classList.add('open');
          }
        });
      });
    }
  }
  customElements.define('faq-accordion', FaqAccordion);
</script>
