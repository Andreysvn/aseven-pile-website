---
import { pricingTiers, straussTiers, pricingConfig } from '../../data/pricing';

interface Props {
  method?: 'borepile' | 'strauss' | 'all';
  city?: string;
}

const { method = 'all', city } = Astro.props;
const showBore = method === 'all' || method === 'borepile';
const showStrauss = method === 'all' || method === 'strauss';
const year = new Date().getFullYear();
const cityLabel = city ? ` ${city}` : '';
---

<section class="section pricing-section" id="harga">
  <div class="container" style="max-width: 800px;">
    <div class="section-title">
      <h2>
        {method === 'borepile' && `Daftar Harga Jasa Bore Pile${cityLabel} ${year}`}
        {method === 'strauss' && `Daftar Harga Jasa Strauss Pile${cityLabel} ${year}`}
        {method === 'all' && `Daftar Harga Jasa Pengeboran${cityLabel} ${year}`}
      </h2>
      <p>Harga jasa per meter lari (m¹). Update terakhir: {new Date(pricingConfig.lastUpdated).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}.</p>
    </div>

    <div class="pricing-tables">
      {showBore && (
        <div class="pricing-block">
          {method === 'all' && <h3>Bore Pile (Mesin)</h3>}
          <div class="table-responsive">
            <table class="price-table">
              <thead>
                <tr>
                  <th>Diameter</th>
                  <th>Jasa / m¹</th>
                  <th>Material / m¹</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {pricingTiers.map((tier) => (
                  <tr>
                    <td><strong>{tier.diameter} cm</strong></td>
                    <td>
                      {tier.pricePerMeter.min === tier.pricePerMeter.max
                        ? `Rp ${tier.pricePerMeter.min.toLocaleString('id-ID')}`
                        : `Rp ${tier.pricePerMeter.min.toLocaleString('id-ID')} – ${tier.pricePerMeter.max.toLocaleString('id-ID')}`}
                      {tier.isEstimate && <span class="badge-est">est.</span>}
                    </td>
                    <td>
                      {tier.materialCostEstimate > 0 
                        ? `Rp ${tier.materialCostEstimate.toLocaleString('id-ID')}`
                        : <span class="badge-hubungi">Hubungi Kami</span>}
                    </td>
                    <td><a href={`/layanan/bore-pile/diameter/${tier.diameter}cm`}>Detail →</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {showStrauss && (
        <div class="pricing-block">
          {method === 'all' && <h3>Strauss Pile (Manual)</h3>}
          <div class="table-responsive">
            <table class="price-table">
              <thead>
                <tr>
                  <th>Diameter</th>
                  <th>Jasa / m¹</th>
                  <th>Material / m¹</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {straussTiers.map((tier) => (
                  <tr>
                    <td><strong>{tier.diameter} cm</strong></td>
                    <td>Rp {tier.pricePerMeter.min.toLocaleString('id-ID')}</td>
                    <td>
                      {tier.materialCostEstimate > 0 
                        ? `Rp ${tier.materialCostEstimate.toLocaleString('id-ID')}`
                        : <span class="badge-hubungi">Hubungi Kami</span>}
                    </td>
                    <td><a href={`/layanan/strauss-pile/diameter/${tier.diameter}cm`}>Detail →</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>

    <p class="pricing-note">*Harga di atas adalah harga jasa pengeboran per meter lari. Belum termasuk biaya mobilisasi/demobilisasi alat.</p>
  </div>
</section>

<style>
  .pricing-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .pricing-tables {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .pricing-block h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
    color: var(--color-primary);
  }
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .price-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .price-table th,
  .price-table td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--color-border-light);
    white-space: nowrap;
  }
  .price-table th {
    background: var(--color-bg-alt);
    font-weight: 600;
    color: var(--color-text);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .price-table td a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }
  .price-table td a:hover {
    text-decoration: underline;
  }
  .badge-est {
    display: inline-block;
    padding: 2px 6px;
    background: #fef3c7;
    color: #92400e;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    margin-left: 4px;
  }
  .badge-hubungi {
    display: inline-block;
    padding: 2px 8px;
    background: #fef2f2;
    color: #991b1b;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
  }
  .pricing-note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
