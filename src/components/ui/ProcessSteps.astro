---
export interface Props {
  title?: string;
  subtitle?: string;
  steps?: { number: number; title: string; desc: string }[];
}
const { 
  title = "Alur Kerja Kami", 
  subtitle = "Proses yang jelas dan transparan untuk memastikan kelancaran proyek Anda.",
  steps
} = Astro.props;

const defaultSteps = [
  { number: 1, title: "Konsultasi & Estimasi", desc: "Hubungi via WA. Informasikan detail kebutuhan Anda dan menyertakan data yang diperlukan untuk diberikan penawaran harga yang sesuai dengan lokasi dan kebutuhan proyek Anda." },
  { number: 2, title: "Survei Lokasi & DP", desc: "Setelah penawaran disetujui, tim kami turun mensurvei kesiapan lokasi. Jika lahan sudah beres dan siap dikerjakan, barulah dilakukan pembayaran DP untuk mobilisasi alat dan tim kami." },
  { number: 3, title: "Mobilisasi & Eksekusi", desc: "Alat mesin/manual beserta kru diberangkatkan ke lokasi. Pekerjaan pondasi langsung dieksekusi sesuai spesifikasi yang sudah disepakati." },
  { number: 4, title: "Selesai & Pelunasan", desc: "Setelah seluruh titik selesai dikerjakan sesuai target, barulah klien melakukan pelunasan, kemudian dilakukan penarikan alat dari lokasi." }
];

const activeSteps = steps || defaultSteps;
---
<section class="section" id="proses">
  <div class="container">
    <div class="section-title text-center">
      <h2 class="ps-h2">{title}</h2>
      <p>{subtitle}</p>
    </div>
    
        <div class="process-grid">
      {activeSteps.map(step => (
        <div class="step-card">
          <div class="step-number">{step.number}</div>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
    <div class="text-center ps-cta-wrap">
      <a href="#kontak" class="btn btn-outline">Mulai Proyek Anda &rarr;</a>
    </div>
  </div>
</section>

<style>
  .section-title h2.ps-h2 { font-size: var(--text-3xl); margin-bottom: var(--space-3); }
  .ps-cta-wrap { margin-top: var(--space-6); }
</style>


