---
export interface Props {
  title?: string;
  subtitle?: string;
  steps?: { number: number; title: string; desc: string }[];
}
const { 
  title = "Alur Kerja Kami", 
  subtitle = "Proses yang jelas dan transparan. Dari konsultasi pertama hingga pekerjaan selesai di lapangan.",
  steps
} = Astro.props;

const defaultSteps = [
  { number: 1, title: "Konsultasi & Estimasi", desc: "Hubungi via WA. Informasikan kebutuhan Anda (diameter, kedalaman, dan jumlah titik) untuk kami buatkan dokumen penawaran harga." },
  { number: 2, title: "Survei Lokasi & DP", desc: "Setelah penawaran disetujui, tim kami turun mensurvei kesiapan lokasi. Jika lahan sudah beres dan siap dikerjakan, barulah dilakukan pembayaran DP." },
  { number: 3, title: "Mobilisasi & Eksekusi", desc: "Alat (mini crane / manual) beserta kru diberangkatkan ke lokasi. Pekerjaan fondasi langsung dieksekusi sesuai spesifikasi." },
  { number: 4, title: "Selesai & Pelunasan", desc: "Setelah seluruh titik selesai dikerjakan sesuai target, barulah klien melakukan pelunasan bersamaan dengan penarikan alat dari lokasi." }
];

const activeSteps = steps || defaultSteps;
---
<section class="section" id="proses">
  <div class="container">
    <div class="section-title text-center" style="margin-bottom: var(--space-8);">
      <h2 style="font-size: var(--text-3xl); margin-bottom: var(--space-3);">{title}</h2>
      <p style="color: var(--color-text-muted);">{subtitle}</p>
    </div>
    
        <div class="process-grid">
      {activeSteps.map(step => (
        <div class="step-card">
          <div class="step-number">{step.number}</div>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
    <div class="text-center" style="margin-top: var(--space-6);">
      <a href="#kontak" class="btn btn-outline">Mulai Proyek Anda &rarr;</a>
    </div>
  </div>
</section>


