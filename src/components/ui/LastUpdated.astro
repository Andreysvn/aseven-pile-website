---
import { siteConfig } from '../../data/site.config';
// Tanggal diambil dari tanggal konten yang benar-benar diperbarui (siteConfig.contentUpdated),
// BUKAN tanggal build/deploy — supaya tidak menampilkan "freshness" palsu.
// Bisa dioverride lewat prop `date` (mis. tanggal update harga).
const { prefix = "Data Tervalidasi", hideIcon = false, date } = Astro.props;

const sourceDate = date ? new Date(date) : new Date(siteConfig.contentUpdated);

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(sourceDate);
---

<div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-green-50 text-green-700 border border-green-200 rounded-full text-xs font-medium shadow-sm mb-4" title="Tanggal konten terakhir diperbarui">
  {!hideIcon && (
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" style="flex-shrink: 0; display: inline-block; vertical-align: middle;">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
    </svg>
  )}
  <span>{prefix}: <strong>{formattedDate}</strong></span>
</div>
