---
import { siteConfig } from '../../data/site.config';

export interface Props {
  title?: string;    // Kept to avoid TS errors where it's used
  subtitle?: string; // Kept to avoid TS errors where it's used
  buttonText?: string;
  waMessage?: string;
}

const { 
  buttonText = "Chat WA Sekarang",
  waMessage = "Halo ASEVEN PILE, saya ingin konsultasi mengenai jasa pondasi bore pile."
} = Astro.props;

const waLink = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(waMessage)}`;
---

<div class="cta-wrapper">
  <a href={waLink} class="btn-glow-wa" target="_blank" rel="noopener noreferrer">
    {buttonText}
  </a>
</div>

<style>
  .cta-wrapper {
    text-align: center;
    padding: var(--space-8) 0;
  }

  .btn-glow-wa {
    display: inline-block;
    background-color: #25D366;
    color: #ffffff;
    padding: 14px 36px;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
    transition: all 0.3s ease;
  }

  .btn-glow-wa:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(37, 211, 102, 0.5);
    color: #ffffff;
  }
</style>
