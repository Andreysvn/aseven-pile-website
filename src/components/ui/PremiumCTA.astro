---
import { siteConfig } from '../../data/site.config';

export interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  waMessage?: string;
}

const { 
  title = "Butuh Jasa Pengeboran Profesional?", 
  subtitle = "Tim kami siap meluncur ke lokasi Anda. Konsultasikan kebutuhan pondasi dan akses jalan proyek Anda secara gratis.",
  buttonText = "Konsultasi via WhatsApp",
  waMessage = "Halo ASEVEN PILE, saya ingin konsultasi mengenai jasa pondasi bore pile."
} = Astro.props;

const waLink = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(waMessage)}`;
---

<section class="premium-cta-section">
  <div class="container">
    <div class="cta-card">
      
      <div class="cta-content">
        <div class="cta-text">
          <h2>{title}</h2>
          <p>{subtitle}</p>
          
          <div class="trust-badges">
            <span class="badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              Hitung RAB Gratis
            </span>
            <span class="badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              Fast Response 24/7
            </span>
            <span class="badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              Bergaransi
            </span>
          </div>
        </div>
        
        <div class="cta-action">
          <a href={waLink} class="btn-whatsapp-premium">
            <div class="wa-icon-wrapper">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>
            <span>{buttonText}</span>
          </a>
          <p class="cta-secure-text">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            Data proyek Anda aman 100% bersama kami
          </p>
        </div>
      </div>
      
      <!-- Background Shapes -->
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
    </div>
  </div>
</section>

<style>
  .premium-cta-section {
    padding: var(--space-8) 0 var(--space-12) 0;
  }

  .cta-card {
    position: relative;
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    border-radius: 24px;
    padding: var(--space-10) var(--space-8);
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(128, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cta-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 992px) {
    .cta-content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-12);
    }
  }

  .cta-text {
    flex: 1;
    color: white;
  }

  .cta-text h2 {
    color: white;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.2;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .cta-text p {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-6);
    max-width: 600px;
  }

  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 500;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  @media (min-width: 992px) {
    .cta-action {
      align-items: flex-start;
      min-width: 300px;
    }
  }

  .btn-whatsapp-premium {
    display: inline-flex;
    align-items: center;
    background-color: white;
    color: var(--color-primary-dark);
    padding: 6px 24px 6px 6px;
    border-radius: 50px;
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    width: 100%;
    justify-content: center;
  }

  .btn-whatsapp-premium:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
    background-color: var(--color-accent);
    color: var(--color-primary-dark);
  }

  .wa-icon-wrapper {
    background-color: #25D366;
    color: white;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    box-shadow: inset 0 -2px 5px rgba(0,0,0,0.1);
  }

  .btn-whatsapp-premium:hover .wa-icon-wrapper {
    background-color: white;
    color: #25D366;
  }

  .cta-secure-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Decorative Background Elements */
  .shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    z-index: 1;
    pointer-events: none;
  }

  .shape-1 {
    top: -50%;
    right: -10%;
    width: 400px;
    height: 400px;
    background: var(--color-accent);
    opacity: 0.15;
  }

  .shape-2 {
    bottom: -50%;
    left: -10%;
    width: 300px;
    height: 300px;
    background: #FF6B6B;
    opacity: 0.2;
  }
</style>
