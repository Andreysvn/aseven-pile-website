---
import { siteConfig } from '../../data/site.config';

export interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  waMessage?: string;
}

const { 
  title = "Butuh Jasa Pengeboran Profesional?", 
  subtitle = "Tim kami siap meluncur ke lokasi Anda. Konsultasikan kebutuhan pondasi dan akses jalan proyek Anda secara gratis.",
  buttonText = "Konsultasi via WhatsApp",
  waMessage = "Halo ASEVEN PILE, saya ingin konsultasi mengenai jasa pondasi bore pile."
} = Astro.props;

const waLink = \https://wa.me/\?text=\\;
---

<section class="section" style="padding-top: var(--space-8); padding-bottom: var(--space-12);">
  <div class="container">
    <div class="cta-minimal">
      <div class="cta-text">
        <h2>{title}</h2>
        <p>{subtitle}</p>
      </div>
      <div class="cta-action">
        <a href={waLink} class="btn-wa-minimal" target="_blank" rel="noopener noreferrer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>{buttonText}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-minimal {
    background-color: var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  /* Accent line top */
  .cta-minimal::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #ff4d4d, #ffb347);
  }

  @media (min-width: 992px) {
    .cta-minimal {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      text-align: left;
      padding: var(--space-12) var(--space-10);
    }
  }

  .cta-text {
    flex: 1;
    max-width: 650px;
  }

  .cta-text h2 {
    color: #ffffff;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-3);
    letter-spacing: -0.01em;
  }

  .cta-text p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0;
  }

  .cta-action {
    flex-shrink: 0;
  }

  .btn-wa-minimal {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #ffffff;
    color: var(--color-primary);
    padding: 14px 32px;
    border-radius: var(--radius-md);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-wa-minimal svg {
    color: #25D366; /* Keep WA green strictly on the icon */
  }

  .btn-wa-minimal:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    background-color: #f8fafc;
  }
</style>
