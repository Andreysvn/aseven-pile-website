---
interface Props {
  service?: 'borepile' | 'strauss';
}

const { service = 'borepile' } = Astro.props;
const minOrder = service === 'strauss' ? '100 meter' : '200 meter (mini crane/gawangan)';

const borePileItems = [
  {
    title: "Mobilisasi & Demobilisasi Alat",
    desc: "Biaya pengiriman alat dari workshop kami ke lokasi dan kembali. Besarannya menyesuaikan jarak/zona lokasi, estimasi per wilayah bisa dilihat di kalkulator biaya pada halaman ini."
  },
  {
    title: "Sedot & Pembuangan Lumpur",
    desc: "Pada metode bor basah (wash boring), lumpur hasil pengeboran perlu disedot dan diangkut keluar. Biaya menyesuaikan jarak unit penyedot lumpur (sesuai jarak lokasi), kami bisa membantu menyediakan jasa buang lumpur dari area proyek."
  },
  {
    title: "Bak Sirkulasi Air/Lumpur",
    desc: "Bila diperlukan pada metode bor basah (wash boring) sebagai penampung sirkulasi air/lumpur selama proses pengeboran berlangsung."
  },
  {
    title: "Uji Tanah (Sondir Wajib / SPT)",
    desc: "Uji tanah (sondir) wajib dilakukan sebelum pekerjaan dimulai untuk menentukan secara pasti titik kedalaman tanah keras (hard strata) dan memastikan kapasitas daya dukung pondasi aman."
  },
  {
    title: "Minimal Order Jasa",
    desc: `Berlaku minimal order ${minOrder} untuk jasa ini. Untuk volume pengerjaan di bawah batas tersebut, akan dikenakan charge/biaya minimum setara perhitungan ${minOrder}.`
  },
  {
    title: "Material (Besi & Beton)",
    desc: "Harga di tabel belum termasuk material (besi & beton). Kebutuhan material mengikuti desain struktur perencana proyek Anda. Namun jika Anda tidak ingin repot, kami melayani paket borong all-in material (besi & beton) sesuai standar teknis pondasi dalam."
  }
];

const straussPileItems = [
  {
    title: "Mobilisasi Tenaga & Alat",
    desc: "Biaya transportasi tenaga kerja spesialis beserta alat bor manual menuju lokasi proyek Anda. Besarannya menyesuaikan jarak lokasi."
  },
  {
    title: "Pembuangan Tanah Sisa Galian",
    desc: "Tanah hasil pengeboran manual perlu diangkut keluar dari lokasi. Pembuangan tanah ini menjadi tanggung jawab pemilik proyek."
  },
  {
    title: "Minimal Order Jasa",
    desc: `Berlaku minimal order ${minOrder} untuk jasa ini. Untuk volume pengerjaan di bawah batas tersebut, akan dikenakan charge/biaya minimum setara perhitungan ${minOrder}.`
  },
  {
    title: "Material (Besi & Beton)",
    desc: "Harga di tabel belum termasuk material (besi & beton). Kebutuhan material mengikuti desain struktur. Kami berfokus pada jasa pengeborannya, namun kami juga siap membantu paket all-in material jika dibutuhkan."
  },
  {
    title: "Uji Tanah (Sondir Wajib)",
    desc: "Uji tanah (sondir) wajib dilakukan untuk menentukan kedalaman target tanah keras dan memastikan daya dukung pondasi aman sesuai rekomendasi teknis."
  }
];

const items = service === 'strauss' ? straussPileItems : borePileItems;
---

<section class="ls-section">
  <h2 class="ls-mach-title">Biaya Tambahan di Luar Harga Jasa</h2>
  <p class="ls-mach-p">
    Harga pada tabel di atas hanya mencakup <strong>jasa pengeborannya saja</strong>. Agar anggaran proyek lebih akurat, berikut komponen biaya lain yang biasanya belum termasuk:
  </p>
  <div class="ca-grid">
    {items.map(item => (
      <div class="ca-item">
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .ca-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .ca-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 16px 18px;
  }
  .ca-item h3 {
    font-size: 1rem;
    color: var(--color-primary);
    margin-bottom: 6px;
  }
  .ca-item p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
