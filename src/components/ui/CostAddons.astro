---
interface Props {
  service?: 'borepile' | 'strauss';
}

const { service = 'borepile' } = Astro.props;
const minOrder = service === 'strauss' ? '100 meter' : '200 meter (mini crane/gawangan)';

const borePileItems = [
  {
    title: "Mobilisasi & Demobilisasi Alat",
    desc: "Biaya pengiriman alat dari workshop kami ke lokasi dan kembali. Besarannya menyesuaikan jarak/zona lokasi — estimasi per wilayah bisa dilihat di kalkulator biaya pada halaman ini."
  },
  {
    title: "Sedot & Pembuangan Lumpur",
    desc: "Pada metode bor basah (wash boring), lumpur hasil pengeboran perlu disedot dan diangkut keluar. Biaya menyesuaikan volume lumpur dan jarak pembuangan."
  },
  {
    title: "Bak Sirkulasi Air",
    desc: "Bila diperlukan sebagai penampung sirkulasi air selama proses pengeboran berlangsung."
  },
  {
    title: "Uji Tanah (Sondir / SPT)",
    desc: "Uji sondir sangat disarankan untuk menentukan kedalaman target dan lapisan tanah keras. Bisa dilengkapi uji SPT. Kami dapat membantu merekomendasikan penyedia jasa uji tanah."
  },
  {
    title: "Minimal Order Jasa",
    desc: `Berlaku minimal order ${minOrder} untuk jasa ini. Untuk volume pengerjaan di bawah batas tersebut, akan dikenakan charge/biaya minimum setara perhitungan ${minOrder}.`
  },
  {
    title: "Material (Besi & Beton)",
    desc: "Harga di tabel belum termasuk material (besi & beton). Kebutuhan besi & beton mengikuti desain struktur tiap proyek, jadi mengacu pada perhitungan perencana/struktur Anda."
  }
];

const straussPileItems = [
  {
    title: "Mobilisasi Tenaga & Alat",
    desc: "Biaya transportasi tenaga kerja spesialis beserta alat bor manual (tripod/auger) menuju lokasi proyek Anda. Besarannya menyesuaikan jarak lokasi."
  },
  {
    title: "Pembuangan Tanah Sisa Galian",
    desc: "Tanah hasil pengeboran manual perlu diangkut keluar dari lokasi. Biaya menyesuaikan volume tanah yang dihasilkan dan jarak pembuangan."
  },
  {
    title: "Minimal Order Jasa",
    desc: `Berlaku minimal order ${minOrder} untuk jasa ini. Untuk volume pengerjaan di bawah batas tersebut, akan dikenakan charge/biaya minimum setara perhitungan ${minOrder}.`
  },
  {
    title: "Material (Besi & Beton)",
    desc: "Harga di tabel belum termasuk material (besi & beton). Kebutuhan material mengikuti desain struktur. Kami berfokus pada jasa pengeborannya."
  },
  {
    title: "Uji Tanah (Opsional)",
    desc: "Untuk bangunan beban ringan, uji sondir seringkali di-skip. Namun untuk 2-3 lantai, uji sondir tetap disarankan agar kedalaman tiang tepat pada tanah penyokong yang stabil."
  }
];

const items = service === 'strauss' ? straussPileItems : borePileItems;
---

<section class="ls-section">
  <h2 class="ls-mach-title">Biaya Tambahan di Luar Harga Jasa</h2>
  <p class="ls-mach-p">
    Harga pada tabel di atas hanya mencakup <strong>jasa pengeborannya saja</strong>. Agar anggaran proyek lebih akurat, berikut komponen biaya lain yang biasanya belum termasuk:
  </p>
  <div class="ca-grid">
    {items.map(item => (
      <div class="ca-item">
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .ca-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .ca-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 16px 18px;
  }
  .ca-item h3 {
    font-size: 1rem;
    color: var(--color-primary);
    margin-bottom: 6px;
  }
  .ca-item p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
