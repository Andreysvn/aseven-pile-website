---
interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  url: string;
  isLcp?: boolean;
}

const { title, description, image, imageAlt, url, isLcp = false } = Astro.props;
---

<a href={`/${url}`} class="hub-service-card" data-card="premium-overlay">
  <img
    src={image}
    alt={imageAlt}
    class="card-bg"
    loading={isLcp ? "eager" : "lazy"}
  />
  <div class="card-overlay"></div>
  
  <div class="card-content">
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="card-footer">
      <span class="card-cta">Pelajari Layanan &rarr;</span>
    </div>
  </div>
</a>

<style is:global>
  /* Menggunakan is:global untuk memaksa Vite memuat CSS ini tanpa bug caching scope */
  a.hub-service-card[data-card="premium-overlay"] {
    position: relative !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-end !important;
    background: #111 !important;
    border-radius: 16px !important;
    overflow: hidden !important;
    text-decoration: none !important;
    aspect-ratio: 4 / 5 !important;
    transition: transform 0.4s ease, box-shadow 0.4s ease !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  @media (min-width: 768px) {
    a.hub-service-card[data-card="premium-overlay"] {
      aspect-ratio: 1 / 1 !important;
    }
  }

  a.hub-service-card[data-card="premium-overlay"] .card-bg {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.8s ease !important;
    z-index: 1 !important;
  }

  a.hub-service-card[data-card="premium-overlay"] .card-overlay {
    position: absolute !important;
    bottom: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 75% !important;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.4) 60%, transparent 100%) !important;
    z-index: 2 !important;
    transition: height 0.4s ease !important;
  }

  a.hub-service-card[data-card="premium-overlay"] .card-content {
    position: relative !important;
    z-index: 3 !important;
    padding: 24px !important;
    color: white !important;
    text-align: left !important;
  }

  a.hub-service-card[data-card="premium-overlay"] .card-content h2 {
    font-size: 1.4rem !important;
    color: white !important;
    font-weight: 700 !important;
    margin: 0 0 8px 0 !important;
    line-height: 1.2 !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3) !important;
  }

  a.hub-service-card[data-card="premium-overlay"] .card-content p {
    font-size: 0.95rem !important;
    color: rgba(255, 255, 255, 0.85) !important;
    line-height: 1.6 !important;
    margin: 0 0 24px 0 !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 3 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
  }

  a.hub-service-card[data-card="premium-overlay"] .card-footer {
    display: flex !important;
    justify-content: flex-start !important;
  }

  a.hub-service-card[data-card="premium-overlay"] .card-cta {
    font-size: 0.9rem !important;
    font-weight: 700 !important;
    color: #8b0000 !important; /* var(--color-primary) */
    background: white !important;
    padding: 10px 22px !important;
    border-radius: 100px !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    transition: all 0.3s ease !important;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2) !important;
  }

  a.hub-service-card[data-card="premium-overlay"]:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.4) !important;
  }

  a.hub-service-card[data-card="premium-overlay"]:hover .card-bg {
    transform: scale(1.1) !important;
  }
  
  a.hub-service-card[data-card="premium-overlay"]:hover .card-overlay {
    height: 85% !important;
  }

  a.hub-service-card[data-card="premium-overlay"]:hover .card-cta {
    background: #8b0000 !important;
    color: white !important;
    gap: 12px !important;
  }
</style>
