---
interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  url: string;
  isLcp?: boolean;
}

const { title, description, image, imageAlt, url, isLcp = false } = Astro.props;
---

<a href={`/${url}`} class="service-card">
  <div class="card-image">
    <img
      src={image}
      alt={imageAlt}
      loading={isLcp ? "eager" : "lazy"}
    />
  </div>
  <div class="card-body">
    <h2>{title}</h2>
    <p>{description}</p>
    <span class="card-cta">Pelajari Layanan &rarr;</span>
  </div>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .service-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 10px 24px -6px rgba(0,0,0,0.1);
    transform: translateY(-3px);
  }

  .service-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-image {
    width: 100%;
    height: 260px;
    overflow: hidden;
    background: #f1f5f9;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card-body {
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-body h2 {
    font-size: 1.3rem;
    color: var(--color-primary);
    font-weight: 700;
    margin: 0 0 10px 0;
  }

  .card-body p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }

  .card-cta {
    font-size: 0.95rem;
    font-weight: 600;
    color: white;
    background: var(--color-primary);
    padding: 10px 18px;
    border-radius: 7px;
    text-align: center;
    display: block;
    transition: background 0.3s;
  }

  .service-card:hover .card-cta {
    background: #6a0000;
  }
</style>
