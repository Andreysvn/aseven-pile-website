---
interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  url: string;
  isLcp?: boolean;
}

const { title, description, image, imageAlt, url, isLcp = false } = Astro.props;
---

<a href={`/${url}`} class="aseven-service-card">
  <img
    src={image}
    alt={imageAlt}
    class="card-bg"
    loading={isLcp ? "eager" : "lazy"}
  />
  <div class="card-overlay"></div>
  
  <div class="card-content">
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="card-footer">
      <span class="card-cta">Lihat Lebih Lanjut &rarr;</span>
    </div>
  </div>
</a>

<style>
  .aseven-service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: #111;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: 4 / 5; /* Rasio tinggi elegan untuk mobile */
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.4s ease;
  }

  @media (min-width: 768px) {
    .aseven-service-card {
      aspect-ratio: 1 / 1; /* Agak kotak di desktop supaya tidak terlalu raksasa */
    }
  }

  .card-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }

  .card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 75%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.4) 60%, transparent 100%);
    z-index: 2;
    transition: height 0.4s ease;
  }

  .card-content {
    position: relative;
    z-index: 3;
    padding: 24px;
    color: white;
  }

  .card-content h2 {
    font-size: 1.4rem;
    color: white;
    font-weight: 700;
    margin: 0 0 8px 0;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .card-content p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0 0 24px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: flex-start;
  }

  .card-cta {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
    background: white;
    padding: 10px 22px;
    border-radius: 100px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  }

  .aseven-service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.4);
  }

  .aseven-service-card:hover .card-bg {
    transform: scale(1.1);
  }
  
  .aseven-service-card:hover .card-overlay {
    height: 85%;
  }

  .aseven-service-card:hover .card-cta {
    background: var(--color-primary);
    color: white;
    gap: 12px;
  }
</style>

