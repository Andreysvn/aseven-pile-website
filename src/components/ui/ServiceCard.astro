---
interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  url: string;
  isLcp?: boolean;
}

const { title, description, image, imageAlt, url, isLcp = false } = Astro.props;
---

<a href={`/${url}`} class="hub-service-card">
  <div class="card-image">
    <img
      src={image}
      alt={imageAlt}
      loading={isLcp ? "eager" : "lazy"}
    />
  </div>
  <div class="card-body">
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="card-footer">
      <span class="card-cta">Pelajari Layanan &rarr;</span>
    </div>
  </div>
</a>

<style>
  .hub-service-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    padding: 0; 
    text-align: left;
  }

  .hub-service-card:hover {
    border-color: rgba(139, 0, 0, 0.3); /* Soft primary border on hover */
    box-shadow: 0 12px 32px -8px rgba(0,0,0,0.12);
    transform: translateY(-4px);
  }

  .hub-service-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 3 / 2; /* Responsive, elegant proportion */
    overflow: hidden;
    background: #f1f5f9;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-body h2 {
    font-size: 1.3rem;
    color: var(--color-text);
    font-weight: 700;
    margin: 0 0 10px 0;
    line-height: 1.3;
    transition: color 0.2s;
  }
  
  .hub-service-card:hover h2 {
    color: var(--color-primary);
  }

  .card-body p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 24px 0;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    justify-content: flex-start;
  }

  .card-cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    background: rgba(139, 0, 0, 0.05);
    padding: 8px 20px;
    border-radius: 100px;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .hub-service-card:hover .card-cta {
    background: var(--color-primary);
    color: white;
  }
</style>
