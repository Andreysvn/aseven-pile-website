---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Lokasi Kami", 
  subtitle = "Setia Asih, Kec. Tarumajaya, Kabupaten Bekasi, Jawa Barat 17215" 
} = Astro.props;
---

<section class="section map-section">
  <div class="container map-container">
    <div class="section-title">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>
    
    <div class="map-wrapper">
      <div class="map-card">
        <iframe 
          src="https://maps.google.com/maps?q=-6.1627854,107.0076685&t=k&hl=id&z=17&output=embed" 
          class="map-iframe"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .map-section {
    padding-top: var(--space-6);
    padding-bottom: var(--space-12);
  }

  .map-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .map-wrapper {
    background: var(--color-surface, #ffffff);
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border-light, #e2e8f0);
    box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(0,0,0,0.05));
    overflow: hidden;
  }

  .map-card {
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    position: relative;
  }

  @media (max-width: 768px) {
    .map-card {
      aspect-ratio: 1 / 1;
    }
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    border: none;
    filter: contrast(1.1) saturate(1.1);
  }
</style>
