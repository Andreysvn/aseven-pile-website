---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Lokasi Kami", 
  subtitle = "Setia Asih, Kec. Tarumajaya, Kabupaten Bekasi, Jawa Barat 17215" 
} = Astro.props;
---

<section class="section map-section">
  <div class="container map-container">
    <div class="section-title">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>
    
    <div class="map-wrapper">
      <div class="map-card">
        <div id="location-leaflet-map" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;"></div>
      </div>
    </div>
  </div>
</section>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>

<style>
  .map-section {
    padding-top: var(--space-6);
    padding-bottom: var(--space-12);
  }

  .map-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .map-wrapper {
    background: var(--color-surface, #ffffff);
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border-light, #e2e8f0);
    box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(0,0,0,0.05));
    overflow: hidden;
  }

  .map-card {
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    position: relative;
  }

  @media (max-width: 768px) {
    .map-card {
      aspect-ratio: 1 / 1;
    }
  }

  /* Custom popup style to match brand */
  .leaflet-popup-content-wrapper {
    border-radius: 8px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }
  .leaflet-popup-content {
    margin: 12px 16px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: #800000;
  }
</style>

<!-- Leaflet JS -->
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const mapElement = document.getElementById('location-leaflet-map');
    if (!mapElement) return;

    // Koordinat Workshop Aseven Pile
    const lat = -6.1627854;
    const lng = 107.0076685;

    // Initialize Map
    const map = L.map('location-leaflet-map', {
      scrollWheelZoom: false // Mencegah zoom gak sengaja waktu user scroll halaman
    }).setView([lat, lng], 16);

    // 1. Google Earth (Satelit)
    const googleHybrid = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
      attribution: '&copy; Google Maps',
      maxNativeZoom: 20, maxZoom: 20
    });
    
    // 2. Topografi Tanah
    const openTopoMap = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenTopoMap',
      maxNativeZoom: 17, maxZoom: 20
    });

    // 3. Peta Standar
    const googleStreets = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
      attribution: '&copy; Google Maps',
      maxNativeZoom: 20, maxZoom: 20
    });

    // Set Google Earth as default (User request: "skrg yg utama kan earth")
    googleHybrid.addTo(map);

    // Add Layer Control di pojok kiri bawah
    const baseMaps = {
      "Google Earth (Satelit)": googleHybrid,
      "Topografi Tanah": openTopoMap,
      "Peta Standar": googleStreets
    };

    L.control.layers(baseMaps, null, { position: 'bottomleft' }).addTo(map);

    // Custom Red Pin (SVG)
    const redPinHtml = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#E53E3E" width="36px" height="36px" style="filter: drop-shadow(0px 4px 2px rgba(0,0,0,0.4));">
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
    </svg>`;

    const customIcon = L.divIcon({
      html: redPinHtml,
      className: '',
      iconSize: [36, 36],
      iconAnchor: [18, 36], // Center bottom
      popupAnchor: [0, -32] // Just above the pin
    });

    // Add Marker
    L.marker([lat, lng], { icon: customIcon })
      .addTo(map)
      .bindPopup('Workshop Aseven Pile')
      .openPopup();
  });
</script>
