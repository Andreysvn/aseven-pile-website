---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Lokasi Kami", 
  subtitle = "Setia Asih, Kec. Tarumajaya, Kabupaten Bekasi, Jawa Barat 17215" 
} = Astro.props;
---

<section class="section map-section">
  <div class="container map-container">
    <div class="section-title">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>
    
    <div class="map-wrapper">
      <div class="map-card">
        <!-- Placeholder sebelum peta di-load (biar layout gak lompat) -->
        <div id="location-loading" class="lm-overlay">
          <span>Memuat Peta...</span>
        </div>
        <div id="location-leaflet-map" class="lm-map"></div>
      </div>
    </div>
  </div>
</section>

<!-- Leaflet CSS dimuat asinkron biar gak nge-block render -->
<link rel="preload" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" as="style" onload="this.onload=null;this.rel='stylesheet'" crossorigin=""/>
<noscript><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/></noscript>

<style>
  .lm-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    background-color: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lm-overlay span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .lm-map {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .map-section {
    padding-top: var(--space-6);
    padding-bottom: var(--space-12);
  }

  .map-container {
    max-width: 100%;
    margin: 0 auto;
  }

  .map-wrapper {
    background: var(--color-surface, #ffffff);
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border-light, #e2e8f0);
    box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(0,0,0,0.05));
    overflow: hidden;
  }

  .map-card {
    width: 100%;
    height: 450px;
    position: relative;
  }

  @media (max-width: 768px) {
    .map-card {
      height: 350px;
    }
  }

  .leaflet-popup-content-wrapper {
    border-radius: 8px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }
  .leaflet-popup-content {
    margin: 12px 16px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: #800000;
  }
</style>

<!-- Script diload secara Lazy (Hanya kalau di-scroll) -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const mapContainer = document.getElementById('location-leaflet-map');
    if (!mapContainer) return;

    let mapLoaded = false;

    // Fungsi untuk inisialisasi peta
    const loadLeafletMap = () => {
      if (mapLoaded) return;
      mapLoaded = true;
      
      // Hapus text loading
      const loadingDiv = document.getElementById('location-loading'); if(loadingDiv) loadingDiv.remove();

      // Load JS
      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.crossOrigin = '';
      script.onload = () => {
        // Koordinat
        const lat = -6.1627854;
        const lng = 107.0076685;

        const map = L.map('location-leaflet-map', {
          scrollWheelZoom: false
        }).setView([lat, lng], 16);

        // Layers
        const googleHybrid = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
          attribution: '&copy; Google Maps',
          maxNativeZoom: 20, maxZoom: 20
        });
        
        const openTopoMap = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenTopoMap',
          maxNativeZoom: 17, maxZoom: 20
        });

        const googleStreets = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
          attribution: '&copy; Google Maps',
          maxNativeZoom: 20, maxZoom: 20
        });

        openTopoMap.addTo(map); // Default

        const baseMaps = {
          "Topografi Tanah": openTopoMap,
          "Google Earth (Satelit)": googleHybrid,
          "Peta Standar": googleStreets
        };

        L.control.layers(baseMaps, null, { position: 'bottomleft' }).addTo(map);

        // Custom Pin
        const redPinHtml = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#E53E3E" width="36px" height="36px" style="filter: drop-shadow(0px 4px 2px rgba(0,0,0,0.4));"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`;

        const customIcon = L.divIcon({
          html: redPinHtml,
          className: '',
          iconSize: [36, 36],
          iconAnchor: [18, 36]
        });

        L.marker([lat, lng], { icon: customIcon }).addTo(map);

        // Paksa Leaflet buat nyesuaiin ukuran sama kontainernya
        setTimeout(() => { map.invalidateSize(); }, 100);
      };
      
      document.body.appendChild(script);
    };

    // Panggil fungsi load hanya saat elemen peta masuk ke layar (Lazy Load)
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          loadLeafletMap();
          observer.disconnect();
        }
      }, { rootMargin: "200px" }); // Load saat jarak 200px sebelum masuk layar
      
      observer.observe(mapContainer);
    } else {
      // Fallback buat browser jadul
      setTimeout(loadLeafletMap, 2000); 
    }
  });
</script>
