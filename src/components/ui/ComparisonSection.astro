---
export interface Props {
  title: string;
  description: string;
  primaryTitle: string;
  primaryDesc: string;
  secondaryTitle: string;
  secondaryDesc: string;
  conclusion: string;
}
const { title, description, primaryTitle, primaryDesc, secondaryTitle, secondaryDesc, conclusion } = Astro.props;
---

<section class="ls-vs-section">
  <h2 class="ls-vs-title">{title}</h2>
  <p class="ls-vs-desc">{description}</p>
  <div class="ls-modern-vs-wrap">
    <div class="ls-mvs-card ls-mvs-primary">
      <h3 class="ls-mvs-title">
        
        {primaryTitle}
      </h3>
      <p class="ls-mvs-desc" set:html={primaryDesc}></p>
    </div>

    <div class="ls-mvs-badge">VS</div>

    <div class="ls-mvs-card ls-mvs-secondary">
      <h3 class="ls-mvs-title">{secondaryTitle}</h3>
      <p class="ls-mvs-desc" set:html={secondaryDesc}></p>
    </div>
  </div>
  
  <div style="margin-top: 1.5rem; text-align: justify;">
    <p class="ls-mvs-desc" set:html={conclusion}></p>
  </div>
</section>
