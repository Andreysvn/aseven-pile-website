---
import { siteConfig } from '../../data/site.config';
const currentPath = Astro.url.pathname;

// Helper logic to check active path
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};
const isHome = currentPath === '/';
---
<header class={`header ${isHome ? '' : 'header-solid'}`}>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Beranda ASeven Pile">
      <img src="/imgs/aseven-pile-logo-3.webp" alt="ASeven Pile Logo" width="60" height="60" class="brand-logo" /> <span class="brand-text">ASEVEN PILE</span>
    </a>
    
    <!-- Desktop Nav -->
    <nav class="nav-links">
      <a href="/" class={isActive('/') ? 'active' : ''}>Beranda</a>
      <a href="/layanan" class={isActive('/layanan') ? 'active' : ''}>Layanan</a>
      <a href="/tentang-kami" class={isActive('/tentang-kami') ? 'active' : ''}>Tentang Kami</a>
      <a href="/area-layanan" class={isActive('/area-layanan') ? 'active' : ''}>Area Layanan</a>
      <a href="/artikel" class={isActive('/artikel') ? 'active' : ''}>Artikel</a> <a href="/faq" class={isActive('/faq') ? 'active' : ''}>FAQ</a>
      <a href="/galeri" class={isActive('/galeri') ? 'active' : ''}>Galeri</a>
      <a href="/kontak" class={isActive('/kontak') ? 'active' : ''}>Kontak</a>
    </nav>

    <div class="header-actions">
      <!-- WhatsApp CTA -->
      <a href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent('Halo ASEVEN PILE, saya ingin konsultasi mengenai pondasi.')}`} class="btn btn-primary nav-cta-desktop" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="wa-icon"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg> Whatsapp</a>
      
      <!-- Mobile Menu Hamburger Button -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Buka Menu">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div class="mobile-menu" id="mobileMenu">
    <a href="/" class={isActive('/') ? 'active' : ''}>Beranda</a>
    <a href="/layanan" class={isActive('/layanan') ? 'active' : ''}>Layanan</a>
    <a href="/tentang-kami" class={isActive('/tentang-kami') ? 'active' : ''}>Tentang Kami</a>
    <a href="/area-layanan" class={isActive('/area-layanan') ? 'active' : ''}>Area Layanan</a>
    <a href="/artikel" class={isActive('/artikel') ? 'active' : ''}>Artikel</a> <a href="/faq" class={isActive('/faq') ? 'active' : ''}>FAQ</a>
    <a href="/galeri" class={isActive('/galeri') ? 'active' : ''}>Galeri</a>
      <a href="/kontak" class={isActive('/kontak') ? 'active' : ''}>Kontak</a>
    <a href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent('Halo ASEVEN PILE, saya ingin konsultasi mengenai pondasi.')}`} class="btn btn-primary" style="margin-top: var(--space-4); text-align: center;" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="wa-icon"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg> Whatsapp</a>
  </div>
</header>













