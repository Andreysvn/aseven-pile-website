---
import { siteConfig } from '../../data/site.config';
---
<footer class="footer">
  <div class="container footer-inner">
    
    <div class="footer-brand">
      <div class="brand" style="margin-bottom: 12px;">
        <img src="/imgs/aseven-pile-logo-white.webp" alt="Aseven Pile Logo" width="60" height="60" class="brand-logo" style="max-height: 50px; filter: drop-shadow(0px 1px 2px rgba(0,0,0,0.3)); margin-left: -16px;" />
        <span class="brand-text" style="color: #ffffff; font-size: var(--text-xl); margin-left: -6px;">Aseven Pile</span>
      </div>
      <p style="margin-bottom: 12px;">{siteConfig.tagline}</p>
      <div class="social-links" style="display: flex; gap: 12px;">
        <a href="#" aria-label="Facebook" style="color: #fff;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
        <a href="#" aria-label="Instagram" style="color: #fff;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
        <a href="#" aria-label="YouTube" style="color: #fff;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg></a>
      </div>
    </div>

    <div class="footer-links">
      <h4>Layanan Kami</h4>
      <ul>
        <li><a href="/layanan">Jasa Bore Pile</a></li>
        <li><a href="/layanan/strauss-pile-manual">Jasa Strauss Pile</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h4>Area Layanan</h4>
      <ul>
        <li><a href="/#area">Jabodetabek</a></li>
        <li><a href="/#area">Jawa Barat</a></li>
        <li><a href="/#area">Jawa Tengah</a></li>
        <li><a href="/#area">Jawa Timur</a></li>
        
      </ul>
    </div>

    <div class="footer-contact">
      <h4>Kontak & Lokasi</h4>

    </div>

  </div>
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} {siteConfig.brand}. All rights reserved.</p>
  </div>
</footer>





