---
import BaseLayout from './BaseLayout.astro';
import LastUpdated from '../ui/LastUpdated.astro';
import { siteConfig } from '../../data/site.config';

export interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  city: string;
  serviceName: string;
  faqs?: FAQ[];
  pathContext?: 'general' | 'bore-pile' | 'strauss-pile';
}

const { 
  title, 
  description, 
  city, 
  serviceName, 
  faqs = [], 
  pathContext = 'general' 
} = Astro.props;

// Compute canonical URL and breadcrumb path based on context
const citySlug = city.toLowerCase().replace(/\s+/g, "-");
let pageUrl = `${siteConfig.url}/area-layanan/${citySlug}`;
let breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Beranda", "item": siteConfig.url },
  { "@type": "ListItem", "position": 2, "name": "Area Layanan", "item": `${siteConfig.url}/area-layanan` }
];

if (pathContext === 'bore-pile') {
  pageUrl = `${siteConfig.url}/area-layanan/bore-pile/${citySlug}`;
  breadcrumbItems.push({ "@type": "ListItem", "position": 3, "name": "Bore Pile", "item": `${siteConfig.url}/area-layanan/bore-pile` });
  breadcrumbItems.push({ "@type": "ListItem", "position": 4, "name": city, "item": pageUrl });
} else if (pathContext === 'strauss-pile') {
  pageUrl = `${siteConfig.url}/area-layanan/strauss-pile/${citySlug}`;
  breadcrumbItems.push({ "@type": "ListItem", "position": 3, "name": "Strauss Pile", "item": `${siteConfig.url}/area-layanan/strauss-pile` });
  breadcrumbItems.push({ "@type": "ListItem", "position": 4, "name": city, "item": pageUrl });
} else {
  breadcrumbItems.push({ "@type": "ListItem", "position": 3, "name": city, "item": pageUrl });
}

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `${siteConfig.brand} - ${serviceName} ${city}`,
  "description": description,
  "url": pageUrl,
  "telephone": siteConfig.phone,
  "email": siteConfig.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.street,
    "addressLocality": siteConfig.address.city,
    "addressRegion": siteConfig.address.province,
    "postalCode": siteConfig.address.postalCode,
    "addressCountry": "ID"
  },
  "areaServed": {
    "@type": "City",
    "name": city
  },
  "serviceType": [serviceName, "Bore Pile", "Strauss Pile", "Pondasi Bore Pile"],
  "priceRange": "Rp 70.000 - Rp 350.000",
  "foundingDate": siteConfig.foundingYear.toString(),
  "sameAs": Object.values(siteConfig.socialMedia),
  "dateModified": new Date().toISOString()
};

// FAQ Schema (if faqs provided)
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

// Service Schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${serviceName} ${city}`,
  "provider": {
    "@type": "LocalBusiness",
    "name": siteConfig.brand
  },
  "areaServed": {
    "@type": "City",
    "name": city
  },
  "description": description
};
---

<BaseLayout title={title} description={description}>
  <!-- LD+JSON Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems
  })} />

  <header class="section section-bg-alt" style="padding-top: var(--space-12); padding-bottom: var(--space-12); border-bottom: 1px solid var(--color-border-light);">
    <div class="container" style="max-width: 800px; text-align: center;">
      <!-- HTML Breadcrumbs -->
      <nav aria-label="Breadcrumb" style="margin-bottom: var(--space-6); font-size: 0.875rem; color: var(--color-text-muted);">
        <ol style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; list-style: none; padding: 0;" itemscope itemtype="https://schema.org/BreadcrumbList">
          {breadcrumbItems.map((item, index) => (
            <>
              {index > 0 && <li>&rsaquo;</li>}
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" style={index === breadcrumbItems.length - 1 ? "color: var(--color-primary); font-weight: 600;" : ""}>
                {index === breadcrumbItems.length - 1 ? (
                  <span itemprop="name">{item.name}</span>
                ) : (
                  <a itemprop="item" href={new URL(item.item as string).pathname} style="color: inherit; text-decoration: none;">
                    <span itemprop="name">{item.name}</span>
                  </a>
                )}
                <meta itemprop="position" content={item.position.toString()} />
              </li>
            </>
          ))}
        </ol>
      </nav>

      <slot name="header-badge" />

      <h1 style="color: var(--color-primary); margin-bottom: var(--space-6); font-size: clamp(28px, 4vw, 42px); line-height: 1.3;">{title}</h1>
      
      <div style="display: flex; justify-content: center; margin-bottom: var(--space-6);">
        <LastUpdated prefix={`Info ${city} Update`} />
      </div>
      
      <p style="font-size: 1.125rem; color: var(--color-text-light); line-height: 1.7; max-width: 650px; margin: 0 auto;">
        {description}
      </p>
    </div>
  </header>

  <article class="container section" style="max-width: 800px; line-height: 1.8;">
    <slot />
  </article>

  <slot name="calculator" />

  <!-- CTA WhatsApp -->
  <section class="section" style="background-color: var(--color-primary); color: white; text-align: center;">
    <div class="container">
      <h2 style="color: white; margin-bottom: var(--space-4);">Butuh Jasa Pengeboran di {city}?</h2>
      <p style="margin-bottom: var(--space-8); color: rgba(255,255,255,0.9); font-size: 1.125rem; max-width: 600px; margin-left: auto; margin-right: auto;">Tim kami siap meluncur ke lokasi Anda. Hubungi kami sekarang untuk survei gratis.</p>
      <a href={`https://wa.me/${siteConfig.whatsapp}?text=Halo%20ASEVEN%20PILE,%20saya%20butuh%20jasa%20bore%20pile%20di%20${encodeURIComponent(city)}`} class="btn" style="background-color: #25D366; color: white; border-color: #25D366; padding: 14px 32px; font-size: 1.125rem; box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; margin-right:8px; vertical-align:text-bottom;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        Chat WA Sekarang
      </a>
    </div>
  </section>
</BaseLayout>