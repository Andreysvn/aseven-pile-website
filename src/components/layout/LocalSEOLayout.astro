---
import BaseLayout from './BaseLayout.astro';
import LastUpdated from '../ui/LastUpdated.astro';

// Mengambil data dari Frontmatter Markdown atau Props yang di-inject oleh AI
const { title, description, city, serviceName } = Astro.props;

// Schema JSON-LD untuk Local SEO (Whitehat)
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `ASeven Pile - ${serviceName} ${city}`,
  "description": description,
  "areaServed": city,
  "dateModified": new Date().toISOString()
};
---

<BaseLayout title={`${title} | ASeven Pile`} description={description}>
  <!-- Inject Schema Rahasia Google -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="page-header bg-gray-50 py-12 border-b border-gray-200">
    <div class="container mx-auto px-4 max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">{title}</h1>
      <div class="flex justify-center mb-6">
        <LastUpdated prefix={`Info ${city} Update`} />
      </div>
      <p class="text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto">
        {description}
      </p>
    </div>
  </div>

  <article class="container mx-auto px-4 py-12 max-w-4xl prose prose-lg prose-blue">
    <!-- Di sinilah AI dari Telegram akan menyuntikkan artikelnya -->
    <slot />
  </article>

  <!-- Reusable Call To Action Khusus Lokal -->
  <section class="bg-blue-900 text-white py-12 mt-12 text-center">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold mb-4">Butuh Jasa Pengeboran di {city}?</h2>
      <p class="mb-8 text-blue-100">Tim kami siap meluncur ke lokasi Anda. Hubungi kami sekarang untuk survei gratis.</p>
      <a href="https://wa.me/6281234567890" class="inline-block bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-8 rounded-full transition-transform hover:scale-105">
        Chat WA Sekarang
      </a>
    </div>
  </section>
</BaseLayout>