---
import BaseLayout from './BaseLayout.astro';
import LastUpdated from '../ui/LastUpdated.astro';
import PremiumCTA from '../ui/PremiumCTA.astro';
import { siteConfig } from '../../data/site.config';

export interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  h1?: string;
  title: string;
  description: string;
  city: string;
  serviceName: string;
  faqs?: FAQ[];
  pathContext?: 'general' | 'bore-pile' | 'strauss-pile';
}

const { 
  title,
  h1,
  description, 
  city, 
  serviceName, 
  faqs = [], 
  pathContext = 'general' 
} = Astro.props;

// Compute canonical URL and breadcrumb path based on context
const citySlug = city.toLowerCase().replace(/\s+/g, "-");
let pageUrl = `${siteConfig.url}/area-layanan/${citySlug}`;
let breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Beranda", "item": siteConfig.url },
  { "@type": "ListItem", "position": 2, "name": "Area Layanan", "item": `${siteConfig.url}/area-layanan` }
];

if (pathContext === 'bore-pile') {
  pageUrl = `${siteConfig.url}/area-layanan/bore-pile/${citySlug}`;
  breadcrumbItems.push({ "@type": "ListItem", "position": 3, "name": "Bore Pile", "item": `${siteConfig.url}/area-layanan/bore-pile` });
  breadcrumbItems.push({ "@type": "ListItem", "position": 4, "name": city, "item": pageUrl });
} else if (pathContext === 'strauss-pile') {
  pageUrl = `${siteConfig.url}/area-layanan/strauss-pile/${citySlug}`;
  breadcrumbItems.push({ "@type": "ListItem", "position": 3, "name": "Strauss Pile", "item": `${siteConfig.url}/area-layanan/strauss-pile` });
  breadcrumbItems.push({ "@type": "ListItem", "position": 4, "name": city, "item": pageUrl });
} else {
  breadcrumbItems.push({ "@type": "ListItem", "position": 3, "name": city, "item": pageUrl });
}

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `${siteConfig.brand} - ${serviceName} ${city}`,
  "description": description,
  "url": pageUrl,
  "telephone": siteConfig.phone,
  "email": siteConfig.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.street,
    "addressLocality": siteConfig.address.city,
    "addressRegion": siteConfig.address.province,
    "postalCode": siteConfig.address.postalCode,
    "addressCountry": "ID"
  },
  "areaServed": {
    "@type": "City",
    "name": city
  },
  "serviceType": [serviceName, "Bore Pile", "Strauss Pile", "Pondasi Bore Pile"],
  "priceRange": "Rp 70.000 - Rp 350.000",
  "foundingDate": siteConfig.foundingYear.toString(),
  "sameAs": Object.values(siteConfig.socialMedia),
  "dateModified": new Date().toISOString()
};

// FAQ Schema (if faqs provided)
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

// Service Schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${serviceName} ${city}`,
  "provider": {
    "@type": "LocalBusiness",
    "name": siteConfig.brand
  },
  "areaServed": {
    "@type": "City",
    "name": city
  },
  "description": description
};
---

<BaseLayout title={title} description={description}>
  <!-- LD+JSON Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems
  })} />

  
  
  <header class="section local-seo-header">
    <div class="container" style="max-width: 900px; margin: 0 auto; text-align: left;">
      <!-- HTML Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <ol itemscope itemtype="https://schema.org/BreadcrumbList">
          {breadcrumbItems.map((item, index) => (
            <>
              {index > 0 && <li class="separator">&rsaquo;</li>}
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class={index === breadcrumbItems.length - 1 ? "active" : ""}>
                {index === breadcrumbItems.length - 1 ? (
                  <span itemprop="name">{item.name}</span>
                ) : (
                  <a itemprop="item" href={new URL(item.item as string).pathname}>
                    <span itemprop="name">{item.name}</span>
                  </a>
                )}
                <meta itemprop="position" content={item.position.toString()} />
              </li>
            </>
          ))}
        </ol>
      </nav>

      <slot name="header-badge" />

      <h1>{h1 ?? title}</h1>
      
      {pathContext !== 'general' && (
        <>
          <div class="last-updated-wrapper">
            <LastUpdated prefix="Update" hideIcon={true} />
          </div>
          
          <div class="header-image-wrapper">
            <img 
              src="/imgs/header-beranda-bore-pile-aseven.webp" 
              alt={`Proyek Jasa Bore Pile ${city} oleh Aseven Pile`} 
              loading="eager"
              fetchpriority="high"
            />
          </div>
          
          
        </>
      )}
    </div>
  </header>
<style>
    .local-seo-header {
      background-color: #f8fafc;
      padding-top: 120px;
      padding-bottom: var(--space-6);
      border-bottom: 1px solid var(--color-border-light);
    }
    
    .breadcrumbs ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      list-style: none;
      padding: 0;
      margin: 0 0 var(--space-4) 0;
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }
    
    .breadcrumbs a {
      color: inherit;
      text-decoration: none;
    }
    .breadcrumbs a:hover {
      color: var(--color-primary);
      text-decoration: underline;
    }
    .breadcrumbs .active {
      color: var(--color-primary);
      font-weight: 600;
    }
    
    .local-seo-header h1 {
      color: var(--color-primary);
      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.25;
      margin-bottom: var(--space-4);
    }
    
    .last-updated-wrapper {
      margin-bottom: var(--space-6);
      display: flex;
      justify-content: flex-start;
    }
    
    .header-image-wrapper {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      width: 100%;
      
    }
    
    .header-image-wrapper img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
    }
    
    
  </style>

  <article class="container" style="padding-top: var(--space-6); line-height: 1.8;">
    <slot />
  </article>

  <slot name="calculator" />
  
  <slot name="bottom-content" />

  <!-- PREMIUM CTA WhatsApp -->
  <PremiumCTA 
    title={`Butuh Jasa Pengeboran di ${city}?`}
    subtitle="Hubungi kami untuk jadwal survei lokasi dan dapatkan penawaran harga secara gratis."
    waMessage={`Halo Aseven Pile, saya butuh jasa ${serviceName} di ${city}`}
  />

  <slot name="below-cta" />

</BaseLayout>





